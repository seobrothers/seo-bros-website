---
// Shared layout for the white-label SEO spoke pages (the hub-and-spoke under
// /white-label-seo/: local, link-building, enterprise, ai-seo, ecommerce).
// Keeps every spoke visually consistent and on-message: dark hero, intro,
// "what's included" grid, an internal-link cluster (the spoke-to-hub and
// spoke-to-guides linking that builds topical authority), FAQ + schema, CTA.
// Content comes in as props so each spoke is just data.
import Layout from "./Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CtaBanner from "../components/CtaBanner.astro";

interface Included {
  title: string;
  body: string;
}
interface RelatedLink {
  href: string;
  label: string;
  note: string;
}
interface Faq {
  question: string;
  answer: string;
}

interface Props {
  metaTitle: string;
  metaDescription: string;
  eyebrow: string;
  /** Plain first part of the H1. */
  title: string;
  /** Gradient-highlighted tail of the H1. */
  titleAccent: string;
  heroSub: string;
  intro: string[];
  includedTitle?: string;
  includedSub?: string;
  included: Included[];
  relatedTitle?: string;
  related: RelatedLink[];
  faqs: Faq[];
}

const {
  metaTitle,
  metaDescription,
  eyebrow,
  title,
  titleAccent,
  heroSub,
  intro,
  includedTitle = "What's included",
  includedSub,
  included,
  relatedTitle = "Go deeper",
  related,
  faqs,
} = Astro.props as Props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "White-Label SEO", item: new URL("/white-label-seo/", Astro.site).href },
    { "@type": "ListItem", position: 3, name: eyebrow, item: new URL(Astro.url.pathname, Astro.site).href },
  ],
};
---

<Layout title={metaTitle} description={metaDescription} schema={[breadcrumbSchema, faqSchema]}>
  <Nav />

  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="sp-hero">
    <div class="sp-hero__bg">
      <div class="sp-hero__orb sp-hero__orb--1"></div>
      <div class="sp-hero__orb sp-hero__orb--2"></div>
      <div class="sp-hero__grid"></div>
    </div>
    <div class="container sp-hero__inner">
      <a href="/white-label-seo/" class="sp-hero__back">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 8H3M7 12L3 8l4-4" /></svg>
        White Label SEO
      </a>
      <span class="sp-hero__label" data-animate>
        <span class="sp-hero__label-dot"></span>
        {eyebrow}
      </span>
      <h1 class="sp-hero__title" data-animate>
        {title}{" "}
        <span class="sp-hero__title-gradient">{titleAccent}</span>
      </h1>
      <p class="sp-hero__subtitle" data-animate>{heroSub}</p>
      <div class="sp-hero__actions" data-animate>
        <a href="/partner-package/" class="btn btn-primary btn-lg">Test Us</a>
        <a href="/pricing/" class="btn btn-outline btn-lg">See pricing</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════ INTRO ═══════════════ -->
  <section class="sp-intro">
    <div class="container sp-intro__inner">
      {intro.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <!-- ═══════════════ WHAT'S INCLUDED ═══════════════ -->
  <section class="sp-included">
    <div class="container">
      <div class="sp-section-head">
        <h2 class="sp-section-title">{includedTitle}</h2>
        {includedSub && <p class="sp-section-sub">{includedSub}</p>}
      </div>
      <div class="sp-grid" data-stagger>
        {included.map((item) => (
          <article class="sp-card" data-animate>
            <span class="sp-card__check" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
            </span>
            <h3 class="sp-card__title">{item.title}</h3>
            <p class="sp-card__body">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ INTERNAL-LINK CLUSTER ═══════════════ -->
  {related.length > 0 && (
    <section class="sp-related">
      <div class="container">
        <h2 class="sp-section-title sp-section-title--center">{relatedTitle}</h2>
        <div class="sp-related__grid" data-stagger>
          {related.map((r) => (
            <a href={r.href} class="sp-related__card" data-animate>
              <span class="sp-related__label">{r.label}</span>
              <span class="sp-related__note">{r.note}</span>
              <span class="sp-related__arrow" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════ FAQ ═══════════════ -->
  <section class="sp-faq">
    <div class="container sp-faq__inner">
      <h2 class="sp-section-title">Common questions</h2>
      {faqs.map((faq, i) => (
        <details class="sp-faq__item" open={i === 0}>
          <summary class="sp-faq__q">
            <span>{faq.question}</span>
            <svg class="sp-faq__chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
          </summary>
          <div class="sp-faq__a"><p>{faq.answer}</p></div>
        </details>
      ))}
    </div>
  </section>

  <CtaBanner variant="partner" />
  <Footer />
</Layout>

<style>
  /* HERO */
  .sp-hero { position: relative; background: var(--dark); overflow: hidden; padding: 150px 0 84px; }
  .sp-hero__bg { position: absolute; inset: 0; overflow: hidden; }
  .sp-hero__orb { position: absolute; border-radius: 50%; filter: blur(120px); opacity: 0.26; }
  .sp-hero__orb--1 { width: 540px; height: 540px; background: var(--teal); top: -12%; left: -8%; }
  .sp-hero__orb--2 { width: 440px; height: 440px; background: var(--teal-light); top: -5%; right: -8%; }
  .sp-hero__grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at 50% 35%, black 28%, transparent 74%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 35%, black 28%, transparent 74%);
  }
  .sp-hero__inner { position: relative; z-index: 1; max-width: 820px; }
  .sp-hero__back {
    display: flex; width: fit-content; align-items: center; gap: 8px;
    font-size: 13px; font-weight: 500; color: var(--text-on-dark-muted);
    margin-bottom: 22px; transition: color var(--transition);
  }
  .sp-hero__back:hover { color: var(--teal-light); }
  .sp-hero__label {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--teal-light); margin-bottom: 22px;
  }
  .sp-hero__label-dot { width: 8px; height: 8px; background: var(--green); border-radius: 50%; box-shadow: 0 0 0 4px rgba(68,185,123,0.18); }
  .sp-hero__title {
    font-family: var(--font-display); font-size: clamp(36px, 5.4vw, 60px);
    font-weight: 700; line-height: 1.06; letter-spacing: -0.03em;
    color: var(--text-on-dark); margin-bottom: 20px;
  }
  .sp-hero__title-gradient {
    background: linear-gradient(135deg, var(--teal) 0%, var(--teal-light) 100%);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  .sp-hero__subtitle { font-size: clamp(16px, 1.9vw, 19px); line-height: 1.7; color: var(--text-on-dark-muted); max-width: 620px; margin-bottom: 32px; }
  .sp-hero__actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .btn-lg { padding: 16px 32px; font-size: 16px; }

  /* Shared section bits */
  .sp-section-head { max-width: 680px; margin: 0 auto 36px; text-align: center; }
  .sp-section-title { font-family: var(--font-display); font-size: clamp(26px, 3.4vw, 34px); font-weight: 700; letter-spacing: -0.02em; color: var(--text-primary); }
  .sp-section-title--center { text-align: center; margin-bottom: 32px; }
  .sp-section-sub { font-size: 16px; line-height: 1.7; color: var(--text-secondary); margin-top: 12px; }

  /* INTRO */
  .sp-intro { padding: 72px 0 8px; background: var(--white); }
  .sp-intro__inner { max-width: 760px; }
  .sp-intro__inner p { font-size: 18px; line-height: 1.8; color: var(--text-secondary); margin-bottom: 20px; }
  .sp-intro__inner p:first-child { font-size: 20px; color: var(--text-primary); font-weight: 500; }

  /* INCLUDED */
  .sp-included { padding: 64px 0 80px; background: var(--white); }
  .sp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .sp-card { background: var(--light); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 26px; }
  .sp-card__check { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 50%; background: rgba(40,165,177,0.12); color: var(--teal-dark); margin-bottom: 14px; }
  .sp-card__title { font-family: var(--font-display); font-size: 18px; font-weight: 600; color: var(--text-primary); margin-bottom: 8px; }
  .sp-card__body { font-size: 14px; line-height: 1.65; color: var(--text-secondary); }

  /* RELATED (internal links) */
  .sp-related { padding: 0 0 88px; background: var(--white); }
  .sp-related__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; max-width: 980px; margin: 0 auto; }
  .sp-related__card {
    display: flex; flex-direction: column; gap: 4px;
    padding: 20px 22px; border-radius: var(--radius-lg);
    background: var(--light); border: 1px solid var(--border-light);
    transition: all var(--transition); position: relative;
  }
  .sp-related__card:hover { border-color: var(--teal); transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .sp-related__label { font-family: var(--font-display); font-size: 16px; font-weight: 600; color: var(--text-primary); }
  .sp-related__note { font-size: 13px; line-height: 1.5; color: var(--text-muted); }
  .sp-related__arrow { position: absolute; top: 18px; right: 18px; color: var(--teal); }

  /* FAQ */
  .sp-faq { padding: 0 0 110px; background: var(--white); }
  .sp-faq__inner { max-width: 760px; }
  .sp-faq__inner .sp-section-title { margin-bottom: 12px; }
  .sp-faq__item { border-bottom: 1px solid var(--border-light); }
  .sp-faq__item:first-of-type { border-top: 1px solid var(--border-light); margin-top: 16px; }
  .sp-faq__q {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 22px 0; cursor: pointer; list-style: none;
    font-family: var(--font-display); font-size: 17px; font-weight: 600; color: var(--text-primary);
  }
  .sp-faq__q::-webkit-details-marker { display: none; }
  .sp-faq__chev { flex-shrink: 0; color: var(--text-muted); transition: transform var(--transition); }
  .sp-faq__item[open] .sp-faq__chev { transform: rotate(180deg); }
  .sp-faq__a { padding-bottom: 22px; }
  .sp-faq__a p { font-size: 15px; line-height: 1.7; color: var(--text-secondary); }

  @media (max-width: 900px) { .sp-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 768px) {
    .sp-hero { padding: 130px 0 64px; }
    .sp-intro { padding: 56px 0 0; }
    .sp-grid { grid-template-columns: 1fr; }
  }
</style>
