---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { WEB_BUILDS, HOSTING, MAINTENANCE, usd } from "../data/pricing";

const valueProps = [
  {
    icon: "rocket",
    accent: "teal",
    title: "Lightning fast on Astro",
    description:
      "Built on the Astro framework and engineered for Core Web Vitals. Pages load near-instantly, with clean markup and no bloated page builder dragging things down. Speed is the experience your client's visitors feel, and it's a Google ranking factor working in their favor.",
  },
  {
    icon: "cloud",
    accent: "green",
    title: "Secure on Cloudflare's edge",
    description:
      "Hosted on Cloudflare's secure global edge: DDoS protection, automatic SSL, and the same network that serves a huge slice of the internet. Fast everywhere, locked down by default, and cheap to run. No plugin update treadmill, no surprise downtime when a host has a bad day.",
  },
  {
    icon: "edit",
    accent: "teal",
    title: "Clients edit it themselves",
    description:
      "We layer on Emdash, an open-source, Astro-first CMS from Cloudflare. Your client updates copy, swaps images, and publishes pages without touching code or waiting on a developer.",
  },
  {
    icon: "brand",
    accent: "green",
    title: "Resold under your brand",
    description:
      "We stay invisible. The site ships under your agency's name, you set the retail price, and you own the client relationship start to finish. We never contact your client.",
  },
];

const buildPrice = usd(WEB_BUILDS[0].price);
const redesignPrice = usd(WEB_BUILDS[1].price);
const hostingPrice = "from " + usd(HOSTING.price) + "/mo";
const maintenancePrice = usd(MAINTENANCE.price) + "/mo";

const ongoing = [
  {
    icon: "cloud",
    accent: "green",
    title: HOSTING.label,
    price: hostingPrice,
    description:
      "Fast, secure hosting on Cloudflare's edge, handled for you. SSL, uptime, and platform updates covered so the site stays quick and protected without anyone babysitting it. Bill it monthly under your brand.",
  },
  {
    icon: "edit",
    accent: "teal",
    title: MAINTENANCE.label,
    price: "from " + maintenancePrice,
    description:
      "Ongoing content edits, fixes, and small changes so the site never goes stale. A recurring line your agency resells, with the work staying invisible behind your name.",
  },
];

const steps = [
  {
    number: "01",
    title: "Kickoff",
    description:
      "You hand us scope, content, and brand direction. We confirm sitemap, page count, and whether the build needs the redesign-SEO tier. No drawn-out discovery cycle.",
  },
  {
    number: "02",
    title: "Build",
    description:
      "We build the site on Astro and wire up Emdash so the editable regions match how your client actually works. You review on a staging URL, we revise.",
  },
  {
    number: "03",
    title: "SEO protection (if it's a redesign)",
    description:
      "On the $2,500 tier we map every old URL to its new home, set the redirects, and preserve on-page signals so search visibility carries over instead of cratering on launch day.",
  },
  {
    number: "04",
    title: "Launch",
    description:
      "We deploy to Cloudflare's edge and hand over a clean, fast, secure site plus Emdash access. Your client edits content from day one. You bill them at your price.",
  },
];

const faqs = [
  {
    question: "Is it really white-label?",
    answer:
      "Yes. We work behind the scenes and the site ships under your brand. We don't put our name in the footer, we don't email your client, and we don't show up on their invoice. The relationship is yours.",
  },
  {
    question: "Can our client edit the site themselves?",
    answer:
      "Yes, that's the point of Emdash. We set up the editable regions during the build, and your client updates copy, images, and pages through a clean editor. No code, no developer, no ticket queue for a typo fix.",
  },
  {
    question: "What is Emdash?",
    answer:
      "Emdash is an open-source, Astro-first CMS from Cloudflare (emdashcms.dev). It plugs into an Astro site and gives non-technical people a way to edit content without touching the codebase. We use it so your clients aren't dependent on a developer for routine updates.",
  },
  {
    question: "Why not just build on WordPress?",
    answer:
      "WordPress sites get slow, get hacked, and carry a maintenance tail: plugin updates, security patches, hosting bills. An Astro site on Cloudflare is faster, more secure, and cheaper to run, and Emdash still gives your client the easy editing experience they expect.",
  },
  {
    question: "Will a redesign hurt our client's rankings?",
    answer:
      "It can, and it routinely does when redirects and on-page SEO are handled carelessly. That's exactly what the $2,500 tier protects against. We're an SEO company first, so we map the redirects and preserve search signals through the migration. If you don't need that protection, the $1,500 build is for sites where rankings aren't on the line.",
  },
  {
    question: "Do you build from scratch or from templates?",
    answer:
      "We build on proven, battle-tested templates. That's deliberate: it keeps the site fast, consistent, and quick to ship, and it means the Core Web Vitals and security work is already done instead of reinvented on every project. If your agency already has a design or a look the client expects, we can closely mirror it. You get fast turnaround and flexibility, not a blank-page project that drags for months.",
  },
  {
    question: "How fast is turnaround?",
    answer:
      "It depends on scope and how quickly content and feedback come back, but a typical site lands in a few weeks. We'll give you a real timeline at kickoff once we see the page count and requirements. We won't promise a number we can't hit.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<Layout
  title="White Label Web Design & Development for Agencies | SEO Brothers"
  description="White label web design and development for agencies. Lightning-fast Astro websites on Cloudflare's secure edge, editable by your clients via Emdash, resold under your brand. Builds from $1,500, plus managed hosting and maintenance."
  schema={faqSchema}
>
  <Nav />

  <!-- ===== HERO ===== -->
  <section class="wd-hero">
    <div class="wd-hero-bg">
      <div class="wd-hero-orb wd-hero-orb--teal"></div>
      <div class="wd-hero-orb wd-hero-orb--green"></div>
      <div class="wd-hero-orb wd-hero-orb--teal2"></div>
      <div class="wd-hero-grid"></div>
    </div>

    <div class="wd-hero-content container">
      <div class="wd-hero-badge" data-animate>
        <span class="wd-hero-badge-dot"></span>
        Built on Astro + Cloudflare
      </div>

      <h1 class="wd-hero-title" data-animate>
        <span class="wd-hero-title-line">White Label Web Design</span><br />
        <span class="wd-hero-title-gradient">& Development for Agencies</span>
      </h1>

      <p class="wd-hero-subtitle" data-animate>
        Resell lightning-fast websites under your own brand. We build on Astro
        for Core Web Vitals, host on Cloudflare's secure global edge, and hand
        your clients an editor they can actually use. Speed and security baked
        in, which is also the SEO story. You set the price. We stay invisible.
      </p>

      <div class="wd-hero-actions" data-animate>
        <a href="/partner-package/" class="btn btn-primary wd-btn-lg">
          Test Us
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <a href="#wd-pricing" class="btn btn-outline wd-btn-lg">See pricing</a>
      </div>

      <div class="wd-hero-pills" data-animate>
        <span class="wd-hero-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Built on Astro
        </span>
        <span class="wd-hero-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Deployed on Cloudflare
        </span>
        <span class="wd-hero-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Editable by your clients
        </span>
      </div>
    </div>
  </section>

  <!-- ===== INTRO ===== -->
  <section class="wd-intro">
    <div class="container">
      <div class="wd-intro-content" data-animate>
        <span class="section-label">For Agencies & Resellers</span>
        <h2 class="section-heading">White Label Web Development You Can Sell Today</h2>
        <p class="wd-intro-text">
          Your clients keep asking for websites. Building a development team to
          deliver them is expensive and slow, and outsourcing to a freelancer
          you found last week is a gamble. White label web design solves that:
          we build the site, you resell it under your brand, and your client
          never knows we exist.
        </p>
        <p class="wd-intro-text">
          We build white label websites on Astro and deploy them on Cloudflare,
          then layer on the Emdash CMS so your clients can edit their own
          content. The result is a fast, modern, secure site with none of the
          maintenance baggage that comes with a typical page-builder build. It's
          ready to sell now, with two clear price points and no setup fee.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== VALUE PROPS ===== -->
  <section class="wd-value">
    <div class="container">
      <div class="wd-value-header" data-animate>
        <span class="section-label">Why It's Different</span>
        <h2 class="section-heading">
          What You're Reselling
        </h2>
        <p class="section-subtext" style="margin:0 auto;">
          White label website design that doesn't fall apart six months after
          launch. Lightning fast to load, secure by default, easy to edit, and
          branded as yours.
        </p>
      </div>

      <div class="wd-value-grid" data-stagger>
        {
          valueProps.map((prop) => (
            <div class="wd-value-card" data-animate>
              <div class={`wd-value-icon wd-value-icon--${prop.accent}`}>
                {prop.icon === "rocket" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z" />
                    <path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" />
                    <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0" />
                    <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" />
                  </svg>
                )}
                {prop.icon === "cloud" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" />
                  </svg>
                )}
                {prop.icon === "edit" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                  </svg>
                )}
                {prop.icon === "brand" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  </svg>
                )}
              </div>
              <h3 class="wd-value-title">{prop.title}</h3>
              <p class="wd-value-desc">{prop.description}</p>
            </div>
          ))
        }
      </div>

      <div class="wd-ongoing" data-animate>
        <div class="wd-ongoing-header">
          <span class="section-label">Recurring Revenue</span>
          <h3 class="wd-ongoing-heading">Ongoing White-Label Offerings</h3>
          <p class="wd-ongoing-subtext">
            The build is one-time. Hosting and maintenance are monthly, so the
            website keeps paying your agency long after launch. Both ship under
            your brand and bill at your markup.
          </p>
        </div>
        <div class="wd-ongoing-grid">
          {
            ongoing.map((item) => (
              <div class="wd-ongoing-card">
                <div class={`wd-value-icon wd-value-icon--${item.accent}`}>
                  {item.icon === "cloud" && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" />
                    </svg>
                  )}
                  {item.icon === "edit" && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                    </svg>
                  )}
                </div>
                <div class="wd-ongoing-card-head">
                  <h4 class="wd-value-title">{item.title}</h4>
                  <span class="wd-ongoing-price">{item.price}</span>
                </div>
                <p class="wd-value-desc">{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="wd-process">
    <div class="container">
      <div class="wd-process-header" data-animate>
        <span class="section-label">How It Works</span>
        <h2 class="section-heading">
          Kickoff to Launch
        </h2>
        <p class="section-subtext" style="margin:0 auto;">
          A tight process built for agencies that need to move. You bring the
          client and the brief, we build and launch.
        </p>
      </div>

      <div class="wd-process-timeline">
        <div class="wd-process-line"></div>
        {
          steps.map((step) => (
            <div class="wd-process-step" data-animate>
              <div class="wd-process-marker">
                <span class="wd-process-number">{step.number}</span>
              </div>
              <div class="wd-process-step-body">
                <h3 class="wd-process-step-title">{step.title}</h3>
                <p class="wd-process-step-desc">{step.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== REDESIGN-SEO ANGLE ===== -->
  <section class="wd-redesign">
    <div class="wd-redesign-bg">
      <div class="wd-redesign-orb wd-redesign-orb--1"></div>
      <div class="wd-redesign-orb wd-redesign-orb--2"></div>
    </div>
    <div class="container">
      <div class="wd-redesign-inner" data-animate>
        <div class="wd-redesign-copy">
          <span class="section-label section-label--light">The Part Most Builds Get Wrong</span>
          <h2 class="section-heading section-heading--light">
            Redesigns Tank Rankings.<br />
            Ours Don't Have To.
          </h2>
          <p class="wd-redesign-text">
            When a site gets rebuilt, the URLs change, the on-page structure
            shifts, and search engines lose track of what ranked where. If
            nobody maps the old URLs to the new ones and sets the redirects, the
            site relaunches and traffic falls off a cliff. We see it constantly:
            a clean new design that quietly erased a year of organic growth. Our
            <a href="/guides/website-redesign-seo/" class="wd-redesign-inline-link">website redesign SEO guide</a>
            breaks down exactly how that happens and how we prevent it.
          </p>
          <p class="wd-redesign-text">
            We're an SEO company first. So the $2,500 tier bakes that protection
            in. We map every old URL to its new home, set the redirects,
            preserve the on-page signals that earned the rankings, and watch the
            launch so visibility carries over instead of cratering. If your
            client has organic traffic worth protecting, this is the tier to
            sell them.
          </p>
          <a href="/white-label-seo/" class="wd-redesign-link">
            See our white-label SEO
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PRICING ===== -->
  <section class="wd-pricing" id="wd-pricing">
    <div class="container">
      <div class="wd-pricing-header" data-animate>
        <span class="section-label">Wholesale Partner Pricing</span>
        <h2 class="section-heading">
          Two Tiers, No Setup Fee
        </h2>
        <p class="section-subtext" style="margin:0 auto;">
          These are the white-label prices your agency pays. You mark up to your
          client and keep the difference. Both build tiers include the Astro
          build, Cloudflare hosting, and Emdash, with hosting and maintenance
          available as recurring monthly lines.
        </p>
      </div>

      <div class="wd-pricing-grid" data-stagger>
        <div class="wd-pricing-card" data-animate>
          <div class="wd-pricing-card-header">
            <h3 class="wd-pricing-tier">Website Build</h3>
            <p class="wd-pricing-tier-desc">
              A fast, modern site built on Astro, deployed on Cloudflare, with
              Emdash so your client can edit it. For new sites and rebuilds
              where rankings aren't on the line.
            </p>
          </div>
          <div class="wd-pricing-price">
            <span class="wd-pricing-amount">{buildPrice}</span>
            <span class="wd-pricing-period">per build</span>
          </div>
          <ul class="wd-pricing-features">
            <li>Built on Astro for Core Web Vitals</li>
            <li>Hosted on Cloudflare's secure global edge</li>
            <li>Emdash CMS so clients edit their own content</li>
            <li>Lightning fast, secure, cheap to run</li>
            <li>Shipped under your brand</li>
            <li>No setup fee</li>
          </ul>
          <a href="/partner-package/" class="btn btn-outline--dark wd-pricing-btn">Test Us</a>
        </div>

        <div class="wd-pricing-card wd-pricing-card--featured" data-animate>
          <span class="wd-pricing-badge">Protects Rankings</span>
          <div class="wd-pricing-card-header">
            <h3 class="wd-pricing-tier">Build + Redesign SEO</h3>
            <p class="wd-pricing-tier-desc">
              Everything in the build, plus full redesign-SEO support. We handle
              the redirects and protect search visibility through the migration
              so traffic doesn't drop on relaunch.
            </p>
          </div>
          <div class="wd-pricing-price">
            <span class="wd-pricing-amount">{redesignPrice}</span>
            <span class="wd-pricing-period">per build</span>
          </div>
          <ul class="wd-pricing-features">
            <li>Everything in the Website Build</li>
            <li>Full URL mapping, old to new</li>
            <li>All redirects handled for you</li>
            <li>On-page SEO signals preserved</li>
            <li>Visibility protected through migration</li>
            <li>Launch monitored so rankings hold</li>
          </ul>
          <a href="/partner-package/" class="btn btn-primary wd-pricing-btn">Test Us</a>
        </div>
      </div>

      <div class="wd-pricing-recurring" data-animate>
        <h3 class="wd-pricing-recurring-title">Add recurring, monthly</h3>
        <p class="wd-pricing-recurring-sub">
          The build is one-time. These keep the site fast, secure, and current,
          and keep billing your agency every month.
        </p>
        <div class="wd-pricing-rows">
          <div class="wd-pricing-row">
            <div class="wd-pricing-row-head">
              <h4 class="wd-pricing-row-name">{HOSTING.label}</h4>
              <span class="wd-pricing-row-price">{hostingPrice}</span>
            </div>
            <p class="wd-pricing-row-desc">
              Fast, secure hosting on Cloudflare's edge. SSL, uptime, and
              platform updates handled so the site stays quick and protected.
            </p>
          </div>
          <div class="wd-pricing-row">
            <div class="wd-pricing-row-head">
              <h4 class="wd-pricing-row-name">{MAINTENANCE.label}</h4>
              <span class="wd-pricing-row-price">from {maintenancePrice}</span>
            </div>
            <p class="wd-pricing-row-desc">
              Ongoing content edits, fixes, and small changes so the site never
              goes stale. Resold under your brand at your markup.
            </p>
          </div>
        </div>
      </div>

      <p class="wd-pricing-footnote" data-animate>
        Pair an ongoing campaign with the build and your client keeps climbing
        after launch. See <a href="/white-label-seo/">our white-label SEO</a>.
      </p>
    </div>
  </section>

  <!-- ===== MID CTA ===== -->
  <section class="wd-mid-cta">
    <div class="container">
      <div class="wd-mid-cta-card" data-animate>
        <h2 class="wd-mid-cta-title">Want to see the quality first?</h2>
        <p class="wd-mid-cta-text">
          Get a free discovery for your agency. No commitment, no credit card.
          We'll walk you through how the white-label build works and what your
          clients receive.
        </p>
        <a href="/partner-package/" class="btn btn-primary wd-mid-cta-btn">
          Get a Free Discovery
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="wd-faq">
    <div class="container">
      <div class="wd-faq-header" data-animate>
        <span class="section-label">Common Questions</span>
        <h2 class="section-heading">
          White Label Web Design FAQ
        </h2>
      </div>

      <div class="wd-faq-list" data-animate>
        {
          faqs.map((faq, i) => (
            <details class="wd-faq-item" open={i === 0}>
              <summary class="wd-faq-question">
                <span>{faq.question}</span>
                <svg class="wd-faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </summary>
              <div class="wd-faq-answer">
                <p set:html={faq.answer} />
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== BOTTOM CTA ===== -->
  <section class="wd-bottom-cta">
    <div class="wd-bottom-cta-bg">
      <div class="wd-bottom-cta-orb wd-bottom-cta-orb--1"></div>
      <div class="wd-bottom-cta-orb wd-bottom-cta-orb--2"></div>
      <div class="wd-bottom-cta-orb wd-bottom-cta-orb--3"></div>
    </div>

    <div class="container">
      <div class="wd-bottom-cta-content" data-animate>
        <h2 class="wd-bottom-cta-heading">
          Add Websites to Your Service<br />
          <span class="wd-bottom-cta-gradient">Lineup Without Hiring</span>
        </h2>
        <p class="wd-bottom-cta-text">
          Resell white label websites under your brand, built on Astro,
          deployed on Cloudflare, editable by your clients. Start with a free
          discovery for your agency.
        </p>
        <div class="wd-bottom-cta-actions">
          <a href="/partner-package/" class="btn btn-primary wd-btn-lg">
            Test Us
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
