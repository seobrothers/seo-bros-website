---
// Blog article page. Shares the guide article's visual language (hero, TOC,
// prose styles are copied from guides/[...slug].astro) but drops the
// guide-specific machinery: category breadcrumbs, city scorecards/nearby
// cities, inline CTA injection, and the sticky CTA.
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import AuthorCard from "../../components/AuthorCard.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import { authorByName } from "../../data/authors";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((p) => !import.meta.env.PROD || !p.data.draft)
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);

const tocHeadings = d.showToc
  ? headings.filter((h) => h.depth === 2 || h.depth === 3)
  : [];

function fmtDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });
}

const postUrl = new URL(`/blog/${post.id}/`, Astro.site).href;
const imageUrl = new URL(d.coverImage ?? "/images/logo.png", Astro.site).href;
const logoUrl = new URL("/images/logo.png", Astro.site).href;

const authorEntity = authorByName(d.author);
const authorHref =
  authorEntity && authorEntity.published ? `/authors/${authorEntity.slug}/` : null;
const authorUrl = authorHref ? new URL(authorHref, Astro.site).href : null;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: d.title,
  description: d.summary,
  author: {
    "@type": "Person",
    name: d.author,
    ...(authorUrl ? { url: authorUrl } : {}),
  },
  datePublished: d.publishDate.toISOString(),
  dateModified: (d.updatedDate ?? d.publishDate).toISOString(),
  publisher: {
    "@type": "Organization",
    name: "SEO Brothers",
    logo: { "@type": "ImageObject", url: logoUrl },
  },
  mainEntityOfPage: postUrl,
  image: imageUrl,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog/", Astro.site).href },
    { "@type": "ListItem", position: 3, name: d.title, item: postUrl },
  ],
};
---

<Layout
  title={`${d.title} | SEO Brothers`}
  description={d.summary}
  ogType="article"
  ogImage={d.coverImage}
  schema={[articleSchema, breadcrumbSchema]}
>
  <Nav />

  <article class="post">
    <header class="post-hero">
      <div class="post-hero__bg">
        <div class="post-hero__orb"></div>
        <div class="post-hero__grid"></div>
      </div>

      <div class="container post-hero__inner">
        <a href="/blog/" class="post-hero__back">
          <svg
            width="14"
            height="14"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M13 8H3M7 12L3 8l4-4" />
          </svg>
          Blog
        </a>

        <h1 class="post-hero__title" data-animate>{d.title}</h1>

        <div class="post-hero__meta" data-animate>
          {authorEntity?.published && (
            <img
              class="post-hero__avatar"
              src={authorEntity.photo}
              alt={`${d.author}, ${authorEntity.role} at SEO Brothers`}
              width="36"
              height="36"
              loading="lazy"
            />
          )}
          {authorHref ? (
            <a class="post-hero__author" href={authorHref}>{d.author}</a>
          ) : (
            <span class="post-hero__author">{d.author}</span>
          )}
          <span class="post-hero__dot">·</span>
          <span>{fmtDate(d.publishDate)}</span>
          {d.updatedDate && (
            <>
              <span class="post-hero__dot">·</span>
              <span class="post-hero__updated">
                Updated {fmtDate(d.updatedDate)}
              </span>
            </>
          )}
        </div>
      </div>
    </header>

    <section class="post-body">
      <div class="container post-body__grid">
        {
          tocHeadings.length > 0 && (
            <aside class="post-toc">
              <p class="post-toc__label">In this post</p>
              <ol class="post-toc__list">
                {tocHeadings.map((h) => (
                  <li
                    class:list={[
                      "post-toc__item",
                      h.depth === 3 && "post-toc__item--sub",
                    ]}
                  >
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </aside>
          )
        }

        <div
          class:list={[
            "post-body__prose",
            tocHeadings.length === 0 && "post-body__prose--centered",
          ]}
        >
          {
            d.coverImage && (
              <img
                src={d.coverImage}
                alt={d.coverImageAlt ?? ""}
                class="post-cover"
                width="1200"
                height="675"
              />
            )
          }

          <p class="post-summary">{d.summary}</p>

          <Content />

          {authorEntity?.published && <AuthorCard author={authorEntity} variant="full" />}
        </div>
      </div>
    </section>

    <NewsletterSignup />
    <CtaBanner variant="partner" />
  </article>

  <Footer />
</Layout>

<style>
  /* Hero */
  .post-hero {
    position: relative;
    background: var(--dark);
    overflow: hidden;
    padding: 140px 0 80px;
  }

  .post-hero__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .post-hero__orb {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: var(--teal);
    filter: blur(140px);
    opacity: 0.15;
    top: -20%;
    right: -10%;
  }

  .post-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at 50% 30%, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(
      ellipse at 50% 30%,
      black 30%,
      transparent 75%
    );
  }

  .post-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 880px;
  }

  .post-hero__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-on-dark-muted);
    margin-bottom: 28px;
    transition: color var(--transition);
  }

  .post-hero__back:hover {
    color: var(--teal-light);
  }

  .post-hero__title {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--text-on-dark);
    margin-bottom: 20px;
  }

  .post-hero__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--text-on-dark-muted);
  }

  .post-hero__avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .post-hero__author {
    font-weight: 600;
    color: var(--teal-light);
  }

  .post-hero__dot {
    opacity: 0.5;
  }

  .post-hero__updated {
    font-style: italic;
  }

  /* Body */
  .post-body {
    padding: 80px 0 120px;
    background: var(--white);
  }

  .post-body__grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 64px;
    align-items: start;
    max-width: 1100px;
  }

  .post-body__prose--centered {
    grid-column: 1 / -1;
    max-width: 760px;
    margin: 0 auto;
  }

  .post-toc {
    position: sticky;
    top: 32px;
    min-width: 0;
  }

  .post-toc__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .post-toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border-light);
  }

  .post-toc__item {
    padding: 8px 0 8px 16px;
    font-size: 14px;
    line-height: 1.45;
    border-left: 2px solid transparent;
    margin-left: -1px;
    transition: all var(--transition);
  }

  .post-toc__item:hover {
    border-left-color: var(--teal);
  }

  .post-toc__item a {
    color: var(--text-secondary);
    transition: color var(--transition);
  }

  .post-toc__item:hover a {
    color: var(--text-primary);
  }

  .post-toc__item--sub {
    padding-left: 32px;
    font-size: 13px;
  }

  .post-body__prose {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text-secondary);
    max-width: 760px;
    /* Grid items default to min-width:auto and refuse to shrink below wide
       content (nowrap tables, long URLs); min-width:0 lets the column fit the
       viewport and overflow-wrap breaks stray long tokens. */
    min-width: 0;
    overflow-wrap: break-word;
  }

  .post-cover {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    margin-bottom: 40px;
  }

  .post-summary {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.55;
    color: var(--text-primary);
    padding-bottom: 32px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--border-light);
  }

  .post-body__prose :global(h2) {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 56px 0 16px;
    scroll-margin-top: 80px;
  }

  .post-body__prose :global(h3) {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 36px 0 12px;
    scroll-margin-top: 80px;
  }

  .post-body__prose :global(p) {
    margin-bottom: 20px;
  }

  .post-body__prose :global(ul),
  .post-body__prose :global(ol) {
    margin: 0 0 24px 1.5em;
  }

  .post-body__prose :global(li) {
    margin-bottom: 10px;
    line-height: 1.7;
  }

  .post-body__prose :global(a) {
    color: var(--teal-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition);
  }

  .post-body__prose :global(a:hover) {
    color: var(--teal);
  }

  .post-body__prose :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .post-body__prose :global(blockquote) {
    margin: 32px 0;
    padding: 20px 28px;
    border-left: 3px solid var(--teal);
    background: var(--light);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-style: italic;
    color: var(--text-primary);
  }

  .post-body__prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: 32px 0;
  }

  .post-body__prose :global(table) {
    width: 100%;
    margin: 0 0 40px;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 15px;
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .post-body__prose :global(thead) {
    background: var(--light-100);
  }

  .post-body__prose :global(th) {
    padding: 14px 20px;
    text-align: left;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-light);
  }

  .post-body__prose :global(td) {
    padding: 13px 20px;
    border-bottom: 1px solid var(--border-light);
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .post-body__prose :global(tbody tr:last-child td) {
    border-bottom: none;
  }

  .post-body__prose :global(tbody tr:hover) {
    background: var(--light-100);
  }

  .post-body__prose :global(th[align="right"]),
  .post-body__prose :global(td[align="right"]) {
    text-align: right;
  }

  .post-body__prose :global(td[align="right"]) {
    font-weight: 500;
    color: var(--text-primary);
  }

  @media (max-width: 600px) {
    .post-body__prose :global(table) {
      display: block;
      overflow-x: auto;
      white-space: nowrap;
    }
  }

  /* Responsive */
  @media (max-width: 960px) {
    .post-body__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .post-toc {
      position: static;
      padding: 20px 24px;
      background: var(--light);
      border-radius: var(--radius-md);
    }

    .post-toc__list {
      border-left: none;
    }

    .post-toc__item {
      padding: 6px 0;
    }

    .post-toc__item--sub {
      padding-left: 20px;
    }
  }

  @media (max-width: 768px) {
    .post-hero {
      padding: 120px 0 60px;
    }

    .post-body {
      padding: 56px 0 80px;
    }

    .post-summary {
      font-size: 18px;
    }
  }
</style>
