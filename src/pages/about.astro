---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CtaBanner from "../components/CtaBanner.astro";

interface Brother {
  name: string;
  role: string;
  bio: string;
  photo: string;
}

interface TeamMember {
  name: string;
  role: string;
  photo: string;
}

const brothers: Brother[] = [
  {
    name: "Devon Bate",
    role: "Founder & CEO",
    bio: "The visionary behind SEO Brothers. Devon cut his teeth as Lead SEO Specialist before channeling that hands-on expertise into building a company dedicated to helping agencies scale their organic offering.",
    photo: "/images/team/devon-bate.png",
  },
  {
    name: "Adam Bate",
    role: "Founder & COO",
    bio: "With 20+ years in online marketing and SEO, Adam is the operational backbone of SEO Brothers. He brings decades of real-world agency experience to every process, partnership, and campaign we deliver.",
    photo: "/images/team/adam-bate.png",
  },
  {
    name: "Peter Bate",
    role: "Director of Fulfillment",
    bio: "Peter ensures every campaign meets the high bar our agency partners expect. From strategy to execution, he oversees fulfillment so your clients get results they can see.",
    photo: "/images/team/peter-bate.png",
  },
  {
    name: "Colin Bate",
    role: "CTO",
    bio: "Colin spent 17+ years building internal software for a Bermuda-based mutual fund company before joining his brothers. He leads our technology efforts, including the ground-up rebuild of our Portal and the AI-native tooling powering our team.",
    photo: "/images/team/colin-bate.png",
  },
];

const teamMembers: TeamMember[] = [
  { name: "Zach Ames", role: "Director of Operations", photo: "/images/team/zach-ames.png" },
  { name: "Mike Eaton", role: "Account Executive", photo: "/images/team/mike-eaton.png" },
  { name: "Sino Baduza", role: "Partner Onboarding", photo: "/images/team/sino-baduza.png" },
  { name: "Tracy Milsom", role: "Account Manager", photo: "/images/team/tracy-milsom.png" },
  { name: "Lynelle Potgieter", role: "Account Manager", photo: "/images/team/lynelle-potgieter.png" },
  { name: "Jared Warrington", role: "Campaign Onboarding", photo: "/images/team/jared-warrington.png" },
  { name: "Alexa Kanchuk", role: "SEO Manager", photo: "/images/team/alexa-kanchuk.png" },
  { name: "Chelsey Skrebiec", role: "SEO Manager", photo: "/images/team/chelsey-skrebiec.png" },
  { name: "Kelly-Anne Forbes", role: "SEO Manager", photo: "/images/team/kelly-anne-forbes.png" },
  { name: "Maja Jeremic", role: "SEO Manager", photo: "/images/team/maja-jeremic.png" },
  { name: "Molly From", role: "SEO Manager", photo: "/images/team/molly-from.png" },
  { name: "Sasa Ratkovic", role: "SEO Manager", photo: "/images/team/sasa-ratkovic.png" },
  { name: "Igor Pančić", role: "SEO Strategist", photo: "/images/team/igor-pancic.png" },
  { name: "Ivana Djudic", role: "SEO Strategist", photo: "/images/team/ivana-djudic.png" },
  { name: "Joemar Pasco", role: "Lead SEO Specialist", photo: "/images/team/joemar-pasco.png" },
  { name: "James Pasco", role: "SEO Specialist", photo: "/images/team/james-pasco.png" },
  { name: "Jay Pasco", role: "SEO Specialist", photo: "/images/team/jay-pasco.png" },
  { name: "Meca Pasco-Asuro", role: "SEO Specialist", photo: "/images/team/meca-pasco-asuro.png" },
  { name: "Carl Lemagne", role: "SEO Specialist", photo: "/images/team/carl-lemagne.png" },
  { name: "Christian Songalia", role: "SEO Specialist", photo: "/images/team/christian-songalia.png" },
  { name: "Hamza Rivera", role: "SEO Specialist", photo: "/images/team/hamza-rivera.png" },
  { name: "Ron Concepcion", role: "SEO Specialist", photo: "/images/team/ron-concepcion.png" },
  { name: "Russel Ramos", role: "SEO Specialist", photo: "/images/team/russel-ramos.png" },
  { name: "Jacob Amanza", role: "SEO Specialist", photo: "/images/team/jacob-amanza.png" },
  { name: "Tyler Ewald", role: "Hosting & Security", photo: "/images/team/tyler-ewald.png" },
];
---

<Layout
  title="About SEO Brothers | Meet The SEO Brothers Family"
  description="Devon and Adam Bate founded SEO Brothers in Halifax in 2015. Meet the brothers and the team behind the white label SEO campaigns agencies trust."
>
  <Nav />

  <!-- ═══════════════════════════════════════════ HERO ═══════════════════════════════════════════ -->
  <section class="about-hero">
    <div class="about-hero__bg">
      <div class="about-hero__orb about-hero__orb--1"></div>
      <div class="about-hero__orb about-hero__orb--2"></div>
      <div class="about-hero__orb about-hero__orb--3"></div>
      <div class="about-hero__grid-overlay"></div>
    </div>

    <div class="container about-hero__inner">
      <div class="about-hero__label" data-animate>
        <span class="about-hero__label-dot"></span>
        Our Story
      </div>

      <h1 class="about-hero__title" data-animate>
        Yes, we really are brothers
      </h1>

      <p class="about-hero__subtitle" data-animate>
        <span class="about-hero__subtitle-aside">(we get asked that a lot)</span>
        Founded in 2015 by Devon and Adam Bate, SEO Brothers is now a
        four-brother technology-first SEO company serving the digital
        agency community. We built the software powering our distributed
        team and our partners' campaigns.
      </p>

      <div class="about-hero__scroll-cue" data-animate>
        <div class="about-hero__scroll-line"></div>
        <span>Scroll to explore</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ MEET THE BROTHERS ═══════════════════════════════ -->
  <section class="brothers">
    <div class="container">
      <div class="brothers__header" data-animate>
        <span class="section-label">The Brothers</span>
        <h2 class="section-heading">Meet the SEO Brothers</h2>
        <p class="section-subtext">
          Four brothers. Two decades in SEO. One software platform we're
          building from the ground up.
        </p>
      </div>

      <div class="brothers__grid" data-stagger>
        {brothers.map((b) => (
          <div class="brothers__card" data-animate>
            <div class="brothers__photo-wrap">
              <img src={b.photo} alt={`${b.name}, ${b.role} at SEO Brothers`} class="brothers__photo" loading="lazy" width="300" height="300" />
              <div class="brothers__photo-ring"></div>
            </div>
            <h3 class="brothers__name">{b.name}</h3>
            <p class="brothers__role">{b.role}</p>
            <p class="brothers__bio">{b.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ STATS ═══════════════════════════════════════════ -->
  <section class="stats">
    <div class="stats__bg">
      <div class="stats__orb stats__orb--1"></div>
      <div class="stats__orb stats__orb--2"></div>
    </div>
    <div class="container">
      <div class="stats__grid" data-stagger>
        <div class="stats__item" data-animate>
          <span class="stats__number" data-count="100">0</span>
          <span class="stats__suffix">+</span>
          <p class="stats__label">Agency Partners</p>
        </div>
        <div class="stats__item" data-animate>
          <span class="stats__number" data-count="5000">0</span>
          <span class="stats__suffix">+</span>
          <p class="stats__label">Campaigns Delivered</p>
        </div>
        <div class="stats__item" data-animate>
          <span class="stats__number" data-count="10">0</span>
          <span class="stats__suffix">+</span>
          <p class="stats__label">Years of Experience</p>
        </div>
        <div class="stats__item" data-animate>
          <span class="stats__number" data-count="50">0</span>
          <span class="stats__suffix">%+</span>
          <p class="stats__label">Avg. Partner Margin</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ TEAM ═══════════════════════════════════════════ -->
  <section class="team">
    <div class="container">
      <div class="team__header" data-animate>
        <span class="section-label">The Team</span>
        <h2 class="section-heading">The people powering your campaigns</h2>
        <p class="section-subtext">
          Strategists, specialists, and managers who deliver results
          your clients love, all behind the scenes.
        </p>
      </div>

      <div class="team__grid" data-stagger>
        {teamMembers.map((m) => (
          <div class="team__member" data-animate>
            <div class="team__avatar">
              <img src={m.photo} alt={`${m.name}, ${m.role} at SEO Brothers`} class="team__avatar-img" loading="lazy" width="300" height="300" />
            </div>
            <h3 class="team__name">{m.name}</h3>
            <p class="team__role">{m.role}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════ MANIFESTO ═══════════════════════════════════════ -->
  <section class="manifesto">
    <div class="container">
      <div class="manifesto__inner" data-animate>
        <span class="section-label">What We Believe</span>
        <blockquote class="manifesto__quote">
          Great agencies shouldn't have to choose between
          <em>growing their SEO offering</em> and
          <em>maintaining the quality</em> that built their reputation.
        </blockquote>
        <div class="manifesto__beliefs" data-stagger>
          <div class="manifesto__belief" data-animate>
            <span class="manifesto__belief-num">01</span>
            <p>
              Your clients are <strong>your</strong> clients. We never contact
              them, compete with you, or undermine your relationships. Ever.
            </p>
          </div>
          <div class="manifesto__belief" data-animate>
            <span class="manifesto__belief-num">02</span>
            <p>
              Transparency isn't a feature — it's the foundation. You see
              everything we do, in real time, with nothing hidden.
            </p>
          </div>
          <div class="manifesto__belief" data-animate>
            <span class="manifesto__belief-num">03</span>
            <p>
              The best partnerships are built on results, not contracts.
              We earn your business every single month.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ VALUES BENTO ═══════════════════════════════════ -->
  <section class="values">
    <div class="container">
      <div class="values__header" data-animate>
        <span class="section-label--light">Our Values</span>
        <h2 class="section-heading--light">
          The principles that<br />shape everything we do
        </h2>
      </div>

      <div class="values__bento" data-stagger>
        <div class="values__card values__card--wide" data-animate>
          <div class="values__card-icon values__card-icon--teal">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="values__card-title">Radical Transparency</h3>
          <p class="values__card-text">
            No black-box tactics. No vague reports. You see exactly what we're doing,
            why we're doing it, and what results it's driving. Full access, always.
          </p>
        </div>

        <div class="values__card" data-animate>
          <div class="values__card-icon values__card-icon--purple">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3 class="values__card-title">Agency-First</h3>
          <p class="values__card-text">
            We built this for agencies because we were one. Every process,
            report, and deliverable is designed for your workflow.
          </p>
        </div>

        <div class="values__card" data-animate>
          <div class="values__card-icon values__card-icon--green">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
          </div>
          <h3 class="values__card-title">Results Over Rhetoric</h3>
          <p class="values__card-text">
            Rankings, traffic, conversions — the metrics that matter to your
            clients. No vanity metrics, no fluff.
          </p>
        </div>

        <div class="values__card" data-animate>
          <div class="values__card-icon values__card-icon--purple">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </div>
          <h3 class="values__card-title">Scale Without Sacrifice</h3>
          <p class="values__card-text">
            Whether you have 5 SEO clients or 500, the quality stays
            the same. We grow with you, not against you.
          </p>
        </div>

        <div class="values__card values__card--wide" data-animate>
          <div class="values__card-icon values__card-icon--teal">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
          <h3 class="values__card-title">Genuine Partnership</h3>
          <p class="values__card-text">
            We don't do "set it and forget it." Your dedicated strategist knows your
            clients by name, joins your calls when needed, and celebrates your wins
            like they're our own — because they are.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ ORIGIN STORY ═══════════════════════════════════ -->
  <section class="origin">
    <div class="container">
      <div class="origin__grid" data-animate>
        <div class="origin__content">
          <span class="section-label">The Beginning</span>
          <h2 class="origin__heading">
            SEO Brothers didn't start as a white-label company.
          </h2>
          <p class="origin__text">
            White-label happened before it was a deliberate choice. The
            first paying work back in 2015 came as agency overflow, and
            it took COVID to realize it was the side that scaled. The
            more deliberate move however is the one happening now:
            rebuilding from the ground up as a technology-first SEO
            company to further help agencies scale with ease.
          </p>
        </div>

        <div class="origin__timeline">
          <div class="origin__milestone" data-animate>
            <span class="origin__year">2015</span>
            <div class="origin__milestone-content">
              <h3>Diving Right In</h3>
              <p>
                Adam and Devon decide to partner on a business focused
                exclusively on SEO. Adam joins a West Coast agency while
                Devon quits his job and goes all in, while training
                from Adam on everything he knows about SEO.
              </p>
              <p>
                They register Cognatio Media as an Ontario partnership on
                June 1. Their first concept (Flip Marketing: build digital
                properties, rank them, sell them) doesn't pan out. They
                pivot hard to client work.
              </p>
            </div>
          </div>
          <div class="origin__milestone" data-animate>
            <span class="origin__year">2016</span>
            <div class="origin__milestone-content">
              <h3>Becoming SEO Brothers</h3>
              <p>
                Cognatio Media slowly adds small business clients in
                the Kitchener-Waterloo area and takes on overflow work
                from Adam's West Coast agency.
              </p>
              <p>
                Cognatio Media then gets a friendlier name. SEO Brothers
                launches with Adam contributing the content (limited by
                his non-compete) and Devon still working on finding
                clients and delivering the work.
              </p>
            </div>
          </div>
          <div class="origin__milestone" data-animate>
            <span class="origin__year">2017</span>
            <div class="origin__milestone-content">
              <h3>The first real white-label partner</h3>
              <p>
                An agency looking for a new vendor finds SEO Brothers
                when searching for "Waterloo SEO". Many meetings later
                they sign a multi-location HVAC dealer co-op campaign.
              </p>
              <p>
                This is when they decide to start marketing to agencies
                instead of businesses.
              </p>
            </div>
          </div>
          <div class="origin__milestone" data-animate>
            <span class="origin__year">2018</span>
            <div class="origin__milestone-content">
              <h3>Adam full-time</h3>
              <p>
                A timely client in the cannabis space frees enough
                revenue for Adam to join SEO Brothers full-time.
              </p>
            </div>
          </div>
          <div class="origin__milestone" data-animate>
            <span class="origin__year">2019</span>
            <div class="origin__milestone-content">
              <h3>Brother Peter Bate joins</h3>
              <p>
                With another revenue milestone for many multi-location
                contracts, Peter comes on as an SEO specialist late 2019
                to help with the increased volume of work. After some
                growing pains Peter's attention to detail was needed
                to keep quality standards in check. Today he runs
                fulfillment for every campaign that ships.
              </p>
            </div>
          </div>
          <div class="origin__milestone" data-animate>
            <span class="origin__year">2020</span>
            <div class="origin__milestone-content">
              <h3>Building a real business</h3>
              <p>
                COVID changes everything. Initial requests of "we need to
                pause" cause a set back. It's a rebuilding time to
                overhaul internal process and training and focus on
                delivering high quality white label work. After the first
                few months of feeling the pinch, a trend emerges.
                Agencies lay off in-house SEO staff and lean harder on
                subcontractors. "White label SEO" demand explodes, and
                SEO Brothers is at the top of the list already ranking
                for it.
              </p>
              <p>
                It's time to go all in on <a href="/white-label-seo-services/">white label SEO</a>.
              </p>
              <p>
                Demo call after demo call leads to another season of
                rapid growth. The time spent on systems pays off and the
                team starts hiring more senior roles to support the
                increased demands.
              </p>
            </div>
          </div>
          <div class="origin__milestone" data-animate>
            <span class="origin__year">2025</span>
            <div class="origin__milestone-content">
              <h3>Technology-first with brother Colin Bate</h3>
              <p>
                AI is here and not just a toy anymore. The past few years
                saw a shift from "this better not be AI" to "I hope
                you're taking advantage of AI" and the entire industry
                shifts. Not just the search landscape but how to run an
                efficient white label agency.
              </p>
              <p>
                This leads to a push for a ground-up rebuild of the
                Partner Portal and internal tooling, led by Colin Bate,
                who joins as CTO after 17 years building internal
                software for a Bermuda-based mutual fund company.
              </p>
              <p>
                SEO Brothers is rapidly becoming a technology-first SEO
                partner, making partnerships and collaboration easier
                with radical transparency and constant communication.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ CTA ═══════════════════════════════════════════ -->
  <CtaBanner />

  <Footer />

  <script>
    document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => {
      const target = parseInt(el.dataset.count || "0", 10);
      el.textContent = target.toLocaleString();
    });
  </script>
</Layout>

<style>
  /* ═══════════════════════════════════════════════════════════════════
     HERO
     ═══════════════════════════════════════════════════════════════════ */
  .about-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background: var(--dark);
    overflow: hidden;
  }

  .about-hero__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .about-hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.18;
  }

  .about-hero__orb--1 {
    width: 500px;
    height: 500px;
    background: var(--teal);
    top: -10%;
    right: -5%;
  }

  .about-hero__orb--2 {
    width: 400px;
    height: 400px;
    background: var(--purple);
    bottom: -15%;
    left: -10%;
  }

  .about-hero__orb--3 {
    width: 300px;
    height: 300px;
    background: var(--green);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0.08;
  }

  .about-hero__grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .about-hero__inner {
    position: relative;
    z-index: 1;
    padding: 180px 24px 120px;
    max-width: 860px;
  }

  .about-hero__label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal-light);
    margin-bottom: 32px;
  }

  .about-hero__label-dot {
    width: 8px;
    height: 8px;
    background: var(--green);
    border-radius: 50%;
  }

  .about-hero__title {
    font-family: var(--font-display);
    font-size: clamp(40px, 7vw, 76px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text-on-dark);
    margin-bottom: 28px;
  }

  .about-hero__subtitle {
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.7;
    color: var(--text-on-dark-muted);
    max-width: 600px;
    margin-bottom: 0;
  }

  .about-hero__subtitle-aside {
    display: block;
    font-size: clamp(16px, 1.8vw, 19px);
    font-style: italic;
    color: var(--purple-light);
    margin-bottom: 16px;
  }

  .about-hero__scroll-cue {
    position: absolute;
    bottom: 48px;
    left: 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .about-hero__scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--teal), transparent);
  }

  /* ═══════════════════════════════════════════════════════════════════
     BROTHERS — Prominent founder section
     ═══════════════════════════════════════════════════════════════════ */
  .brothers {
    padding: 120px 0;
    background: var(--white);
  }

  .brothers__header {
    margin-bottom: 72px;
  }

  .brothers__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .brothers__card {
    text-align: center;
    padding: 48px 36px;
    border-radius: var(--radius-xl);
    background: var(--light);
    border: 1px solid var(--border-light);
    transition: all var(--transition);
    position: relative;
