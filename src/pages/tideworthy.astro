---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import TideworthySignupForm from "../components/TideworthySignupForm.astro";
import { loadPlatformPricing, marketingTiers } from "../data/platform-pricing";
import { usd } from "../data/pricing";

// The Tideworthy marketing site, brought onto seobrothers.com. tideworthy.com
// redirects here, so this page is the public explanation of the platform:
// what it is, how it runs, what is ready, and the three plans. The form in
// the hero is the same one as /sign-up/, which every Start Free
// Trial button on the site points at. Prices and plan shapes come from the
// platform's public price list (src/data/platform-pricing.ts); nothing on
// this page carries its own number.
//
// Content adapted from the live tideworthy.com home, /platform, and /about
// pages. The /results page 404s, so there is no case-study section here yet.

const { data: platform } = await loadPlatformPricing();
const tiers = marketingTiers(platform);
const tiny = tiers[0];
const implementation = tiny?.implementation ?? 75;

// The three-step onboarding from the tideworthy.com home page.
const steps = [
  {
    n: "1",
    title: "Connect a client",
    body: "Hook up the site, Search Console, Analytics, and the Business Profile. It takes about ten minutes and the agents start learning the account immediately.",
  },
  {
    n: "2",
    title: "Pick the plan and the rules",
    body: "One plan per client sets what a month delivers, and an approval line you draw yourself. Nothing client-facing ships without you saying so.",
  },
  {
    n: "3",
    title: "Approve, and it goes out as you",
    body: "The agents work daily. What lands in front of your client carries your logo, on your domain, in a portal that is yours.",
  },
];

// Capability blocks, adapted from tideworthy.com/platform.
const capabilities = [
  {
    title: "The work actually gets done",
    body: "Every client carries a running list of real deliverables: content written, technical fixes shipped, internal links built, pages reviewed. The agents propose the monthly plan and then have to earn it. The full history stays on the account.",
  },
  {
    title: "You approve everything that matters",
    body: "One queue holds everything waiting on your decision, across your whole book. Plans, website edits, and keyword sets get requested by name. Research and monitoring keep running without asking.",
  },
  {
    title: "Scope and price, up front",
    body: "Each campaign shows what happens this month and what it costs before it runs: one plan price per client, the deliverables it carries, the cadence it runs at. No surprise invoices, and no cut of what you bill your client.",
  },
  {
    title: "Monitoring you switch on",
    body: "A set of scheduled checks per client that you toggle: site crawl, technical SEO, page speed, Business Profile, brand search. You hear about a problem before your client does.",
  },
  {
    title: "Rankings your client can check",
    body: "Location-specific keyword tracking, updated daily, mapped to whichever page is actually positioned to win the term.",
  },
  {
    title: "Reports that wear your logo",
    body: "Reporting goes out under your brand, from your domain. Our name is nowhere your client will ever look.",
  },
];

const roadmap = [
  {
    status: "Live",
    name: "SEO",
    body: "Research, content, technical fixes, links, monitoring, and reporting.",
    state: "live",
  },
  {
    status: "Beta",
    name: "Websites",
    body: "Hosted, editable by conversation, and versioned so nothing is lost.",
    state: "beta",
  },
  {
    status: "Coming",
    name: "PPC",
    body: "Search and local campaigns, managed the same way.",
    state: "soon",
  },
];

// The difference we sell: AI throughput at the lowest cost, humans still
// running every campaign behind it.
const pillars = [
  {
    eyebrow: "Lowest cost",
    title: "AI and data do the heavy lifting",
    body: "Research, drafting, technical checks, monitoring and reporting run on agents and live data, every day, for every client. That is why a full local campaign starts where it does, and why it scales without the price scaling with it.",
  },
  {
    eyebrow: "Humans in the loop",
    title: "QA runs across everything the agents produce",
    body: "Every output goes through our QA checks and a strategist's eyes: most before it ships, some right after, and the bar rises every month because our own campaigns run on the same system.",
  },
  {
    eyebrow: "Humans on the campaign",
    title: "People behind the delivery, with you",
    body: "Strategists plan the month, run the reviews and answer your questions. When a client needs an explanation, you have a team behind you who knows the account, not a support queue.",
  },
];

// The card in the thesis: how a white-label SEO shop came to build its own
// platform, three beats.
const story = [
  {
    year: "2015",
    title: "SEO Brothers starts",
    body: "Adam and Devon open a white-label SEO shop and become the partner behind other agencies' work.",
  },
  {
    year: "2024",
    title: "Colin joins and the build begins",
    body: "Our oldest brother, twenty years a software engineer in FinTech, comes on board to build one connected system that runs every campaign.",
  },
  {
    year: "2026",
    title: "Welcome, Tideworthy",
    body: "The system gets a name and a door. Our own team runs every campaign in it, testing, running and improving it daily.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Tideworthy",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description:
    "AI agents that do white-label SEO delivery work for agencies: content, local SEO, technical fixes, monitoring, and reporting, under the agency's own brand.",
  publisher: {
    "@type": "Organization",
    name: "SEO Brothers, Inc.",
    url: "https://seobrothers.com/",
  },
  offers: {
    "@type": "Offer",
    price: tiny?.price ?? 174,
    priceCurrency: "USD",
    url: "https://seobrothers.com/pricing/",
  },
};
---

<Layout
  title="Tideworthy | AI Agents That Do the Delivery Work | SEO Brothers"
  description="Tideworthy is the platform behind SEO Brothers: AI agents do the daily SEO delivery work for every client, our team QA checks the work, and it all ships under your agency's brand. You pick the plan and draw the approval line."
  schema={schema}
>
  <Nav />

  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="tw-hero">
    <div class="tw-hero__bg">
      <div class="tw-hero__orb tw-hero__orb--1"></div>
      <div class="tw-hero__orb tw-hero__orb--2"></div>
      <div class="tw-hero__grid"></div>
    </div>
    <div class="container tw-hero__inner">
      <div class="tw-hero__copy">
        <a href="https://tideworthy.com/" class="tw-hero__brand" data-animate aria-label="Tideworthy">
          <svg class="tw-hero__brand-mark" viewBox="0 0 48 48" width="36" height="36" aria-hidden="true">
            <circle cx="24" cy="24" r="15" fill="none" stroke="currentColor" stroke-width="3" />
            <path d="M2 24 Q 13 20.5 24 24 T 46 24" fill="none" stroke="currentColor" stroke-width="3" />
          </svg>
          <span class="tw-hero__brand-name">Tideworthy</span>
        </a>
        <span class="tw-hero__label" data-animate>
          <span class="tw-hero__label-dot"></span>
          The Platform Behind Our Work
        </span>
        <h1 class="tw-hero__title" data-animate>
          One engine.
          <span class="tw-hero__title-gradient">Your name on all of it.</span>
        </h1>
        <p class="tw-hero__sub" data-animate>
          Tideworthy is the software we built to run campaigns, and it is what
          your clients' work runs in. AI agents learn your agency and every
          client's business, then do the daily delivery: content, local SEO,
          technical fixes, monitoring, reporting. Our team QA checks the work.
          You pick the plan, draw the approval line, and put your logo on top.
        </p>
        <p class="tw-hero__sub tw-hero__sub--aside" data-animate>
          Not sure which plan? Run a free discovery on any client and we will
          recommend the right one, or build you a custom offer.
        </p>
        <div class="tw-hero__actions" data-animate>
          <a href="/sign-up/" class="btn btn-primary btn-lg">
            Start Free Trial
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href="/book-a-growth-call/" class="btn btn-outline btn-lg">
            Book a demo
          </a>
        </div>
        <p class="tw-hero__note" data-animate>
          Your free trial doesn't start until you start a campaign. Using the platform and running free discoveries is free. No card required.
        </p>
      </div>
      <div class="tw-hero__form" data-animate>
        <TideworthySignupForm compact heading="Start your free trial" />
      </div>
    </div>
  </section>

  <!-- ═══════════════ HOW IT WORKS ═══════════════ -->
  <section class="tw-steps">
    <div class="container">
      <div class="tw-sec-head" data-animate>
        <span class="section-label">How It Works</span>
        <h2 class="tw-sec-title">Ten minutes to connect. Then it runs.</h2>
      </div>
      <div class="tw-steps__grid" data-stagger>
        {
          steps.map((s) => (
            <div class="tw-step" data-animate>
              <span class="tw-step__n">{s.n}</span>
              <h3 class="tw-step__title">{s.title}</h3>
              <p class="tw-step__body">{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════ AI THROUGHPUT, HUMAN JUDGMENT ═══════════════ -->
  <section class="tw-human">
    <div class="container">
      <div class="tw-sec-head tw-sec-head--center" data-animate>
        <span class="section-label">How We Are Different</span>
        <h2 class="tw-sec-title">AI does the volume. Humans oversee the campaign.</h2>
        <p class="tw-sec-sub">
          We lean on AI tooling and data harder than anyone, which is how the
          plans cost what they cost. Behind every campaign is still a team of
          people who review the work and stand behind it with you.
        </p>
      </div>
      <div class="tw-human__grid" data-stagger>
        {
          pillars.map((p) => (
            <article class="tw-pillar" data-animate>
              <span class="tw-pillar__eyebrow">{p.eyebrow}</span>
              <h3 class="tw-pillar__title">{p.title}</h3>
              <p class="tw-pillar__body">{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════ CAPABILITIES ═══════════════ -->
  <section class="tw-caps">
    <div class="container">
      <div class="tw-sec-head" data-animate>
        <span class="section-label">What It Does</span>
        <h2 class="tw-sec-title">Delivery, not another dashboard.</h2>
        <p class="tw-sec-sub">
          Plenty of software will show your client a chart. This does the work
          that goes in the chart, and it does it every day.
        </p>
      </div>
      <div class="tw-caps__grid" data-stagger>
        {
          capabilities.map((c) => (
            <article class="tw-cap" data-animate>
              <h3 class="tw-cap__title">{c.title}</h3>
              <p class="tw-cap__body">{c.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════ THESIS ═══════════════ -->
  <section class="tw-thesis">
    <div class="container tw-thesis__inner">
      <div class="tw-thesis__copy" data-animate>
        <span class="section-label">Why We Built It</span>
        <h2 class="tw-thesis__title">
          Your clients did not hire a dashboard. They hired <em>you</em>.
        </h2>
        <p>
          That is your moat, and the AI-first shops cannot copy it. What they
          can do is out-produce you at a tenth of the price. So we built the
          missing half: an engine that produces like they do, wearing your
          logo, with our strategists checking the work. You stay the agency.
          The work keeps up.
        </p>
        <p>
          The agency was never just the deliverables. It is the person who
          answers the phone when a client is panicking and takes the win or
          the loss personally. That part does not automate, and it is the part
          worth protecting.
        </p>
        <p class="tw-thesis__name">
          The name comes from the Plimsoll line, the waterline mark on a ship's
          hull that says how much it can carry and still come home. Tideworthy
          means an agency can survive what is coming.
        </p>
      </div>
      <aside class="tw-thesis__card" data-animate>
        <h3 class="tw-thesis__card-title">Built by the people using it</h3>
        <ol class="tw-story">
          {
            story.map((t) => (
              <li class="tw-story__item">
                <span class="tw-story__year">{t.year}</span>
                <div class="tw-story__text">
                  <strong class="tw-story__title">{t.title}</strong>
                  <p class="tw-story__body">{t.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <a href="/about/" class="tw-thesis__link">
          Meet the team
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </aside>
    </div>
  </section>

  <!-- ═══════════════ ROADMAP ═══════════════ -->
  <section class="tw-road">
    <div class="container">
      <div class="tw-sec-head" data-animate>
        <span class="section-label">What's Ready</span>
        <h2 class="tw-sec-title">SEO today. Websites next. PPC after that.</h2>
        <p class="tw-sec-sub">
          We would rather tell you what is still in beta than let you find out
          on a client's account.
        </p>
      </div>
      <div class="tw-road__grid" data-stagger>
        {
          roadmap.map((r) => (
            <div class:list={["tw-road__item", `tw-road__item--${r.state}`]} data-animate>
              <span class="tw-road__status">{r.status}</span>
              <h3 class="tw-road__name">{r.name}</h3>
              <p class="tw-road__body">{r.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════ PLANS ═══════════════ -->
  <section class="tw-get">
    <div class="container tw-get__inner">
      <div class="tw-sec-head tw-sec-head--center" data-animate>
        <span class="section-label">Plans</span>
        <h2 class="tw-sec-title">Three Local SEO plans. One platform.</h2>
        <p class="tw-sec-sub">
          Every plan runs the same process. The plan sets how much of each
          deliverable a campaign carries in a month and how often the
          specialists work it. Wholesale, per client; you set your own price.
        </p>
      </div>
      <div class="tw-get__grid">
        {
          tiers.map((tier) => (
            <div class:list={["tw-get__card", tier.featured && "tw-get__card--featured"]} data-animate>
              <span class="tw-get__who">{tier.highlights[tier.highlights.length - 1]}</span>
              <h3 class="tw-get__name">{tier.name}</h3>
              <p class="tw-get__price">
                <span class="tw-get__price-value">{usd(tier.price)}</span>
                <span class="tw-get__price-suffix">/ mo per client</span>
              </p>
              <ul class="tw-get__list">
                {tier.highlights.slice(0, -1).map((h) => <li>{h}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="tw-get__foot" data-animate>
        Add {usd(implementation)} a month on any plan and our team implements the
        website changes for you. Your free trial doesn't start until you start a campaign. Using the platform and running free discoveries is free. <a href="/pricing/">See the full comparison</a>.
      </p>
    </div>
  </section>

  <!-- ═══════════════ CLOSE ═══════════════ -->
  <section class="tw-close">
    <div class="container tw-close__inner" data-animate>
      <h2 class="tw-close__title">
        Keep your clients, your margin, and your name.
      </h2>
      <p class="tw-close__body">
        Create a free account and connect one client. Run a discovery, look at
        what the agents propose, and decide from there. Your free trial doesn't start until you start a campaign. Using the platform and running free discoveries is free. There is no card to enter.
      </p>
      <div class="tw-close__actions">
        <a href="/sign-up/" class="btn btn-primary btn-lg">
          Start Free Trial
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a href="/book-a-growth-call/" class="btn btn-outline btn-lg">
          Talk to a human
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ═══════════ SHARED SECTION HEADS ═══════════ */
  .tw-sec-head {
    max-width: 660px;
    margin-bottom: 48px;
  }
  .tw-sec-head--center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }
  .tw-sec-head .section-label {
    display: inline-block;
  }
  .tw-sec-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.8vw, 40px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--text-primary);
    margin: 12px 0 0;
  }
  .tw-sec-sub {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 14px 0 0;
  }

  /* ═══════════ HERO ═══════════ */
  .tw-hero {
    position: relative;
    padding: 170px 0 120px;
    background: var(--dark);
    overflow: hidden;
  }
  .tw-hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .tw-hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(130px);
    opacity: 0.3;
  }
  .tw-hero__orb--1 {
    width: 560px;
    height: 560px;
    top: -180px;
    left: -140px;
    background: var(--teal);
  }
  .tw-hero__orb--2 {
    width: 480px;
    height: 480px;
    bottom: -200px;
    right: -120px;
    background: var(--teal-dark);
  }
  .tw-hero__grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at 50% 40%, black 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 40%, black 20%, transparent 75%);
  }
  .tw-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(340px, 420px);
    gap: 56px;
    align-items: center;
  }
  .tw-hero__copy {
    text-align: left;
    max-width: 640px;
  }
  /* Platform logo lockup. Mirrors the brand mark on tideworthy.com: a
     circle with a tide line through it, wordmark in the display face. */
  .tw-hero__brand {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    color: var(--white);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    transition: opacity var(--transition);
  }
  .tw-hero__brand:hover {
    opacity: 0.85;
  }
  .tw-hero__brand-mark {
    color: var(--teal-light);
    flex-shrink: 0;
  }
  .tw-hero__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-full);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
    background: rgba(255, 255, 255, 0.04);
  }
  .tw-hero__label-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal-light);
  }
  .tw-hero__title {
    font-family: var(--font-display);
    font-size: clamp(38px, 6vw, 66px);
    font-weight: 700;
    line-height: 1.03;
    letter-spacing: -0.03em;
    color: var(--white);
    margin: 22px 0 20px;
  }
  /* Two shades of one hue, per the site's gradient convention. */
  .tw-hero__title-gradient {
    display: block;
    background: linear-gradient(100deg, var(--teal) 0%, var(--teal-light) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .tw-hero__sub {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-on-dark-muted);
    max-width: 680px;
    margin: 0 auto 32px;
  }
  .tw-hero__sub--aside {
    margin-top: -6px;
    font-size: 15px;
    opacity: 0.85;
  }
  .tw-hero__actions {
    display: flex;
    gap: 14px;
    justify-content: flex-start;
    flex-wrap: wrap;
  }
  .tw-hero__note {
    margin: 20px 0 0;
    font-size: 14px;
    color: var(--text-on-dark-muted);
    opacity: 0.75;
  }

  /* ═══════════ STEPS ═══════════ */
  .tw-steps {
    padding: 100px 0;
    background: var(--white);
  }
  .tw-steps__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .tw-step {
    padding: 30px 26px;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    background: var(--light);
  }
  .tw-step__n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(40, 165, 177, 0.13);
    color: var(--teal-dark);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .tw-step__title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin: 0 0 10px;
  }
  .tw-step__body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* ═══════════ CAPABILITIES ═══════════ */
  .tw-caps {
    padding: 100px 0;
    background: var(--light);
    border-top: 1px solid var(--border-light);
  }
  .tw-caps__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .tw-cap {
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 28px 26px;
    border-top: 3px solid var(--teal);
  }
  .tw-cap__title {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin: 0 0 10px;
    line-height: 1.25;
  }
  .tw-cap__body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* ═══════════ THESIS ═══════════ */
  .tw-human {
    padding: 100px 0;
    background: var(--white);
    border-top: 1px solid var(--border-light);
  }
