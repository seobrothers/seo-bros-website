---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const portalUrl = "https://portal.seobrothers.com/onboard";

const accessItems = [
  {
    title: "A walkthrough with Mike",
    body: "He'll show you how we work, answer questions, and align on what your agency actually needs. Plain conversation, no slide deck pitch.",
  },
  {
    title: "Your first discovery audit, free",
    body: "Submit a site during the demo to see how we work in real life. Discoveries stay free for every campaign once you're a partner; this first one is your no-strings test drive.",
  },
  {
    title: "A free Portal account",
    body: "We'll set one up so you can follow along, message the team, and submit your discovery. Yours to keep whether you become a partner or not.",
  },
  {
    title: "A look at the team behind it",
    body: "An Account Manager for sales support, positioning, and team training. An SEO Manager for campaign strategy, onboarding, and quarterly planning.",
  },
  {
    title: "How the white-label side works",
    body: "Dashboards, reports, and client-facing materials under your branding. We'll show you what your clients see.",
  },
];
---

<Layout
  title="Book a Demo with SEO Brothers | White Label SEO Partner"
  description="Book a quick demo with SEO Brothers. See how we work, get your first discovery audit free, and meet the team behind the partnership. No commitment."
>
  <Nav variant="light" hideCta={true} />

  <section class="signup">
    <div class="signup__bg">
      <div class="signup__orb signup__orb--1"></div>
      <div class="signup__orb signup__orb--2"></div>
      <div class="signup__grid-bg"></div>
    </div>

    <div class="container signup__inner">
      <div class="signup__layout">
        <div class="signup__pitch" data-animate>
          <span class="section-label">Book a Demo</span>
          <h1 class="signup__title">See how we work, no commitment</h1>
          <p class="signup__lede">
            Share a few quick details and Mike will set up a walkthrough.
            We'll show you how we work, get your first discovery audit
            moving, and answer anything you want to ask. No pressure to sign
            anything before you're ready.
          </p>

          <div class="signup__mike">
            <img
              src="/images/team/mike-eaton.png"
              alt="Mike Eaton"
              class="signup__mike-photo"
              loading="lazy"
              width="64"
              height="64"
            />
            <div>
              <p class="signup__mike-name">Mike Eaton</p>
              <p class="signup__mike-role">Account Executive, SEO Brothers</p>
            </div>
          </div>

          <h2 class="signup__list-title">What you'll get</h2>
          <ul class="signup__list">
            {
              accessItems.map((item) => (
                <li class="signup__list-item">
                  <span class="signup__list-icon" aria-hidden="true">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  </span>
                  <div>
                    <span class="signup__list-title-row">{item.title}</span>
                    <span class="signup__list-body">{item.body}</span>
                  </div>
                </li>
              ))
            }
          </ul>

          <p class="signup__note">
            Discoveries are always free for partners. Your first one runs
            during the demo. If we're a fit and you want to move forward,
            a simple partnership agreement comes before any campaigns
            activate. If we're not a fit, you keep the account and the audit
            either way.
          </p>

          <p class="signup__signoff">— The Brothers</p>
        </div>

        <aside class="signup__form-wrap" data-animate>
          <div class="signup__form-head">
            <h2 class="signup__form-title">Book a Demo</h2>
            <p class="signup__form-sub">
              Tell us a bit about you and your agency. Mike will reach out to
              set up the walkthrough.
            </p>
          </div>

          <form
            method="POST"
            action={portalUrl}
            class="signup__form"
            novalidate
          >
            <div class="signup__field-row">
              <div class="signup__field">
                <label for="firstName" class="signup__label">
                  First name
                </label>
                <input
                  type="text"
                  id="firstName"
                  name="firstName"
                  class="signup__input"
                  placeholder="Jane"
                  required
                  autocomplete="given-name"
                />
              </div>
              <div class="signup__field">
                <label for="lastName" class="signup__label">
                  Last name
                </label>
                <input
                  type="text"
                  id="lastName"
                  name="lastName"
                  class="signup__input"
                  placeholder="Doe"
                  required
                  autocomplete="family-name"
                />
              </div>
            </div>

            <div class="signup__field">
              <label for="email" class="signup__label">
                Email address
              </label>
              <input
                type="email"
                id="email"
                name="email"
                class="signup__input"
                placeholder="jane.doe@example.com"
                required
                autocomplete="email"
              />
            </div>

            <div class="signup__field">
              <label for="companyName" class="signup__label">
                Agency name
              </label>
              <input
                type="text"
                id="companyName"
                name="companyName"
                class="signup__input"
                placeholder="Example Solutions"
                required
                autocomplete="organization"
              />
            </div>

            <div class="signup__field">
              <label for="companySite" class="signup__label">
                Agency website
              </label>
              <input
                type="url"
                id="companySite"
                name="companySite"
                class="signup__input"
                placeholder="https://example.com"
                required
                autocomplete="url"
              />
            </div>

            <button type="submit" class="btn btn-primary signup__submit">
              Book a Demo
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path
                  d="M3 8h10M9 4l4 4-4 4"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>

            <div class="signup__alt" aria-hidden="true">
              {/* Reserved space for a future "Prefer to chat first?" link. Leave empty until we want to test it. */}
            </div>
          </form>
        </aside>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  import { track } from "../lib/analytics";

  const form = document.querySelector<HTMLFormElement>(".signup__form");
  const submitBtn = form?.querySelector<HTMLButtonElement>(".signup__submit");

  form?.addEventListener("submit", (e) => {
    if (!form.checkValidity()) {
      e.preventDefault();
      form.reportValidity();
      return;
    }
    track("portal_signups");
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Sending...";
    }
  });
</script>

<style>
  .signup {
    position: relative;
    padding: 120px 0 80px;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    overflow: hidden;
  }

  .signup__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .signup__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.25;
  }

  .signup__orb--1 {
    width: 480px;
    height: 480px;
    top: -120px;
    left: -160px;
    background: var(--teal);
  }

  .signup__orb--2 {
    width: 420px;
    height: 420px;
    bottom: -160px;
    right: -120px;
    background: var(--green);
  }

  .signup__grid-bg {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
        rgba(15, 23, 42, 0.04) 1px,
        transparent 1px
      ),
      linear-gradient(90deg, rgba(15, 23, 42, 0.04) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(
      ellipse at center,
      black 30%,
      transparent 80%
    );
    -webkit-mask-image: radial-gradient(
      ellipse at center,
      black 30%,
      transparent 80%
    );
  }

  .signup__inner {
    position: relative;
    z-index: 1;
  }

  .signup__layout {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 64px;
    align-items: start;
  }

  .signup__pitch .section-label {
    display: inline-block;
  }

  .signup__title {
    font-family: var(--font-display);
    font-size: clamp(36px, 5.2vw, 56px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 12px 0 18px;
  }

  .signup__lede {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 28px;
    max-width: 520px;
  }

  .signup__mike {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    margin-bottom: 24px;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .signup__mike-photo {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .signup__mike-name {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .signup__mike-role {
    font-size: 13px;
    color: var(--text-muted);
    margin: 2px 0 0;
    line-height: 1.3;
  }

  .signup__list-title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 16px;
  }

  .signup__list {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .signup__list-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .signup__list-icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(68, 185, 123, 0.12);
    color: var(--green);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  .signup__list-title-row {
    display: block;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .signup__list-body {
    display: block;
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-secondary);
    margin-top: 2px;
  }

  .signup__note {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
    padding: 14px 16px;
    background: rgba(15, 23, 42, 0.03);
    border-radius: var(--radius-md);
    margin-bottom: 20px;
  }

  .signup__signoff {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--text-primary);
    font-weight: 500;
    margin: 0;
  }

  .signup__form-wrap {
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 32px;
    box-shadow: var(--shadow-lg);
    position: sticky;
    top: 96px;
  }

  .signup__form-head {
    margin-bottom: 24px;
  }

  .signup__form-title {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--text-primary);
    margin: 0 0 6px;
  }

  .signup__form-sub {
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
  }

  .signup__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .signup__field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .signup__field {
    display: flex;
    flex-direction: column;
  }

  .signup__label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 6px;
    letter-spacing: 0.01em;
  }

  .signup__input {
    width: 100%;
    padding: 11px 14px;
    font-size: 15px;
    font-family: inherit;
    color: var(--text-primary);
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .signup__input::placeholder {
    color: var(--text-muted);
  }

  .signup__input:focus {
    outline: none;
    border-color: var(--teal);
    box-shadow: 0 0 0 3px rgba(45, 175, 175, 0.15);
  }

  .signup__input:invalid:not(:placeholder-shown) {
    border-color: #d97a7a;
  }

  .signup__submit {
    margin-top: 8px;
    width: 100%;
    justify-content: center;
  }

  .signup__submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .signup__alt {
    min-height: 0;
  }

  .signup__alt:not(:empty) {
    margin-top: 12px;
    text-align: center;
    font-size: 13px;
    color: var(--text-muted);
  }

  @media (max-width: 960px) {
    .signup {
      padding: 88px 0 64px;
    }

    .signup__layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .signup__form-wrap {
      padding: 24px;
      position: static;
    }

    .signup__title {
      font-size: clamp(32px, 7vw, 44px);
    }
  }

  @media (max-width: 480px) {
    .signup__field-row {
      grid-template-columns: 1fr;
    }
  }
</style>
