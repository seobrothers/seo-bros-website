---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { authorByName } from "../data/authors";

const launchDate = "September 29, 2026";

const hosts = [
  {
    name: "Adam Bate",
    role: "Co-host · Founder & COO",
    bio: "Twenty plus years in search. Adam has watched the algorithm updates come and go, and he brings the long memory and the strong opinions to every episode.",
    photo: "/images/team/adam-bate.png",
  },
  {
    name: "Devon Bate",
    role: "Co-host · Founder & CEO",
    bio: "Devon started as a lead SEO specialist and now runs SEO Brothers. He brings the operator's view: what is actually working, what is hype, and what it takes to run the work at scale.",
    photo: "/images/team/devon-bate.png",
  },
].map((h) => {
  // Link the host to their author page once that page is published.
  const a = authorByName(h.name);
  return { ...h, href: a && a.published ? `/authors/${a.slug}/` : null };
});

const platforms = [
  "Spotify",
  "Apple Podcasts",
  "YouTube",
  "Overcast",
  "Pocket Casts",
];

const segments = [
  {
    name: "Crawl Space",
    text: "Our recurring teardown. We climb into the crawl space of a real site or campaign and poke at the unglamorous mechanics most people never look at: the redirects, the architecture, the technical debt, the small fixes that move rankings more than the flashy stuff.",
  },
  {
    name: "Tool Shed",
    text: "What's in the shed this week. We pull out the AI tools and automations agencies can actually use to cut the busywork and speed up delivery, then call what's worth adding to your stack and what's just hype.",
  },
];
---

<Layout
  title="Brothers in Search | The SEO Brothers Podcast"
  description="Brothers in Search is the upcoming podcast from Adam and Devon Bate of SEO Brothers. A look at the work behind the rankings, new episodes every Tuesday starting September 29, 2026."
>
  <Nav />

  <!-- ═══════════════════════════════════════════ HERO ═══════════════════════════════════════════ -->
  <section class="pod-hero">
    <div class="pod-hero__bg">
      <div class="pod-hero__orb pod-hero__orb--1"></div>
      <div class="pod-hero__orb pod-hero__orb--2"></div>
      <div class="pod-hero__orb pod-hero__orb--3"></div>
      <div class="pod-hero__grid-overlay"></div>
    </div>

    <div class="container pod-hero__inner">
      <div class="pod-hero__label" data-animate>
        <span class="pod-hero__label-dot"></span>
        Podcast · Coming Soon
      </div>

      <h1 class="pod-hero__title" data-animate>Brothers in Search</h1>

      <p class="pod-hero__tagline" data-animate>
        Two brothers, an SEO agency, and a weekly look at the work behind
        the rankings.
      </p>

      <div class="pod-hero__meta" data-animate>
        <span class="pod-hero__chip">New episodes every Tuesday</span>
        <span class="pod-hero__chip pod-hero__chip--accent">
          Launching {launchDate}
        </span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ ABOUT ══════════════════════════════════════════ -->
  <section class="pod-about">
    <div class="container">
      <div class="pod-about__inner" data-animate>
        <span class="section-label">What it's about</span>
        <h2 class="section-heading">The most useful half hour in your week</h2>
        <p class="pod-about__text">
          We spend our days running SEO campaigns for agencies and watching
          what search actually rewards. Brothers in Search is where we hand
          that over: the tactics that are working right now, the ones that
          quietly stopped working, and the honest version of what it takes
          to grow an agency in a search landscape that keeps moving.
        </p>
        <p class="pod-about__text">
          No fluff, no recycled best-practice lists. We are still shaping the
          format, but the goal is simple. Every episode should leave you with
          something you can use on Monday morning.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ HOSTS ══════════════════════════════════════════ -->
  <section class="pod-hosts">
    <div class="container">
      <div class="pod-hosts__header" data-animate>
        <span class="section-label">Your hosts</span>
        <h2 class="section-heading">Yes, actual brothers</h2>
      </div>

      <div class="pod-hosts__grid" data-stagger>
        {hosts.map((h) => (
          <div class="pod-hosts__card" data-animate>
            <div class="pod-hosts__photo-wrap">
              <img
                src={h.photo}
                alt={h.name}
                class="pod-hosts__photo"
                loading="lazy"
                width="300"
                height="300"
              />
              <div class="pod-hosts__photo-ring"></div>
            </div>
            <h3 class="pod-hosts__name">
              {h.href ? <a class="pod-hosts__name-link" href={h.href}>{h.name}</a> : h.name}
            </h3>
            <p class="pod-hosts__role">{h.role}</p>
            <p class="pod-hosts__bio">{h.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ SEGMENT TEASER ═════════════════════════════════ -->
  <section class="pod-segment">
    <div class="container">
      <div class="pod-segment__header" data-animate>
        <span class="section-label">Recurring segments</span>
        <h2 class="section-heading">The bits you'll look forward to</h2>
      </div>
      <div class="pod-segment__grid" data-stagger>
        {segments.map((s) => (
          <div class="pod-segment__card" data-animate>
            <span class="pod-segment__kicker">Recurring segment</span>
            <h3 class="pod-segment__title">{s.name}</h3>
            <p class="pod-segment__text">{s.text}</p>
          </div>
        ))}
      </div>
      <p class="pod-segment__hint">More segments to come as we build the show.</p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ PLATFORMS ══════════════════════════════════════ -->
  <section class="pod-platforms">
    <div class="container">
      <div class="pod-platforms__inner" data-animate>
        <span class="section-label--light">Where to listen</span>
        <h2 class="section-heading--light">
          Coming everywhere you get your podcasts
        </h2>
        <p class="pod-platforms__text">
          Follow links go live on launch day. For now, mark the calendar:
          episode one drops {launchDate}.
        </p>
        <div class="pod-platforms__list" data-stagger>
          {platforms.map((p) => (
            <span class="pod-platforms__pill" data-animate>{p}</span>
          ))}
          <span class="pod-platforms__pill pod-platforms__pill--muted" data-animate>
            and more
          </span>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ═══════════════════════════════════════════════════════════════════
     HERO
     ═══════════════════════════════════════════════════════════════════ */
  .pod-hero {
    position: relative;
    min-height: 78vh;
    display: flex;
    align-items: center;
    background: var(--dark);
    overflow: hidden;
  }

  .pod-hero__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .pod-hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.18;
  }

  .pod-hero__orb--1 {
    width: 500px;
    height: 500px;
    background: var(--purple);
    top: -10%;
    right: -5%;
  }

  .pod-hero__orb--2 {
    width: 400px;
    height: 400px;
    background: var(--teal);
    bottom: -15%;
    left: -10%;
  }

  .pod-hero__orb--3 {
    width: 300px;
    height: 300px;
    background: var(--green);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0.08;
  }

  .pod-hero__grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .pod-hero__inner {
    position: relative;
    z-index: 1;
    padding: 180px 24px 120px;
    max-width: 860px;
  }

  .pod-hero__label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal-light);
    margin-bottom: 28px;
  }

  .pod-hero__label-dot {
    width: 8px;
    height: 8px;
    background: var(--green);
    border-radius: 50%;
  }

  .pod-hero__title {
    font-family: var(--font-display);
    font-size: clamp(44px, 8vw, 84px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--text-on-dark);
    margin-bottom: 24px;
  }

  .pod-hero__tagline {
    font-size: clamp(18px, 2.2vw, 22px);
    line-height: 1.6;
    color: var(--text-on-dark-muted);
    max-width: 560px;
    margin-bottom: 36px;
  }

  .pod-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .pod-hero__chip {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-on-dark);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
  }

  .pod-hero__chip--accent {
    color: var(--dark);
    background: linear-gradient(135deg in oklch, var(--teal), var(--green));
    border-color: transparent;
  }

  /* ═══════════════════════════════════════════════════════════════════
     ABOUT
     ═══════════════════════════════════════════════════════════════════ */
  .pod-about {
    padding: 120px 0;
    background: var(--white);
  }

  .pod-about__inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .pod-about__text {
    font-size: 17px;
    line-height: 1.75;
    color: var(--text-secondary);
    margin: 20px 0 0;
  }

  /* ═══════════════════════════════════════════════════════════════════
     HOSTS
     ═══════════════════════════════════════════════════════════════════ */
  .pod-hosts {
    padding: 120px 0;
    background: var(--light);
  }

  .pod-hosts__header {
    text-align: center;
    margin-bottom: 64px;
  }

  .pod-hosts__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    max-width: 760px;
    margin: 0 auto;
  }

  .pod-hosts__card {
    text-align: center;
    padding: 48px 36px;
    border-radius: var(--radius-xl);
    background: var(--white);
    border: 1px solid var(--border-light);
    transition: all var(--transition);
  }

  .pod-hosts__card:hover {
    border-color: rgba(140, 99, 170, 0.25);
    box-shadow: var(--shadow-xl);
    transform: translateY(-6px);
  }

  .pod-hosts__photo-wrap {
    position: relative;
    width: 150px;
    height: 150px;
    margin: 0 auto 28px;
  }

  .pod-hosts__photo {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    position: relative;
    z-index: 1;
  }

  .pod-hosts__photo-ring {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: linear-gradient(135deg in oklch, var(--teal), var(--purple), var(--green));
    z-index: 0;
  }

  .pod-hosts__name {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .pod-hosts__name-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(40, 165, 177, 0.35);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition);
  }

  .pod-hosts__name-link:hover {
    text-decoration-color: var(--teal);
  }

  .pod-hosts__role {
    font-size: 14px;
    font-weight: 600;
    color: var(--teal);
    margin-bottom: 20px;
    letter-spacing: 0.01em;
  }

  .pod-hosts__bio {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  /* ═══════════════════════════════════════════════════════════════════
     SEGMENT TEASER
     ═══════════════════════════════════════════════════════════════════ */
  .pod-segment {
    padding: 0 0 120px;
    background: var(--light);
  }

  .pod-segment__header {
    text-align: center;
    margin-bottom: 48px;
  }

  .pod-segment__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 940px;
    margin: 0 auto;
  }

  .pod-segment__card {
    position: relative;
    padding: 44px 40px;
    border-radius: var(--radius-xl);
    background: var(--dark);
    overflow: hidden;
    text-align: center;
  }

  .pod-segment__kicker {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal-light);
    margin-bottom: 14px;
  }

  .pod-segment__title {
    font-family: var(--font-display);
    font-size: clamp(26px, 3.2vw, 34px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-on-dark);
    margin-bottom: 16px;
  }

  .pod-segment__text {
    font-size: 16px;
    line-height: 1.75;
    color: var(--text-on-dark-muted);
    margin: 0;
  }

  .pod-segment__hint {
    font-size: 14px;
    font-style: italic;
    color: var(--text-muted);
    text-align: center;
    margin: 32px 0 0;
  }

  /* ═══════════════════════════════════════════════════════════════════
     PLATFORMS
     ═══════════════════════════════════════════════════════════════════ */
  .pod-platforms {
    padding: 120px 0;
    background: var(--white);
  }

  .pod-platforms__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .pod-platforms__text {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 20px auto 36px;
    max-width: 520px;
  }

  .pod-platforms__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .pod-platforms__pill {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    background: var(--light);
    border: 1px solid var(--border-light);
    border-radius: 999px;
  }

  .pod-platforms__pill--muted {
    color: var(--text-muted);
    font-weight: 500;
  }

  /* ═══════════════════════════════════════════════════════════════════
     RESPONSIVE
     ═══════════════════════════════════════════════════════════════════ */
  @media (max-width: 768px) {
    .pod-hero__inner {
      padding: 140px 24px 90px;
    }

    .pod-about,
    .pod-hosts,
    .pod-platforms {
      padding: 80px 0;
    }

    .pod-segment {
      padding: 0 0 80px;
    }

    .pod-segment__grid {
      grid-template-columns: 1fr;
      max-width: 420px;
    }

    .pod-segment__card {
      padding: 40px 28px;
    }

    .pod-hosts__grid {
      grid-template-columns: 1fr;
      max-width: 420px;
    }
  }
</style>
