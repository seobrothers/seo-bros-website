---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import EarlyAccessForm from "../../components/EarlyAccessForm.astro";

// Early access to Websites inside Tideworthy. The questionnaire on the right
// is rendered from the platform's public form definition and posts back to it;
// the email joins the early-access list once the confirmation is clicked.

const gets = [
  {
    title: "Fully managed and agentic",
    body: "SEO Brothers builds and manages the site through the platform, the way your SEO campaigns already run.",
  },
  {
    title: "Or self serve for your team",
    body: "Your team, or your clients, make the changes themselves.",
  },
  {
    title: "The same approvals and reporting",
    body: "Website work shows up in the queue and the reports your clients already see, under your brand.",
  },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Websites", item: new URL("/white-label-web-design/", Astro.site).href },
    { "@type": "ListItem", position: 3, name: "Early Access", item: new URL("/white-label-web-design/early-access/", Astro.site).href },
  ],
};
---

<Layout
  title="Get Early Access | Self Serve Website Build | SEO Brothers"
  description="Early access to Websites inside Tideworthy: client sites built and managed through the platform, fully managed or self serve, with the same approvals and reporting as your SEO campaigns."
  schema={[breadcrumbSchema]}
>
  <Nav variant="light" hideCta={true} />

  <section class="ea">
    <div class="ea__bg" aria-hidden="true">
      <div class="ea__orb ea__orb--1"></div>
      <div class="ea__orb ea__orb--2"></div>
    </div>
    <div class="container ea__inner">
      <div class="ea__copy" data-animate>
        <span class="ea__label">
          <span class="ea__label-dot"></span>
          Early Access
        </span>
        <h1 class="ea__title">
          Agentic Self Serve
          <span class="ea__title-gradient">Website Build</span>
        </h1>
        <p class="ea__lede">
          We build and host websites for agencies today. What comes next lives
          inside Tideworthy, and the first agencies in help shape it.
        </p>
        <ul class="ea__list">
          {
            gets.map((item) => (
              <li class="ea__item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <div>
                  <strong>{item.title}</strong>
                  <p>{item.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="ea__more">
          Need a site built for a client now? <a href="/white-label-web-design/">Our team builds it</a>, or
          <a href="/book-a-growth-call/">book a call</a>.
        </p>
      </div>
      <div class="ea__form" data-animate>
        <EarlyAccessForm />
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .ea {
    position: relative;
    padding: 150px 0 110px;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    overflow: hidden;
  }
  .ea__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .ea__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.22;
  }
  .ea__orb--1 {
    width: 460px;
    height: 460px;
    top: -120px;
    left: -140px;
    background: var(--teal);
  }
  .ea__orb--2 {
    width: 420px;
    height: 420px;
    bottom: -160px;
    right: -120px;
    background: var(--green);
  }
  .ea__inner {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 56px;
    align-items: start;
  }
  .ea__copy {
    padding-top: 8px;
  }
  .ea__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background: rgba(40, 165, 177, 0.1);
    color: var(--teal-dark);
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .ea__label-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--teal);
  }
  .ea__title {
    font-family: var(--font-display);
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 18px 0 18px;
  }
  .ea__title-gradient {
    display: block;
    background: linear-gradient(135deg, var(--teal) 0%, var(--teal-dark) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ea__lede {
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 28px;
  }
  .ea__list {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .ea__item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .ea__item svg {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--green);
  }
  .ea__item strong {
    display: block;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
  }
  .ea__item p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
  }
  .ea__more {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .ea__more a {
    color: var(--teal-dark);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 900px) {
    .ea {
      padding: 120px 0 80px;
    }
    .ea__inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
