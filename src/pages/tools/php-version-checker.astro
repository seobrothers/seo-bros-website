---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { PHP_BRANCHES, WORDPRESS_MIN_PHP } from "../../data/php-versions";

// Free PHP version checker, built to rank for "php version checker" and the
// WordPress-flavoured cluster around it ("check php version of website",
// "wordpress check php version", "wordpress recommended php version").
//
// Three parts on one page:
//   1. The checker. Calls /api/php-version, which fetches the site from the
//      edge and reports the PHP version if the server exposes it in a header.
//      Most hosts hide it (correctly), so the "not exposed" state is a first
//      class result, not an error, and it routes WordPress owners to Site
//      Health instead of leaving them stuck.
//   2. The end-of-life lookup. Pick a branch, see its support status and
//      dates. Status is computed in the browser from today's date and the
//      table in src/data/php-versions.ts, so it stays right without a rebuild.
//   3. How to find the version yourself, and what to do if it is end of life.
//
// The sales angle is light: the sites we build are static Astro on Cloudflare,
// so they have no PHP version to check. One strip, one link. No lead gate.

const faqs = [
  {
    question: "How does this PHP version checker work?",
    answer:
      "We fetch the page you enter from our server and read the response headers. Some servers announce their PHP version in an X-Powered-By or Server header, like PHP/8.3.8. If it is there, we show the version, which release branch it belongs to, and whether that branch is still supported. We also note whether the site runs WordPress and what server or CDN sits in front of it.",
  },
  {
    question: "Why does it say the PHP version is not exposed?",
    answer:
      "Because the server did not include it in any header, which is how most hosts are configured. Hiding the version is good security practice: it gives attackers one less thing to target. There is no reliable way to read a server's PHP version from outside once the header is off, so we say so instead of guessing. If it is your own site, the Site Health screen in WordPress or your hosting panel will tell you in seconds.",
  },
  {
    question: "How do I check the PHP version of my WordPress site?",
    answer:
      "Log in to WordPress and go to Tools, then Site Health, then the Info tab. Expand the Server section and you will see the PHP version. Your hosting control panel shows it too, usually under a PHP Manager, MultiPHP, or PHP Settings page, and that is also where you change it.",
  },
  {
    question: "Which PHP version should WordPress be on?",
    answer:
      "A branch that still gets security fixes. WordPress 7.0 requires PHP " + WORDPRESS_MIN_PHP + " or newer and is tested through PHP 8.5, but 7.4, 8.0 and 8.1 are past end of life and are only kept for backward compatibility. For most sites PHP 8.3 or 8.4 is the safe target: both are supported for years, and plugin compatibility is broad. Test on a staging copy first, because a plugin that is years out of date can break on a newer PHP.",
  },
  {
    question: "What does end of life mean for PHP?",
    answer:
      "PHP releases get two years of active support, then two years of security fixes only, then nothing. End of life means a newly discovered security hole in that version will never be patched. Your site keeps running, but every month on an end-of-life version is a month exposed. Hosts respond by pushing sites to a newer version on a deadline, sometimes without much warning, which is where the broken sites come from.",
  },
  {
    question: "Why can't you see the PHP version if the site uses Cloudflare?",
    answer:
      "Cloudflare sits between us and the origin server, and it rewrites the Server header to say cloudflare. If the origin sends an X-Powered-By header it usually passes through, so a version can still show up. When it doesn't, the origin has it switched off.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "PHP Version Checker",
  url: "https://seobrothers.com/tools/php-version-checker/",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description:
    "Check what PHP version a website exposes, whether that version is still supported, and when it reaches end of life. Built for WordPress owners and agencies.",
  publisher: { "@type": "Organization", name: "SEO Brothers", url: "https://seobrothers.com/" },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Tools", item: new URL("/tools/", Astro.site).href },
    { "@type": "ListItem", position: 3, name: "PHP Version Checker", item: new URL("/tools/php-version-checker/", Astro.site).href },
  ],
};

const fmt = (iso: string) =>
  new Date(iso + "T12:00:00Z").toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
---

<Layout
  title="PHP Version Checker | Check a Website's PHP Version & End of Life | SEO Brothers"
  description="Free PHP version checker. Enter a website to see the PHP version it exposes, whether that version still gets security fixes, and its end-of-life date. Includes how to check your WordPress site's PHP version and what to upgrade to."
  schema={[breadcrumbSchema, appSchema, faqSchema]}
>
  <Nav variant="light" />

  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="pvc-hero">
    <div class="container pvc-hero__inner">
      <span class="pvc-hero__label">
        <span class="pvc-hero__label-dot"></span>
        Free tool
      </span>
      <h1 class="pvc-hero__title">PHP version checker</h1>
      <p class="pvc-hero__subtitle">
        Enter a website to see the PHP version its server exposes, whether that
        version still gets security fixes, and when it reaches end of life.
        Built for WordPress owners and the agencies looking after them. Free, no signup.
      </p>
    </div>
  </section>

  <!-- ═══════════════ CHECKER ═══════════════ -->
  <section class="pvc-check">
    <div class="container pvc-check__inner">
      <form class="pvc-form" id="pvc-form" novalidate>
        <label class="pvc-form__label" for="pvc-url">Website address</label>
        <div class="pvc-form__row">
          <input
            type="text"
            id="pvc-url"
            name="url"
            inputmode="url"
            autocomplete="url"
            spellcheck="false"
            placeholder="example.com"
            required
          />
          <button type="submit" class="btn btn-primary" id="pvc-submit">Check PHP version</button>
        </div>
        <p class="pvc-form__hint">
          We read the site's response headers from our server. Nothing is installed and nothing is stored beyond a one-hour cache.
        </p>
      </form>

      <div class="pvc-result" id="pvc-result" hidden aria-live="polite"></div>
    </div>
  </section>

  <!-- ═══════════════ EOL LOOKUP ═══════════════ -->
  <section class="pvc-eol" id="eol">
    <div class="container pvc-eol__inner">
      <div class="pvc-eol__head">
        <h2 class="pvc-eol__title">Is your PHP version still supported?</h2>
        <p class="pvc-eol__lede">
          Already know your version? Pick the branch to see where it stands.
          PHP gives each branch two years of active support, then two years of
          security fixes, then nothing.
        </p>
      </div>

      <div class="pvc-lookup">
        <label for="pvc-branch">PHP version</label>
        <select id="pvc-branch">
          {PHP_BRANCHES.map((b, i) => (
            <option value={b.branch} selected={i === 3}>PHP {b.branch}</option>
          ))}
        </select>
        <div class="pvc-lookup__card" id="pvc-lookup-card"></div>
      </div>

      <div class="pvc-table-wrap">
        <table class="pvc-table">
          <thead>
            <tr>
              <th>Branch</th>
              <th>Released</th>
              <th>Active support until</th>
              <th>Security fixes until</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {PHP_BRANCHES.map((b) => (
              <tr data-branch={b.branch}>
                <td><strong>PHP {b.branch}</strong></td>
                <td>{fmt(b.released)}</td>
                <td>{fmt(b.activeUntil)}</td>
                <td>{fmt(b.securityUntil)}</td>
                <td class="pvc-table__status" data-status-cell>See dates</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="pvc-table__note">
          Dates from php.net. WordPress 7.0 needs PHP {WORDPRESS_MIN_PHP} or newer
          and is tested up to PHP {PHP_BRANCHES[0].branch}.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════ HOW TO FIND IT ═══════════════ -->
  <section class="pvc-how">
    <div class="container pvc-how__inner">
      <h2 class="pvc-how__title">How to check your own site's PHP version</h2>
      <p>
        If the checker above says the version is not exposed, that's normal.
        Hosts hide it on purpose. For a site you control, any of these gets you
        the answer in under a minute.
      </p>

      <div class="pvc-steps">
        <div class="pvc-step">
          <h3>WordPress Site Health</h3>
          <p>
            In the WordPress admin go to <strong>Tools, then Site Health</strong>,
            open the <strong>Info</strong> tab and expand <strong>Server</strong>.
            The PHP version is listed there, along with the memory limit and
            upload limits that usually matter at the same time.
          </p>
        </div>
        <div class="pvc-step">
          <h3>Your hosting control panel</h3>
          <p>
            cPanel calls it <strong>MultiPHP Manager</strong> or
            <strong>Select PHP Version</strong>. Plesk has <strong>PHP Settings</strong>
            under each domain. Managed WordPress hosts like Kinsta, WP Engine,
            SiteGround and Cloudways show it on the site's overview page. This is
            also where you change it.
          </p>
        </div>
        <div class="pvc-step">
          <h3>Command line</h3>
          <p>
            With SSH access, <code>php -v</code> prints the version the command
            line uses, and <code>wp cli info</code> prints the one WordPress
            sees. They can differ on servers with more than one PHP installed,
            so trust the WordPress one.
          </p>
        </div>
        <div class="pvc-step">
          <h3>A phpinfo file (last resort)</h3>
          <p>
            Create a file called <code>info.php</code> containing
            <code>{"<?php phpinfo(); ?>"}</code>, upload it to your site's root,
            and open it in a browser. <strong>Delete it as soon as you've read it.</strong>
            It publishes your server's configuration to anyone who finds it.
          </p>
        </div>
      </div>

      <h2 class="pvc-how__title pvc-how__title--mid">On an end-of-life version? What to do</h2>
      <p>
        Pick a target branch with years of support left. PHP 8.3 and 8.4 are the
        sensible choices for WordPress today: wide plugin support, no surprises.
        Skipping straight to the newest branch is fine for a well-maintained site
        but is where old plugins tend to fail.
      </p>
      <p>
        Update WordPress core, your theme and every plugin first, then switch
        the PHP version on a staging copy and click through the site, especially
        checkout, forms and anything a page builder touches. Most hosts let you
        switch back with one click if something breaks. Only then change it on
        the live site.
      </p>
      <p>
        Hosts are forcing this now. PHP 8.1 lost security support at the end of
        2025 and 8.2 follows at the end of 2026, and the large WordPress hosts
        have been moving sites on a deadline. A planned upgrade beats a forced one.
      </p>
    </div>
  </section>

  <!-- ═══════════════ ASTRO STRIP ═══════════════ -->
  <section class="pvc-astro">
    <div class="container">
      <div class="pvc-astro__box">
        <div class="pvc-astro__copy">
          <strong>Our sites don't have a PHP version.</strong>
          The websites we build for agencies are Astro, published as static HTML
          to Cloudflare's edge. No PHP, no plugins to patch, no database in front
          of every visitor, and no upgrade deadline from a host. This site runs the same way.
        </div>
        <a href="/white-label-web-design/" class="btn btn-primary">See how we build websites</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════ FAQ ═══════════════ -->
  <section class="pvc-faq">
    <div class="container pvc-faq__inner">
      <h2 class="pvc-faq__title">PHP version checker FAQ</h2>
      {faqs.map((faq, i) => (
        <details class="pvc-faq__item" open={i === 0}>
          <summary class="pvc-faq__q">
            <span>{faq.question}</span>
            <svg class="pvc-faq__chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
          </summary>
          <div class="pvc-faq__a"><p>{faq.answer}</p></div>
        </details>
      ))}
    </div>
  </section>

  <CtaBanner variant="partner" />
  <Footer />
</Layout>

<script type="application/json" id="pvc-branches" set:html={JSON.stringify({ branches: PHP_BRANCHES, wpMin: WORDPRESS_MIN_PHP })} />

<script>
  type Branch = { branch: string; released: string; activeUntil: string; securityUntil: string };
  type Status = "active" | "security" | "eol" | "unknown";

  const data = JSON.parse(document.getElementById("pvc-branches")!.textContent || "{}") as {
    branches: Branch[];
    wpMin: string;
  };
  const branches = data.branches;
  const DAY = 86_400_000;

  const endOf = (iso: string) => new Date(iso + "T23:59:59Z").getTime();
  const fmtDate = (iso: string) =>
    new Date(iso + "T12:00:00Z").toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });

  function statusOf(branch: string): Status {
    const row = branches.find((b) => b.branch === branch);
    if (!row) return "unknown";
    const now = Date.now();
    if (now <= endOf(row.activeUntil)) return "active";
    if (now <= endOf(row.securityUntil)) return "security";
    return "eol";
  }

  const LABEL: Record<Status, string> = {
    active: "Active support",
    security: "Security fixes only",
    eol: "End of life",
    unknown: "Unknown",
  };

  function daysUntil(iso: string): number {
    return Math.ceil((endOf(iso) - Date.now()) / DAY);
  }

  function cmpBranch(a: string, b: string): number {
    const [a1, a2] = a.split(".").map(Number);
    const [b1, b2] = b.split(".").map(Number);
    return a1 !== b1 ? a1 - b1 : a2 - b2;
  }

  function esc(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] as string);
  }

  // What a given branch means for the reader. Shared by the checker result
  // and the lookup card.
  function verdict(branch: string): string {
    const row = branches.find((b) => b.branch === branch);
    if (!row) {
      return `We don't have support dates for PHP ${esc(branch)}. If it is newer than PHP ${branches[0].branch}, it is likely a very recent release.`;
    }
    const st = statusOf(branch);
    const belowWp = cmpBranch(branch, data.wpMin) < 0;
    const wpLine = belowWp
      ? ` It is also below WordPress 7.0's minimum of PHP ${data.wpMin}, so current WordPress will not run on it.`
      : "";
    if (st === "active") {
      return `PHP ${branch} is in active support. Bugs and security issues are fixed in regular releases until ${fmtDate(row.activeUntil)}, then security fixes continue until ${fmtDate(row.securityUntil)}. Nothing to do.`;
    }
    if (st === "security") {
      const d = daysUntil(row.securityUntil);
      const when = d > 60 ? `in about ${Math.round(d / 30)} months` : `in ${d} days`;
      return `PHP ${branch} only gets security fixes now, and those stop on ${fmtDate(row.securityUntil)}, ${when}. Plan the move to a newer branch before then.${wpLine}`;
    }
    const since = Math.floor(-daysUntil(row.securityUntil) / 30);
    const ago = since >= 12 ? `${Math.floor(since / 12)} year${since >= 24 ? "s" : ""}` : `${since} month${since === 1 ? "" : "s"}`;
    return `PHP ${branch} reached end of life on ${fmtDate(row.securityUntil)}, about ${ago} ago. New security holes in it will never be patched. Upgrade as soon as you can.${wpLine}`;
  }

  function chip(st: Status): string {
    return `<span class="pvc-chip pvc-chip--${st}">${LABEL[st]}</span>`;
  }

  // Lookup card + table status cells.
  const select = document.getElementById("pvc-branch") as HTMLSelectElement;
  const card = document.getElementById("pvc-lookup-card")!;
  function renderLookup() {
    const b = select.value;
    card.innerHTML = `<div class="pvc-lookup__top"><span class="pvc-lookup__ver">PHP ${esc(b)}</span>${chip(statusOf(b))}</div><p>${verdict(b)}</p>`;
  }
  select.addEventListener("change", renderLookup);
  renderLookup();

  document.querySelectorAll<HTMLTableRowElement>("tr[data-branch]").forEach((tr) => {
    const st = statusOf(tr.dataset.branch!);
    tr.querySelector("[data-status-cell]")!.innerHTML = chip(st);
    tr.classList.add(`pvc-row--${st}`);
  });

  // Checker.
  const form = document.getElementById("pvc-form") as HTMLFormElement;
  const input = document.getElementById("pvc-url") as HTMLInputElement;
  const submit = document.getElementById("pvc-submit") as HTMLButtonElement;
  const result = document.getElementById("pvc-result")!;

  type CheckResult = {
    ok: true;
    url: string;
    finalUrl: string;
    httpStatus: number;
    php: { version: string; branch: string | null; status: Status; source: string } | null;
    wordpress: { detected: boolean; version: string | null };
    server: string | null;
    poweredBy: string | null;
    platform: string[];
  };

  function show(html: string) {
    result.innerHTML = html;
    result.hidden = false;
  }

  function renderResult(r: CheckResult) {
    const host = (() => {
      try {
        return new URL(r.finalUrl).hostname;
      } catch {
        return r.url;
      }
    })();

    let main: string;
    if (r.php) {
      const st = r.php.branch ? statusOf(r.php.branch) : "unknown";
      main = `
        <div class="pvc-main pvc-main--${st}">
          <div class="pvc-main__top">
            <span class="pvc-main__ver">PHP ${esc(r.php.version)}</span>
            ${chip(st)}
          </div>
          <p>${r.php.branch ? verdict(r.php.branch) : `We couldn't place ${esc(r.php.version)} in a known branch.`}</p>
          <p class="pvc-main__src">Found in the <code>${esc(r.php.source)}</code> header. Exposing the version this way is optional and most hosts switch it off, so consider hiding it.</p>
        </div>`;
    } else {
      const wpHelp = r.wordpress.detected
        ? ` This is a WordPress site, so if it's yours, open <strong>Tools, then Site Health, then Info</strong> and expand Server. The version is listed there.`
        : ` If it's your site, your hosting control panel will show the version, and <a href="#eol">the table below</a> tells you whether it is still supported.`;
      main = `
        <div class="pvc-main pvc-main--hidden">
          <div class="pvc-main__top">
            <span class="pvc-main__ver pvc-main__ver--muted">Not exposed</span>
            <span class="pvc-chip pvc-chip--neutral">Good practice</span>
          </div>
          <p>${esc(host)} does not announce its PHP version in any header, which is how most servers are configured and the right call for security. It may not run PHP at all.${wpHelp}</p>
        </div>`;
    }

    const facts: string[] = [];
    if (r.wordpress.detected) {
      facts.push(`<div class="pvc-fact"><span>CMS</span><strong>WordPress${r.wordpress.version ? " " + esc(r.wordpress.version) : ""}</strong></div>`);
    }
    if (r.platform.length) {
      facts.push(`<div class="pvc-fact"><span>Platform</span><strong>${r.platform.map(esc).join(", ")}</strong></div>`);
    }
    if (r.server) facts.push(`<div class="pvc-fact"><span>Server header</span><strong>${esc(r.server)}</strong></div>`);
    if (r.poweredBy) facts.push(`<div class="pvc-fact"><span>X-Powered-By</span><strong>${esc(r.poweredBy)}</strong></div>`);
    facts.push(`<div class="pvc-fact"><span>Response</span><strong>HTTP ${r.httpStatus}</strong></div>`);

    show(`
      <div class="pvc-result__head">Results for <strong>${esc(host)}</strong></div>
      ${main}
      <div class="pvc-facts">${facts.join("")}</div>
    `);
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const raw = input.value.trim();
    if (!raw) {
      input.focus();
      return;
    }
    submit.disabled = true;
    submit.textContent = "Checking…";
    show(`<p class="pvc-result__loading">Fetching ${esc(raw)}…</p>`);
    try {
      const res = await fetch(`/api/php-version/?url=${encodeURIComponent(raw)}`);
      const body = (await res.json()) as CheckResult | { ok: false; error: string };
      if (!res.ok || !body.ok) {
        show(`<p class="pvc-result__error">${esc((body as { error?: string }).error || "Something went wrong. Please try again.")}</p>`);
      } else {
        renderResult(body);
      }
    } catch {
      show(`<p class="pvc-result__error">We couldn't complete the check. Please try again in a moment.</p>`);
    } finally {
      submit.disabled = false;
      submit.textContent = "Check PHP version";
    }
  });

  // Deep link: /tools/php-version-checker/?url=example.com runs immediately.
  const preset = new URLSearchParams(location.search).get("url");
  if (preset) {
    input.value = preset;
    form.requestSubmit();
  }
</script>

<style>
  /* HERO */
  .pvc-hero { padding: 150px 0 40px; background: linear-gradient(180deg, var(--light) 0%, var(--white) 100%); }
  .pvc-hero__inner { max-width: 720px; }
  .pvc-hero__label {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--teal-dark); margin-bottom: 18px;
  }
  .pvc-hero__label-dot { width: 8px; height: 8px; background: var(--green); border-radius: 50%; box-shadow: 0 0 0 4px rgba(68,185,123,0.18); }
  .pvc-hero__title { font-family: var(--font-display); font-size: clamp(34px, 5vw, 50px); font-weight: 700; letter-spacing: -0.03em; color: var(--text-primary); margin-bottom: 16px; }
  .pvc-hero__subtitle { font-size: clamp(16px, 1.8vw, 19px); line-height: 1.7; color: var(--text-secondary); }

  /* CHECKER */
  .pvc-check { padding: 16px 0 72px; background: var(--white); }
  .pvc-check__inner { max-width: 760px; }
  .pvc-form { padding: 28px; border-radius: var(--radius-xl); background: var(--light); border: 1px solid var(--border-light); }
  .pvc-form__label { display: block; font-family: var(--font-display); font-size: 14px; font-weight: 600; color: var(--text-primary); margin-bottom: 10px; }
  .pvc-form__row { display: flex; gap: 12px; }
  .pvc-form__row input {
    flex: 1 1 auto; min-width: 0;
    font-family: var(--font-body); font-size: 16px; padding: 12px 14px;
    border: 2px solid var(--border-light); border-radius: var(--radius-md);
    color: var(--text-primary); background: var(--white); outline: none;
    transition: border-color var(--transition);
  }
  .pvc-form__row input:focus { border-color: var(--teal); }
  .pvc-form__row .btn { flex-shrink: 0; white-space: nowrap; }
  .pvc-form__hint { margin-top: 12px; font-size: 12.5px; line-height: 1.5; color: var(--text-muted); }

  .pvc-result { margin-top: 20px; padding: 28px; border-radius: var(--radius-xl); border: 1px solid var(--border-light); background: var(--white); box-shadow: var(--shadow-md); }




  /* EOL LOOKUP */
  .pvc-eol { padding: 72px 0; background: var(--light); }
  .pvc-eol__inner { max-width: 860px; }
  .pvc-eol__head { max-width: 720px; margin-bottom: 28px; }
