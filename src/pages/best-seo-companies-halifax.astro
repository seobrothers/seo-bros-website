---
// MOCKUP / CONCEPT PAGE for the "recommended SEO companies in [city]" play.
// Halifax used as the template city. Agency entries below are ILLUSTRATIVE
// placeholders to show the format and scoring; real data + an editorial/legal
// pass are required before anything like this ships. Isolated on its own branch.
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const signals = [
  { key: "visibility", label: "Search visibility", blurb: "Do they rank and show in the map pack for their own city terms? An SEO firm that can't rank itself is the first red flag." },
  { key: "authority", label: "Authority", blurb: "Domain Rating and backlink profile (Ahrefs). Real off-site strength, not just claims." },
  { key: "reputation", label: "Reputation", blurb: "Google review count and rating. The clearest public client signal." },
  { key: "track", label: "Track record", blurb: "Years active and named, verifiable case studies or results." },
  { key: "transparency", label: "Transparency", blurb: "Published pricing or process, a named team, clear contact. Trust signals a buyer can check." },
];

// Each signal scored 0-20, total /100. Illustrative only.
const agencies = [
  { name: "Harbour Search Co.", grade: "A-", score: 88, scores: [18, 16, 19, 17, 18], verdict: "Strong local rankings, 120+ Google reviews at 4.9, and clear published pricing. Thinner on named case studies than the score suggests it could be." },
  { name: "Citadel Digital", grade: "B+", score: 84, scores: [17, 16, 17, 16, 18], verdict: "Healthy backlink profile and a transparent team page. Map-pack visibility is good but not dominant in the core terms." },
  { name: "Bluenose SEO", grade: "B", score: 80, scores: [16, 14, 18, 16, 16], verdict: "Excellent reviews and a long track record. Authority is mid-tier; would benefit from stronger links." },
  { name: "Maritime Rank", grade: "C+", score: 72, scores: [14, 13, 15, 15, 15], verdict: "Solid, steady local shop. No glaring weakness, no standout strength. A safe, mid-market choice." },
  { name: "Anchor Media Group", grade: "C", score: 66, scores: [13, 12, 14, 14, 13], verdict: "Generalist marketing agency where SEO is one line item. Capable, but search isn't the core focus." },
];

const gradeColor = (g: string) =>
  g.startsWith("A") ? "#44b97b" : g.startsWith("B") ? "#28a5b1" : "#d08700";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Best SEO Companies in Halifax", item: new URL("/best-seo-companies-halifax/", Astro.site).href },
  ],
};
---

<Layout
  title="Best SEO Companies in Halifax, Graded | SEO Brothers"
  description="A transparent, data-driven scorecard of SEO companies in Halifax, graded on visibility, authority, reputation, track record, and transparency. From the white-label SEO team that works with agencies across Canada and the US."
  schema={[breadcrumbSchema]}
  noindex={true}
>
  <Nav />

  <!-- MOCKUP banner -->
  <div style="background: #fff7ed; border-bottom: 1px solid #f6c98a; color: #9a5b00; text-align: center; font-size: 13px; font-weight: 600; padding: 8px 16px;">
    Concept mockup — agency names and scores below are illustrative placeholders, not real ratings.
  </div>

  <!-- ===== HERO ===== -->
  <section class="sc-hero">
    <div class="sc-hero-bg"><div class="sc-hero-orb"></div><div class="sc-hero-grid"></div></div>
    <div class="container sc-hero-inner">
      <span class="sc-eyebrow" data-animate><span class="sc-eyebrow-dot"></span>Halifax · Local SEO Scorecard</span>
      <h1 class="sc-title" data-animate>The Best SEO Companies in Halifax</h1>
      <p class="sc-sub" data-animate>
        We're a white-label SEO team that works behind agencies across Canada and the US,
        so we don't compete for Halifax clients ourselves. That lets us grade the local
        field honestly, on signals you can verify, instead of selling you our own services.
      </p>
    </div>
  </section>

  <!-- ===== METHODOLOGY ===== -->
  <section class="sc-method">
    <div class="container">
      <div class="sc-method-head" data-animate>
        <span class="section-label">How we grade</span>
        <h2 class="section-heading">Five signals, scored out of 100</h2>
        <p class="section-subtext" style="margin: 0 auto;">
          Every company is scored 0&ndash;20 on each signal below from public data.
          No company pays to be listed or to rank higher. We make our money from
          white-label partnerships, not placements.
        </p>
      </div>
      <div class="sc-signals" data-stagger>
        {signals.map((s, i) => (
          <div class="sc-signal" data-animate>
            <span class="sc-signal-num">{i + 1}</span>
            <div>
              <h3 class="sc-signal-label">{s.label}<span class="sc-signal-max"> / 20</span></h3>
              <p class="sc-signal-blurb">{s.blurb}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== SCORECARD ===== -->
  <section class="sc-board">
    <div class="container">
      <h2 class="section-heading" style="text-align: center; margin-bottom: 8px;">The scorecard</h2>
      <p class="section-subtext" style="margin: 0 auto 40px; text-align: center;">Ranked by total score. Hover a signal for its breakdown.</p>
      <div class="sc-cards">
        {agencies.map((a, i) => (
          <article class="sc-card" data-animate>
            <div class="sc-card-rank">#{i + 1}</div>
            <div class="sc-card-grade" style={`background: ${gradeColor(a.grade)};`}>{a.grade}</div>
            <div class="sc-card-main">
              <h3 class="sc-card-name">{a.name}</h3>
              <div class="sc-card-signals">
                {signals.map((s, j) => (
                  <span class="sc-chip" title={s.label}>
                    <span class="sc-chip-label">{s.label.split(" ")[0]}</span>
                    <span class="sc-chip-val">{a.scores[j]}</span>
                  </span>
                ))}
              </div>
              <p class="sc-card-verdict">{a.verdict}</p>
            </div>
            <div class="sc-card-score"><span class="sc-card-score-num">{a.score}</span><span class="sc-card-score-max">/100</span></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="sc-cta">
    <div class="container sc-cta-grid">
      <div class="sc-cta-card" data-animate>
        <h3 class="sc-cta-title">Choosing an SEO company?</h3>
        <p class="sc-cta-text">Use the five signals above to vet any agency, in Halifax or anywhere. Ranking, authority, reviews, proof, and transparency tell you more than a sales call will.</p>
        <a href="/guides/halifax-seo/" class="sc-cta-link">Read the Halifax SEO guide →</a>
      </div>
      <div class="sc-cta-card sc-cta-card--accent" data-animate>
        <h3 class="sc-cta-title">Run an agency in Halifax?</h3>
        <p class="sc-cta-text">Think your score should be higher, or want the SEO behind your brand handled by a team that does this all day? That's exactly what we do, white-label, under your name.</p>
        <a href="/partner-package/" class="sc-cta-btn">Partner with us</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .sc-hero { position: relative; background: var(--dark); overflow: hidden; padding: 120px 0 72px; }
  .sc-hero-bg { position: absolute; inset: 0; overflow: hidden; }
  .sc-hero-orb { position: absolute; width: 540px; height: 540px; border-radius: 50%; background: var(--teal); filter: blur(130px); opacity: 0.22; top: -20%; right: -8%; }
  .sc-hero-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse at 50% 35%, black 28%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse at 50% 35%, black 28%, transparent 75%); }
  .sc-hero-inner { position: relative; z-index: 1; max-width: 760px; }
  .sc-eyebrow { display: inline-flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--teal-light); margin-bottom: 22px; }
  .sc-eyebrow-dot { width: 8px; height: 8px; background: var(--green); border-radius: 50%; box-shadow: 0 0 0 4px rgba(68,185,123,0.18); }
  .sc-title { font-family: var(--font-display); font-size: clamp(34px, 5.2vw, 56px); font-weight: 700; line-height: 1.08; letter-spacing: -0.03em; color: var(--text-on-dark); margin-bottom: 20px; }
  .sc-sub { font-size: clamp(16px, 1.9vw, 19px); line-height: 1.7; color: var(--text-on-dark-muted); max-width: 620px; }

  .sc-method { padding: 84px 0 64px; background: var(--white); }
  .sc-method-head { text-align: center; max-width: 660px; margin: 0 auto 48px; }
  .sc-method-head .section-label, .sc-method-head .section-heading { display: block; }
  .sc-signals { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; max-width: 980px; margin: 0 auto; }
  .sc-signal { display: flex; gap: 16px; align-items: flex-start; background: var(--light); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 22px 24px; }
  .sc-signal-num { flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%; background: var(--white); border: 1.5px solid var(--teal); color: var(--teal); font-weight: 700; font-size: 14px; display: flex; align-items: center; justify-content: center; }
  .sc-signal-label { font-family: var(--font-display); font-size: 16px; font-weight: 600; color: var(--text-primary); margin: 2px 0 6px; }
  .sc-signal-max { color: var(--text-muted); font-weight: 500; }
  .sc-signal-blurb { font-size: 14px; line-height: 1.6; color: var(--text-secondary); }

  .sc-board { padding: 64px 0 88px; background: var(--light); }
  .sc-cards { display: flex; flex-direction: column; gap: 16px; max-width: 920px; margin: 0 auto; }
  .sc-card { display: flex; align-items: center; gap: 20px; background: var(--white); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 22px 24px; box-shadow: var(--shadow-sm); }
  .sc-card-rank { flex-shrink: 0; font-family: var(--font-display); font-size: 15px; font-weight: 700; color: var(--text-muted); width: 28px; }
  .sc-card-grade { flex-shrink: 0; width: 52px; height: 52px; border-radius: 12px; color: #fff; font-family: var(--font-display); font-size: 20px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
  .sc-card-main { flex: 1; min-width: 0; }
  .sc-card-name { font-family: var(--font-display); font-size: 18px; font-weight: 700; color: var(--text-primary); margin-bottom: 10px; }
  .sc-card-signals { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .sc-chip { display: inline-flex; align-items: center; gap: 6px; background: var(--light); border: 1px solid var(--border-light); border-radius: var(--radius-full); padding: 4px 11px; font-size: 12px; }
  .sc-chip-label { color: var(--text-muted); }
  .sc-chip-val { font-weight: 700; color: var(--teal-dark); }
  .sc-card-verdict { font-size: 14px; line-height: 1.6; color: var(--text-secondary); }
  .sc-card-score { flex-shrink: 0; text-align: right; }
  .sc-card-score-num { font-family: var(--font-display); font-size: 30px; font-weight: 700; color: var(--text-primary); }
  .sc-card-score-max { font-size: 13px; color: var(--text-muted); }

  .sc-cta { padding: 0 0 100px; background: var(--light); }
  .sc-cta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; max-width: 920px; margin: 0 auto; }
  .sc-cta-card { background: var(--white); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 36px 32px; }
  .sc-cta-card--accent { background: linear-gradient(135deg, var(--dark-800, #131a2b) 0%, var(--dark) 100%); border-color: rgba(255,255,255,0.06); }
  .sc-cta-title { font-family: var(--font-display); font-size: 22px; font-weight: 700; margin-bottom: 12px; color: var(--text-primary); }
  .sc-cta-card--accent .sc-cta-title { color: var(--text-on-dark); }
  .sc-cta-text { font-size: 15px; line-height: 1.65; color: var(--text-secondary); margin-bottom: 20px; }
  .sc-cta-card--accent .sc-cta-text { color: var(--text-on-dark-muted); }
  .sc-cta-link { font-family: var(--font-display); font-weight: 600; font-size: 15px; color: var(--teal-dark); }
  .sc-cta-btn { display: inline-flex; align-items: center; padding: 13px 26px; border-radius: var(--radius-md); background: var(--teal); color: #fff; font-weight: 600; font-size: 15px; }
  .sc-cta-btn:hover { background: var(--teal-light); }

  @media (max-width: 720px) {
    .sc-card { flex-wrap: wrap; gap: 14px; }
    .sc-card-main { flex-basis: 100%; order: 3; }
    .sc-card-score { margin-left: auto; }
    .sc-cta-grid { grid-template-columns: 1fr; }
  }
</style>
