---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import GrowthCallEmbed from "../components/GrowthCallEmbed.astro";
import StickyCta from "../components/StickyCta.astro";
import { SEO_TIERS, usd } from "../data/pricing";

const deliverables = [
  {
    icon: "target",
    accent: "teal",
    title: "Campaign strategy",
    description:
      "We build the strategy with you, keyed to the client's market and the intents that actually move leads. You stay in the conversation; we do the thinking and the work.",
  },
  {
    icon: "edit",
    accent: "green",
    title: "Content & on-page",
    description:
      "Recurring content and on-page work that targets the terms worth winning, written to rank and to read like the client's own brand.",
  },
  {
    icon: "link",
    accent: "teal",
    title: "Link building",
    description:
      "Links built to move rankings, not to pad a report, and never resold PBNs.",
    href: "/guides/link-building/",
    linkLabel: "How we build links",
  },
  {
    icon: "map",
    accent: "green",
    title: "Local & Google Business Profile",
    description:
      "Map pack, GBP, citations, and service-area pages. Local is what we do best, including multi-location and franchise at scale.",
    href: "/guides/local-seo/",
    linkLabel: "Our local SEO framework",
  },
  {
    icon: "ai",
    accent: "teal",
    title: "AI search (GEO & AEO)",
    description:
      "Yes, we run AI SEO. We earn citations in AI Overviews, ChatGPT, and Perplexity as a layer on the organic foundation, measured by leads, not vanity scores.",
    href: "/white-label-ai-seo/",
    linkLabel: "White-label AI SEO",
  },
  {
    icon: "activity",
    accent: "teal",
    title: "Technical SEO & audits",
    description:
      "Crawl health, Core Web Vitals, schema, and the fixes that let the rest of the work pay off, on whatever platform the client is on.",
  },
  {
    icon: "chart",
    accent: "green",
    title: "Reporting under your brand",
    description:
      "A live portal on your own domain showing the work, the rankings, and the leads. Your client sees your brand, never ours.",
  },
];

const differentiators = [
  {
    title: "We stay invisible",
    description:
      "We don't put our name or face on your client calls, because the moment we do, your client is one search away from learning you subcontract. We back your sales from behind and let you stay the only name in the room.",
  },
  {
    title: "Any budget, proven both ways",
    description:
      "We have onboarded around 100 clients in a single month for one partner and grown it to roughly 400 active campaigns, and we also run $5K and $10K monthly campaigns, including for publicly traded companies. Small or large, we are fluent at both ends.",
  },
  {
    title: "A service built for your niche",
    description:
      "Our bread and butter is sitting with a partner and building them their own productized service: the offer, the deliverables, the pricing, shaped to how you actually sell. We review your whole portfolio, not one campaign in isolation.",
  },
  {
    title: "Transparent and collaborative",
    description:
      "Our partner portal runs on your own domain via CNAME. Real-time updates, feedback, and approvals, plus the ability to send work to your client for sign-off under your brand. Collaboration, not a monthly PDF.",
  },
];

const steps = [
  {
    phase: "Set up once",
    number: "01",
    title: "Discovery & fit",
    description:
      "We learn your agency: your niche, how you sell, and the margin you need. This is about your business, not a single client, and there is no drawn-out sales cycle.",
  },
  {
    phase: "Set up once",
    number: "02",
    title: "We build your productized service",
    description:
      "Up front, we shape one offer around how you sell: the deliverables, reporting, and pricing you put your name on and resell. Built for your agency, not rebuilt for every client.",
  },
  {
    phase: "Set up once",
    number: "03",
    title: "Launch your portal",
    description:
      "We stand up your branded portal on your own domain and onboard your team, so every campaign from here runs through one collaborative, white-label workspace.",
  },
  {
    phase: "Then, every client",
    number: "04",
    title: "Bring clients, we run the campaigns",
    description:
      "For each client you sign, we run strategy, content, links, local, and technical work under your brand. You and your client review and approve in the portal. Repeat as you grow.",
  },
];

const faqs = [
  {
    question: "What is included in your white label SEO services?",
    answer:
      "Full-stack SEO delivered under your brand: campaign strategy, content and on-page, link building, local and Google Business Profile, technical SEO and audits, and white-label reporting. You can resell all of it or just the pieces you need.",
  },
  {
    question: "Is it really white-label? Will my client know?",
    answer:
      "It is genuinely invisible. We don't put our name in reports, we don't email or call your client, and we stay off your sales calls on purpose. The portal, the deliverables, and the reporting all carry your brand. The relationship and the pricing are yours.",
  },
  {
    question: "How is outsourced SEO priced?",
    answer:
      "Wholesale, so you build in real margin. Campaigns run on three packages, Tiny, Typical, and Turbo, with add-ons for extra locations, content, and links. You pay the partner rate and mark it up to your client. The full rate card is on our pricing page.",
  },
  {
    question: "What size clients can you handle?",
    answer:
      "Any size. We have run high-volume programs at hundreds of active campaigns and we also run $5K and $10K monthly campaigns for larger and enterprise clients, including publicly traded companies. We scale the work to the budget either way.",
  },
  {
    question: "Do you work with ecommerce and enterprise clients?",
    answer:
      "Yes. Ecommerce and enterprise or multi-location clients are some of the highest-value accounts an agency can carry, and we handle both, including franchise and multi-location architecture across many sites.",
  },
  {
    question: "Do you handle AI SEO and generative search (GEO/AEO)?",
    answer:
      "Yes. We run AI search as a layer on a real organic foundation, earning citations in AI Overviews, ChatGPT, and Perplexity through the same authority, structure, and entity work that earns rankings, and we measure it by leads from AI sources rather than a vanity visibility score. It ships white-label like everything else. See our white-label AI SEO page for the full picture.",
  },
  {
    question: "How are you different from a fulfilment shop like The HOTH or E2M?",
    answer:
      "Fulfilment shops execute the tasks you order and leave the strategy and selling to you. We run the strategy and execution and build you a productized service around how you sell. Our white label SEO guide breaks down the difference in full.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "White Label SEO Services", item: new URL("/white-label-seo-services/", Astro.site).href },
  ],
};
---

<Layout
  title="White Label SEO Services | Outsourced SEO for Agencies | SEO Brothers"
  description="White label SEO services and outsourced SEO for agencies. We run strategy, content, links, local, and technical SEO under your brand, build you a productized service, and report through a portal on your own domain. Wholesale pricing, free discovery."
  schema={[breadcrumbSchema, faqSchema]}
>
  <Nav />

  <!-- ===== HERO ===== -->
  <section class="wls-hero">
    <div class="wls-hero-bg">
      <div class="wls-hero-orb wls-hero-orb--teal"></div>
      <div class="wls-hero-orb wls-hero-orb--green"></div>
      <div class="wls-hero-orb wls-hero-orb--teal2"></div>
      <div class="wls-hero-grid"></div>
    </div>

    <div class="wls-hero-content container">
      <div class="wls-hero-badge" data-animate>
        <span class="wls-hero-badge-dot"></span>
        White-label & outsourced SEO for agencies
      </div>

      <h1 class="wls-hero-title" data-animate>
        <span class="wls-hero-title-line">White Label SEO Services</span><br />
        <span class="wls-hero-title-gradient">Outsourced, Under Your Brand</span>
      </h1>

      <p class="wls-hero-subtitle" data-animate>
        Outsource your clients' SEO to a team that stays invisible. We run the
        strategy and the work under your brand, build you a productized service
        around how you sell, and report through a portal on your own domain. You
        own the client and set the price. We never show up.
      </p>

      <div class="wls-hero-actions" data-animate>
        <a href="/partner-package/" class="btn btn-primary wls-btn-lg">
          Get Our Partner Package
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a href="/pricing/" class="btn btn-outline wls-btn-lg">See pricing</a>
      </div>

      <div class="wls-hero-pills" data-animate>
        <span class="wls-hero-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Under your brand
        </span>
        <span class="wls-hero-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Any budget
        </span>
        <span class="wls-hero-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Free discovery
        </span>
      </div>
    </div>
  </section>

  <!-- ===== INTRO ===== -->
  <section class="wls-intro">
    <div class="container">
      <div class="wls-intro-content" data-animate>
        <span class="section-label">Outsourced SEO for Agencies</span>
        <h2 class="section-heading">White Label SEO Services You Can Sell Today</h2>
        <p class="wls-intro-text">
          Your clients want SEO, and building an in-house team to deliver it is
          slow and expensive. Outsourcing it to whoever you found last week is a
          gamble. White label SEO solves that: we do the work, you resell it
          under your brand, and your client never knows we exist.
        </p>
        <p class="wls-intro-text">
          We are not a fulfilment desk that runs your brief and disappears. We
          build the strategy with you, shape a productized service around how
          your agency actually sells, and run the campaigns under your name. You
          keep the relationship, the pricing, and the margin. If you want to
          understand the models first, start with our
          <a href="/guides/white-label-seo/">white label SEO guide</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== WHAT YOU GET ===== -->
  <section class="wls-value" id="seo-work">
    <div class="container">
      <div class="wls-value-header" data-animate>
        <span class="section-label">What You're Reselling</span>
        <h2 class="section-heading">Full-Stack SEO, Delivered as Your Team</h2>
        <p class="section-subtext" style="margin:0 auto;">
          Every part of an SEO campaign, run under your brand. Resell the whole
          stack or just the pieces you need.
        </p>
      </div>

      <div class="wls-value-grid" data-stagger>
        {
          deliverables.map((item) => (
            <div class="wls-value-card" data-animate>
              <div class={`wls-value-icon wls-value-icon--${item.accent}`}>
                {item.icon === "target" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" /></svg>
                )}
                {item.icon === "edit" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                )}
                {item.icon === "link" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
                )}
                {item.icon === "map" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                )}
                {item.icon === "ai" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9.94 15.5A2 2 0 0 0 8.5 14.06l-6.14-1.58a.5.5 0 0 1 0-.96L8.5 9.94A2 2 0 0 0 9.94 8.5l1.58-6.14a.5.5 0 0 1 .96 0L14.06 8.5A2 2 0 0 0 15.5 9.94l6.14 1.58a.5.5 0 0 1 0 .96L15.5 14.06a2 2 0 0 0-1.44 1.44l-1.58 6.14a.5.5 0 0 1-.96 0z" /><path d="M20 3v4" /><path d="M22 5h-4" /><path d="M4 17v2" /><path d="M5 18H3" /></svg>
                )}
                {item.icon === "activity" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" /></svg>
                )}
                {item.icon === "chart" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18" /><rect x="7" y="10" width="3" height="7" /><rect x="12" y="6" width="3" height="11" /><rect x="17" y="13" width="3" height="4" /></svg>
                )}
              </div>
              <h3 class="wls-value-title">{item.title}</h3>
              <p class="wls-value-desc">{item.description}</p>
              {item.href && (
                <a class="wls-value-link" href={item.href}>
                  {item.linkLabel}
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== WHY PARTNER WITH US ===== -->
  <section class="wls-why">
    <div class="wls-why-bg">
      <div class="wls-why-orb wls-why-orb--1"></div>
      <div class="wls-why-orb wls-why-orb--2"></div>
    </div>
    <div class="container">
      <div class="wls-why-header" data-animate>
        <span class="section-label section-label--light">Why Partner With Us</span>
        <h2 class="section-heading section-heading--light">More Than Fulfilment</h2>
        <p class="wls-why-subtext">
          Plenty of providers will run your tasks. A few will even join your
          sales calls. Here is what actually separates a partner from a
          fulfilment desk.
        </p>
      </div>

      <div class="wls-why-grid" data-stagger>
        {
          differentiators.map((d) => (
            <div class="wls-why-card" data-animate>
              <h3 class="wls-why-card-title">{d.title}</h3>
              <p class="wls-why-card-desc">{d.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== MID-PAGE CTA BAND ===== -->
  <section class="wls-cta">
    <div class="container">
      <div class="wls-cta-band" data-animate>
        <div class="wls-cta-copy">
          <h2 class="wls-cta-title">Ready to put SEO under your brand?</h2>
          <p class="wls-cta-text">
            Start with a free discovery. We'll look at your portfolio, shape a
            productized service around how you sell, and show you the margins.
          </p>
        </div>
        <div class="wls-cta-actions">
          <a href="/partner-package/" class="btn btn-primary wls-btn-lg">
            Get Our Partner Package
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href="/pricing/" class="btn btn-outline--dark wls-btn-lg">See pricing</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="wls-process">
    <div class="container">
      <div class="wls-process-header" data-animate>
        <span class="section-label">How It Works</span>
        <h2 class="section-heading">How the Partnership Works</h2>
        <p class="section-subtext" style="margin:0 auto;">
          We set the partnership up once, then it is plug-and-play for every
          client you bring. You own the relationship; we run the work behind it.
        </p>
      </div>

      <div class="wls-process-timeline">
        <div class="wls-process-line"></div>
        {
          steps.map((step, i) => (
            <Fragment>
              {step.phase !== steps[i - 1]?.phase && (
                <p class="wls-process-phase">{step.phase}</p>
              )}
              <div class="wls-process-step" data-animate>
                <div class="wls-process-marker"><span class="wls-process-number">{step.number}</span></div>
                <div class="wls-process-step-body">
                  <h3 class="wls-process-step-title">{step.title}</h3>
                  <p class="wls-process-step-desc">{step.description}</p>
                </div>
              </div>
            </Fragment>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== ECOMMERCE / ENTERPRISE ===== -->
  <section class="wls-scale">
    <div class="container">
      <div class="wls-scale-header" data-animate>
        <span class="section-label">High-Value Clients</span>
        <h2 class="section-heading">Ecommerce and Enterprise, Handled</h2>
        <p class="section-subtext" style="margin:0 auto;">
          The biggest accounts your agency can carry are also the hardest to
          deliver. We run both, so you can sell them with confidence.
        </p>
      </div>
      <div class="wls-scale-grid" data-stagger>
        <div class="wls-scale-card" data-animate>
          <h3 class="wls-scale-title">Ecommerce SEO</h3>
          <p class="wls-scale-desc">
            Category and product-level SEO for online stores, with the technical
            and content depth ecommerce demands. Built to scale across large
            catalogs without losing the rankings that drive revenue.
          </p>
        </div>
        <div class="wls-scale-card" data-animate>
          <h3 class="wls-scale-title">Enterprise & multi-location</h3>
          <p class="wls-scale-desc">
            Enterprise organic and multi-location or franchise programs across
            many sites and markets, including publicly traded clients. See our
            <a href="/guides/franchise-seo/">franchise and multi-location guide</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PRICING TEASER ===== -->
  <section class="wls-pricing">
    <div class="container">
      <div class="wls-pricing-header" data-animate>
        <span class="section-label">Wholesale Partner Pricing</span>
        <h2 class="section-heading">Priced for Partners, Marked Up by You</h2>
        <p class="section-subtext" style="margin:0 auto;">
          Three managed-campaign packages. These are the partner rates you pay
          and resell at your own price. Add extra locations, content, and links
          as you need them.
        </p>
      </div>

      <div class="wls-pricing-grid" data-stagger>
        {
          SEO_TIERS.map((tier) => (
            <div class={`wls-pricing-card${tier.featured ? " wls-pricing-card--featured" : ""}`} data-animate>
              {tier.featured && <span class="wls-pricing-badge">Most quoted</span>}
              <h3 class="wls-pricing-tier">{tier.name}</h3>
              <div class="wls-pricing-price">
                <span class="wls-pricing-amount">{usd(tier.price)}</span>
                <span class="wls-pricing-period">/mo wholesale</span>
              </div>
              <p class="wls-pricing-blurb">{tier.blurb}</p>
              <ul class="wls-pricing-features">
                {tier.highlights.map((h) => <li>{h}</li>)}
              </ul>
            </div>
          ))
        }
      </div>

      <p class="wls-pricing-footnote" data-animate>
        This is a summary. The complete rate card, add-ons, and website builds
        live on the <a href="/pricing/">pricing page</a>.
      </p>
    </div>
  </section>

  <!-- ===== WEBSITE BUNDLE ===== -->
  <section class="wls-bundle">
    <div class="container">
      <div class="wls-bundle-card" data-animate>
        <div class="wls-bundle-copy">
          <span class="section-label">Bundle It</span>
          <h2 class="wls-bundle-title">Need websites too?</h2>
          <p class="wls-bundle-text">
            Pair SEO with fast, white-label websites built on Astro and
            Cloudflare, editable by your clients and resold under your brand. A
            new site plus an ongoing campaign is a clean, recurring package.
          </p>
          <a href="/white-label-web-design/" class="wls-bundle-link">
            See white-label web design
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== TESTIMONIALS ===== -->
  <section class="wls-testimonials">
    <div class="container">
      <div class="wls-testimonials-header" data-animate>
        <span class="section-label">Partner Feedback</span>
        <h2 class="section-heading">What Our Partners Say</h2>
      </div>

      <div class="wls-testimonials-grid" data-stagger>
        <blockquote class="wls-testimonial" data-animate>
          <p class="wls-testimonial-text">
            Honestly, working with the SEO Brothers has been incredible. The
            process is great and I always know what I'm getting on every single
            project.
          </p>
          <div class="wls-testimonial-author">
            <div class="wls-testimonial-avatar">RG</div>
            <div>
              <div class="wls-testimonial-name">Rob Gillan</div>
              <div class="wls-testimonial-role">Owner, RedEarMedia.ca</div>
            </div>
          </div>
        </blockquote>

        <blockquote class="wls-testimonial" data-animate>
          <p class="wls-testimonial-text">
            They've been really great at working with us to develop a process
            that really is seamless and works well for us, and helping us
            understand how we can bring the most benefit to our clients.
          </p>
          <div class="wls-testimonial-author">
            <div class="wls-testimonial-avatar wls-testimonial-avatar--purple">JF</div>
            <div>
              <div class="wls-testimonial-name">Joy Fraser</div>
              <div class="wls-testimonial-role">Creative Director, Roddis Communications</div>
            </div>
          </div>
        </blockquote>

        <blockquote class="wls-testimonial" data-animate>
          <p class="wls-testimonial-text">
            You and your company were hands down the best partners we ever worked
            with, and I appreciate all the support over the many years together.
          </p>
          <div class="wls-testimonial-author">
            <div class="wls-testimonial-avatar wls-testimonial-avatar--green">JH</div>
            <div>
              <div class="wls-testimonial-name">Jeff Horst, CFE</div>
              <div class="wls-testimonial-role">Former CEO, RocketBarn</div>
            </div>
          </div>
        </blockquote>
