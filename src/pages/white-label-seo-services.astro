---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import GrowthCallEmbed from "../components/GrowthCallEmbed.astro";
import StickyCta from "../components/StickyCta.astro";
import { SEO_TIERS, usd } from "../data/pricing";

const deliverables = [
  {
    icon: "target",
    accent: "teal",
    title: "Campaign strategy",
    description:
      "We build the strategy with you, keyed to the client's market and the intents that actually move leads. You stay in the conversation; we do the thinking and the work.",
  },
  {
    icon: "edit",
    accent: "green",
    title: "Content & on-page",
    description:
      "Recurring content and on-page work that targets the terms worth winning, written to rank and to read like the client's own brand.",
  },
  {
    icon: "link",
    accent: "teal",
    title: "Link building",
    description:
      "Links built to move rankings, not to pad a report, and never resold PBNs.",
    href: "/guides/link-building/",
    linkLabel: "How we build links",
  },
  {
    icon: "map",
    accent: "green",
    title: "Local & Google Business Profile",
    description:
      "Map pack, GBP, citations, and service-area pages. Local is what we do best, including multi-location and franchise at scale.",
    href: "/guides/local-seo/",
    linkLabel: "Our local SEO framework",
  },
  {
    icon: "ai",
    accent: "teal",
    title: "AI search (GEO & AEO)",
    description:
      "Yes, we run AI SEO. We earn citations in AI Overviews, ChatGPT, and Perplexity as a layer on the organic foundation, measured by leads, not vanity scores.",
    href: "/white-label-ai-seo/",
    linkLabel: "White-label AI SEO",
  },
  {
    icon: "activity",
    accent: "teal",
    title: "Technical SEO & audits",
    description:
      "Crawl health, Core Web Vitals, schema, and the fixes that let the rest of the work pay off, on whatever platform the client is on.",
  },
  {
    icon: "chart",
    accent: "green",
    title: "Reporting under your brand",
    description:
      "A live portal on your own domain showing the work, the rankings, and the leads. Your client sees your brand, never ours.",
  },
];

const salesEnablement = [
  {
    icon: "deck",
    accent: "teal",
    title: "Branded collateral & pitch decks",
    description:
      "One-pagers, pitch decks, and proposals in your branding and your voice, ready to drop into your next sales call. You walk in looking like you've sold SEO for years.",
  },
  {
    icon: "box",
    accent: "green",
    title: "An offer built around how you sell",
    description:
      "We sit with you and shape the offer, deliverables, and positioning to your market. Bundle SEO into a retainer, sell it on its own, or attach it to a website build. Want a productized service you can repeat, or fully custom proposals per client? We work either way.",
  },
  {
    icon: "tag",
    accent: "teal",
    title: "Pricing built to scale",
    description:
      "We help you structure pricing that protects your margin across every client, from a single local campaign to a multi-location program. You set the price. We make sure the model holds as you grow.",
  },
  {
    icon: "compass",
    accent: "green",
    title: "Positioning support",
    description:
      "Never sold SEO before? We help you frame it: where it fits in your lineup, what to promise, and how to talk about results without overpromising.",
  },
  {
    icon: "users",
    accent: "teal",
    title: "We train your team to sell it",
    description:
      "We onboard your sales and account managers on the product itself, so they can pitch it with confidence and handle the first round of questions without reaching for us.",
  },
  {
    icon: "present",
    accent: "green",
    title: "SEO training, straight from our managers",
    description:
      "When your team needs to go deeper, our SEO managers host training webinars and meet with your account managers directly to explain how SEO actually works, so they can field technical client questions like the experts you're presenting them as.",
  },
];

const differentiators = [
  {
    title: "We stay invisible",
    description:
      "We don't put our name or face on your client calls, because the moment we do, your client is one search away from learning you subcontract. We back your sales from behind and let you stay the only name in the room.",
  },
  {
    title: "Any budget, proven both ways",
    description:
      "We have onboarded around 100 clients in a single month for one partner and grown it to roughly 400 active campaigns, and we also run $5K and $10K monthly campaigns, including for publicly traded companies. Small or large, we are fluent at both ends.",
  },
  {
    title: "We make you the expert, not the middleman",
    description:
      "Most providers hand you deliverables and leave the selling to you. We build your offer, your collateral, and your team's confidence, so SEO becomes something your agency owns, not something you quietly outsource.",
  },
  {
    title: "A named team, not a ticket queue",
    description:
      "You get SEO managers who learn your accounts and treat the results like their own, not a rotating desk that closes tickets. For everything your client can see, they are your in-house SEO team.",
  },
];

const icpProfiles = [
  {
    title: "PPC & paid media agencies",
    description:
      "You already run monthly calls and report on performance, so adding SEO is natural. You just don't want to staff the discipline. We slot in behind your existing client rhythm.",
  },
  {
    title: "Web & development studios",
    description:
      "You build the sites and clients expect them to rank. Instead of guessing at SEO or turning the work away, you resell ours as the natural next step after launch.",
  },
  {
    title: "Branding & creative shops",
    description:
      "You're brilliant at one-time projects but less sure about the ongoing monthly report conversation. That is exactly where we lean in hardest, so recurring revenue stops feeling foreign.",
  },
];

const icpFit = [
  "Your clients keep asking for SEO and you'd rather sell it than send them elsewhere",
  "You already know how to win clients and manage an ongoing relationship",
  "You don't want to hire, train, and manage an in-house SEO team",
  "You want recurring revenue without becoming the SEO expert yourself",
  "You've never sold SEO and want a partner to start, or you've sold it for years and need to scale",
  "You'd rather sell outcomes than manage specialists",
];

const partnershipNeeds = [
  {
    title: "Clear priorities",
    description:
      "Tell us what matters most for the business and what each client actually expects. The sharper the priorities, the sharper the strategy.",
  },
  {
    title: "Aligned promises",
    description:
      "We need to know what you've promised clients and how it's packaged and priced at retail, especially when we didn't write the proposal, so delivery matches the sale.",
  },
  {
    title: "One team",
    description:
      "Treat us like part of your agency and we'll do the same. The partners who win biggest loop us in early; they don't hand off a brief and vanish.",
  },
];

const painPoints = [
  {
    moment: "On the call, scrambling",
    quote: "“So... what have you actually done this month?”",
    chip: "Workbench",
    title: "Every touchpoint, logged",
    description:
      "Workbench, our proprietary project management software, records every touchpoint on the campaign, down to the smallest detail. You walk into the call knowing exactly what's been done, and you choose what the client sees and what stays behind the curtain.",
  },
  {
    moment: "Caught flat-footed by a decline",
    quote: "“Rankings dipped. What are we going to do about it?”",
    chip: "Roadmap & initiatives",
    title: "An answer that's already written down",
    description:
      "The roadmap lays out the concrete work ahead: content, links, topics, anchor text, even scheduled GBP posts. The initiatives go further, naming the objective, how it ladders to the campaign's goals, and the pieces we believe will get there. The 'what are you going to do about it' answer is ready before they ask.",
  },
  {
    moment: "Blindsided by something you should've caught",
    quote: "“How did you not notice my site was down?”",
    chip: "Performance Pulse",
    title: "We catch it before the client does",
    description:
      "Performance Pulse watches each campaign automatically: uptime, IP changes, page-speed shifts, unexpected content edits, and priority keywords moving in or out of the top three and page one, plus traffic and conversion drops that also surface broken tracking. You pick what you're alerted on; a few alerts, like a site going down, are mandatory. We get pinged and so do you, so you bring it to the client instead of the other way around.",
  },
];

const steps = [
  {
    phase: "Partner onboarding · set up once",
    number: "01",
    title: "Discovery & fit",
    description:
      "We learn your agency: your niche, how you sell, and the margin you need. This is about your business, not a single client, and there is no drawn-out sales cycle.",
  },
  {
    phase: "Partner onboarding · set up once",
    number: "02",
    title: "We build your service and sales kit",
    description:
      "We shape the offer, pricing, and positioning around how you sell, then hand you the branded collateral and pitch decks to take to market. Most partners want a productized service they can repeat; if you'd rather we build full custom proposals per client, we do that too.",
  },
  {
    phase: "Partner onboarding · set up once",
    number: "03",
    title: "We enable your team",
    description:
      "We onboard your sales and account managers on the product, run an SEO training session so they can speak to the work, and stand up your branded portal on your own domain.",
  },
  {
    phase: "Every campaign · ongoing",
    number: "04",
    title: "Campaign onboarding & initiatives",
    description:
      "For each client you sign, we set the goals and define the initiatives: the strategic direction for the campaign, aligned to the client's market and what actually moves leads, not a loose list of tasks.",
  },
  {
    phase: "Every campaign · ongoing",
    number: "05",
    title: "We run the work under your brand",
    description:
      "Strategy, content, links, local, and technical SEO, delivered as your team. You and your client review and approve in the portal as work ships.",
  },
  {
    phase: "Every campaign · ongoing",
    number: "06",
    title: "Hypothesis, test, iterate",
    description:
      "Every initiative is a hypothesis. We measure it against leads and adjust: double down on what's working, change what isn't. The campaign keeps moving in the right direction instead of drifting.",
  },
];

const faqs = [
  {
    question: "What is included in your white label SEO services?",
    answer:
      "Full-stack SEO delivered under your brand: campaign strategy, content and on-page, link building, local and Google Business Profile, technical SEO and audits, and white-label reporting. You can resell all of it or just the pieces you need.",
  },
  {
    question: "Is it really white-label? Will my client know?",
    answer:
      "It is genuinely invisible. We don't put our name in reports, we don't email or call your client, and we stay off your sales calls on purpose. The portal, the deliverables, and the reporting all carry your brand. The relationship and the pricing are yours.",
  },
  {
    question: "How is outsourced SEO priced?",
    answer:
      "Wholesale, so you build in real margin. Campaigns run on three options, Self-Serve, Managed, and Custom, with add-ons for extra locations, content, and links. You pay the partner rate and mark it up to your client. The full rate card is on our pricing page.",
  },
  {
    question: "What size clients can you handle?",
    answer:
      "Any size. We have run high-volume programs at hundreds of active campaigns and we also run $5K and $10K monthly campaigns for larger and enterprise clients, including publicly traded companies. We scale the work to the budget either way.",
  },
  {
    question: "Do you work with ecommerce and enterprise clients?",
    answer:
      "Yes. Ecommerce and enterprise or multi-location clients are some of the highest-value accounts an agency can carry, and we handle both, including franchise and multi-location architecture across many sites.",
  },
  {
    question: "Do you handle AI SEO and generative search (GEO/AEO)?",
    answer:
      "Yes. We run AI search as a layer on a real organic foundation, earning citations in AI Overviews, ChatGPT, and Perplexity through the same authority, structure, and entity work that earns rankings, and we measure it by leads from AI sources rather than a vanity visibility score. It ships white-label like everything else. See our white-label AI SEO page for the full picture.",
  },
  {
    question:
      "How are you different from a fulfillment shop like The HOTH or E2M?",
    answer:
      "Fulfillment shops execute the tasks you order and leave the strategy and selling to you. We run the strategy and execution and build you a productized service around how you sell. Our white label SEO guide breaks down the difference in full.",
  },
  {
    question: "Do you help us sell SEO, not just deliver it?",
    answer:
      "Yes, and it is a core part of the partnership. We build your sales collateral and pitch decks, shape a productized offer and pricing around how you sell, and train your sales and account team on the product. If your team wants to go deeper, our SEO managers run training webinars so they can confidently answer technical questions. You sell it as your own; we make sure you can. Plenty of our partners had never sold SEO before us.",
  },
  {
    question:
      "Do we have to hand you the whole campaign, or can we just buy pieces?",
    answer:
      "Either works. Most partners run managed, where we own the strategy and deliver the full campaign as your team. Managed campaigns start with discovery because we're responsible for the result, unless we've already built you a ready-to-sell package. If you already run your own SEO strategy, go self-serve and pull only the pieces you need: white-label reporting, research, links, content, or our posting software. You set the dial.",
  },
  {
    question: "How do we and our clients stay in the loop on the work?",
    answer:
      "Every campaign runs through your branded portal. A live work log shows what has been done, the roadmap shows what is coming next, and each campaign is built around clear initiatives tied to the client's goals rather than a loose task list. Our Performance Pulse system also monitors each site automatically and alerts both you and us to issues like downtime or ranking drops, so you are never the last to know. You and your client review and approve as work ships, under your brand.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "White Label SEO Services",
      item: new URL("/white-label-seo-services/", Astro.site).href,
    },
  ],
};
---

<Layout
  title="White Label SEO Services | Outsourced SEO for Agencies | SEO Brothers"
  description="White label SEO services and outsourced SEO for agencies. We run strategy, content, links, local, and technical SEO under your brand, build you a productized service, give you the collateral and training to sell it, and report through a portal on your own domain. Wholesale pricing, free discovery."
  schema={[breadcrumbSchema, faqSchema]}
>
  <Nav />

  <!-- ===== HERO ===== -->
  <section class="wls-hero">
    <div class="wls-hero-bg">
      <div class="wls-hero-orb wls-hero-orb--teal"></div>
      <div class="wls-hero-orb wls-hero-orb--green"></div>
      <div class="wls-hero-orb wls-hero-orb--teal2"></div>
      <div class="wls-hero-grid"></div>
    </div>

    <div class="wls-hero-content container">
      <div class="wls-hero-badge" data-animate>
        <span class="wls-hero-badge-dot"></span>
        White-label & outsourced SEO for agencies
      </div>

      <h1 class="wls-hero-title" data-animate>
        <span class="wls-hero-title-line">Stop Dreading the Client Call.</span
        ><br />
        <span class="wls-hero-title-gradient"
          >White-Label SEO, Run Under Your Brand</span
        >
      </h1>

      <p class="wls-hero-subtitle" data-animate>
        You sell it and own the client. We run the strategy and the work under
        your brand, build you a productized service to sell, and keep you ahead
        of every client conversation with live tracking and proactive alerts. We
        never show up. You just look brilliant.
      </p>

      <div class="wls-hero-actions" data-animate>
        <a href="/sign-up/" class="btn btn-primary wls-btn-lg">
          Start for Free
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <a href="/pricing/" class="btn btn-outline wls-btn-lg">See pricing</a>
      </div>

      <div class="wls-hero-pills" data-animate>
        <span class="wls-hero-pill">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg
          >
          Under your brand
        </span>
        <span class="wls-hero-pill">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg
          >
          Any budget
        </span>
        <span class="wls-hero-pill">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg
          >
          Free discovery
        </span>
      </div>
    </div>
  </section>

  <!-- ===== INTRO ===== -->
  <section class="wls-intro">
    <div class="container">
      <div class="wls-intro-content" data-animate>
        <span class="section-label">Outsourced SEO for Agencies</span>
        <h2 class="section-heading">
          White Label SEO Services You Can Sell Today
        </h2>
        <p class="wls-intro-text">
          Your clients want SEO, and building an in-house team to deliver it is
          slow and expensive. Outsourcing it to whoever you found last week is a
          gamble. White label SEO solves that: we do the work, you resell it
          under your brand, and your client never knows we exist.
        </p>
        <p class="wls-intro-text">
          We are not a fulfillment desk that runs your brief and disappears. We
          build the strategy with you, shape a productized service around how
          your agency actually sells, and run the campaigns under your name. You
          keep the relationship, the pricing, and the margin. If you want to
          understand the models first, start with our
          <a href="/guides/white-label-seo/">white label SEO guide</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== WHO THIS IS FOR (ICP) ===== -->
  <section class="wls-icp">
    <div class="container">
      <div class="wls-icp-header" data-animate>
        <span class="section-label">Who This Is For</span>
        <h2 class="section-heading">
          Built for Agencies Whose Clients Keep Asking for SEO
        </h2>
        <p class="section-subtext" style="margin:0 auto;">
          You already know how to win clients and run the relationship. You just
          don't want to build and babysit an SEO team to keep them. Whether
          you've never sold SEO or you've sold it for years and need to scale,
          we plug in at your level.
        </p>
      </div>

      <div class="wls-icp-grid" data-stagger>
        {
          icpProfiles.map((p) => (
            <div class="wls-icp-card" data-animate>
              <h3 class="wls-icp-card-title">{p.title}</h3>
              <p class="wls-icp-card-desc">{p.description}</p>
            </div>
          ))
        }
      </div>

      <div class="wls-icp-fit" data-animate>
        <p class="wls-icp-fit-label">You're our kind of partner if:</p>
        <ul class="wls-icp-fit-list">
          {icpFit.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ===== PAIN POINTS / NEVER BLINDSIDED ===== -->
  <section class="wls-pain">
    <div class="container">
      <div class="wls-pain-header" data-animate>
        <span class="section-label">Never Get Blindsided</span>
        <h2 class="section-heading">
          Walk Into Every Client Call Knowing More Than They Do
        </h2>
        <p class="section-subtext" style="margin:0 auto;">
          The worst moments in this business all happen on a client call you
          weren't ready for. We built proprietary software so they stop
          happening to you.
        </p>
      </div>

      <div class="wls-pain-list" data-stagger>
        {
          painPoints.map((p) => (
            <div class="wls-pain-row" data-animate>
              <div class="wls-pain-problem">
                <span class="wls-pain-moment">{p.moment}</span>
                <p class="wls-pain-quote">{p.quote}</p>
              </div>
              <div class="wls-pain-fix">
                <span class="wls-pain-chip">{p.chip}</span>
                <h3 class="wls-pain-fix-title">{p.title}</h3>
                <p class="wls-pain-fix-desc">{p.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== CTA (after pain points) ===== -->
  <section class="wls-cta wls-cta--mid">
    <div class="container">
      <div class="wls-cta-band" data-animate>
        <div class="wls-cta-copy">
          <h2 class="wls-cta-title">Never be the last to know again</h2>
          <p class="wls-cta-text">
            That's what the software is for. Start a free account and run a
            discovery on a real client site. You will see the work log, the
            roadmap, and Performance Pulse in action, all under your brand.
          </p>
        </div>
        <div class="wls-cta-actions">
          <a href="/sign-up/" class="btn btn-primary wls-btn-lg">
            Start for Free
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path
                d="M3 8h10M9 4l4 4-4 4"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href="/pricing/" class="btn btn-outline--dark wls-btn-lg"
            >See pricing</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WHAT YOU GET ===== -->
  <section class="wls-value" id="seo-work">
    <div class="container">
      <div class="wls-value-header" data-animate>
        <span class="section-label">What You're Reselling</span>
        <h2 class="section-heading">Full-Stack SEO, Delivered as Your Team</h2>
        <p class="section-subtext" style="margin:0 auto;">
          Every part of an SEO campaign, run under your brand. Resell the whole
          stack or just the pieces you need.
        </p>
      </div>

      <div class="wls-value-grid" data-stagger>
        {
          deliverables.map((item) => (
            <div class="wls-value-card" data-animate>
              <div class={`wls-value-icon wls-value-icon--${item.accent}`}>
                {item.icon === "target" && (
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <circle cx="12" cy="12" r="6" />
                    <circle cx="12" cy="12" r="2" />
                  </svg>
                )}
                {item.icon === "edit" && (
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                  </svg>
                )}
                {item.icon === "link" && (
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                  </svg>
                )}
                {item.icon === "map" && (
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                )}
                {item.icon === "ai" && (
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
