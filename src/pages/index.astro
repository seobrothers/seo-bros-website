---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import AboutBrand from "../components/AboutBrand.astro";
import Services from "../components/Services.astro";
import Process from "../components/Process.astro";
import WhyUs from "../components/WhyUs.astro";
import DasherFeature from "../components/DasherFeature.astro";
import Testimonials from "../components/Testimonials.astro";
import AgencyBand from "../components/AgencyBand.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Footer from "../components/Footer.astro";

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "SEO Brothers",
  url: "https://seobrothers.com",
  logo: "https://seobrothers.com/images/logo.png",
  description:
    "Local SEO company for service and local businesses. Google Maps, local search, content, links, and AI search visibility, managed by specialists who do nothing but SEO.",
  foundingDate: "2015",
  founders: [
    { "@type": "Person", name: "Devon Bate" },
    { "@type": "Person", name: "Adam Bate" },
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Halifax",
    addressRegion: "NS",
    addressCountry: "CA",
  },
  sameAs: [
    "https://www.linkedin.com/company/seobrothers/",
    "https://www.youtube.com/@seobrothers",
    "https://www.facebook.com/theseobrothers/",
  ],
};
---

<Layout
  title="SEO Brothers | Local SEO Company for Service Businesses"
  description="SEO Brothers is a Local SEO company that gets service and local businesses found on Google Maps and search. Halifax-founded, 10+ years, 5,000+ campaigns. Free audit."
  schema={orgSchema}
>
  <Nav />
  <Hero />
  <TrustBar />
  <AboutBrand />
  <Services />
  <Process />
  <WhyUs />
  <DasherFeature />
  <Testimonials />
  <AgencyBand />
  <CtaBanner />
  <Footer />
</Layout>
