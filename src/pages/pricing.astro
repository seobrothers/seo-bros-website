---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CtaBanner from "../components/CtaBanner.astro";
import {
  SEO_TIERS,
  REPORTING,
  HEALTH,
  STRATEGY,
  strategyMonthly,
  BACKLINK,
  EXTRA_BLOG,
  EXTRA_HOUR,
  EXTRA_LOCATION,
  GBP_POSTING,
  HOSTING,
  MAINTENANCE,
  WEB_BUILDS,
  usd,
} from "../data/pricing";

const tiers = SEO_TIERS;

// À-la-carte rate card (the building blocks behind the packages, matching the
// package builder on /partner-welcome/). Website builds render separately below.
const rateCard = [
  { name: REPORTING.label, value: usd(REPORTING.price), suffix: "/ mo", note: REPORTING.note, tag: "In every campaign" },
  { name: HEALTH.label, value: usd(HEALTH.price), suffix: "/ mo", note: HEALTH.note, tag: "In every campaign" },
  { name: STRATEGY.label, value: usd(STRATEGY.pricePerReview), suffix: "per review", note: `Cadence sets the monthly cost: semi-annual ${usd(strategyMonthly(2))}/mo, quarterly ${usd(strategyMonthly(4))}/mo, monthly ${usd(strategyMonthly(12))}/mo.` },
  { name: "SEO Time", value: usd(EXTRA_HOUR.price), suffix: "/ hour, monthly", note: "Time on the next most important thing for the site: geo and service pages, on-page optimization, page speed, and technical improvements." },
  { name: EXTRA_LOCATION.label, value: usd(EXTRA_LOCATION.price), suffix: "/ mo each", note: EXTRA_LOCATION.note },
  { name: "Authority content", value: usd(EXTRA_BLOG.price), suffix: "each, monthly", note: "Built for freshness and topical authority. Usually one, sometimes two a month depending on site size." },
  { name: BACKLINK.label, value: usd(BACKLINK.price), suffix: "each, monthly", note: BACKLINK.note },
  { name: GBP_POSTING.label, value: usd(GBP_POSTING.price), suffix: "/ mo", note: GBP_POSTING.note, tag: "Recommended for local" },
  { name: HOSTING.label, value: "from " + usd(HOSTING.price), suffix: "/ mo", note: HOSTING.note },
  { name: MAINTENANCE.label, value: "from " + usd(MAINTENANCE.price), suffix: "/ mo", note: MAINTENANCE.note },
];

interface ComparisonRow {
  label: string;
  values: (string | true)[];
}

const comparison: ComparisonRow[] = [
  {
    label: "Strategic review",
    values: ["Semi-annual", "Quarterly", "Quarterly"],
  },
  {
    label: "Technical crawl review + fixes",
    values: [true, true, true],
  },
  {
    label: "Live reporting dashboard",
    values: [true, true, true],
  },
  {
    label: "Local Maps focus location",
    values: ["1", "1", "1"],
  },
  {
    label: "Backlinks per month",
    values: ["1", "2", "4"],
  },
  {
    label: "Priority Intents set",
    values: ["Semi-annually", "Quarterly", "Quarterly"],
  },
  {
    label: "SEO Time per month",
    values: ["1.5 hours", "3 hours", "5.5 hours"],
  },
  {
    label: "Authority content per month",
    values: ["0", "1", "2"],
  },
];

interface Definition {
  term: string;
  body: string;
}

const definitions: Definition[] = [
  {
    term: "Strategic review",
    body: "A scheduled session with your dedicated strategist to evaluate campaign performance, adjust priorities, and align on what is next. Tiny gets two per year, Typical and Turbo four.",
  },
  {
    term: "Technical crawl review + fixes",
    body: "Each month we run a full technical audit, by default through AgencyAnalytics. When AA is not a fit (like a franchisee on a subfolder, since AA only crawls full domains), we use our own crawling and scoring system. The commitment is a 95%+ score with zero critical errors.",
  },
  {
    term: "Live reporting dashboard",
    body: "A real-time dashboard (currently powered by AgencyAnalytics) showing rankings, traffic, conversions, and the work we are doing. You and your client can log in any time.",
  },
  {
    term: "Local Maps focus location",
    body: "One geographic target where we concentrate the work that drives map ranking: citation building, on-page optimizations to the GBP-linked landing page, and ongoing GBP profile updates (photos, service area, full services list build-out, and similar). Typically one of these per month. Additional locations available as an add-on starting at $60 each. (GBP posting is handled separately by our in-house posting tool and is not part of this line item.)",
  },
  {
    term: "Backlinks",
    body: "Editorial links built to your site each month from various publishing sources.",
  },
  {
    term: "Priority Intents",
    body: "The search intents we're actively working to rank for this cycle, set at each strategic review. Each intent maps to whichever page is best positioned to win it (sometimes the page you'd expect, sometimes a different one we surface during planning). Intents can be organic ('invisalign halifax') or map-based ('dentist in halifax'). Strategic review cadence determines re-setting: semi-annually on Tiny, quarterly on Typical and Turbo.",
  },
  {
    term: "SEO Time",
    body: "Specialist time set aside each month and directed at the next most important thing for the site: geo and location pages, service-page support, on-page optimization, page speed, and technical improvements. It is a time allocation, not loose 'flex' hours. Catching and fixing crawl errors is the health score's job; SEO Time is the proactive improvement work. Tiny gets 1.5 hours, Typical 3, Turbo 5.5, and you can add more at $60 per hour.",
  },
  {
    term: "Authority content",
    body: "A blog or authority piece written, optimized, and published to keep the site fresh and build topical authority in the space. You usually only need one, sometimes two a month depending on the size of the site. $120 per piece. (Geo and location pages fall under SEO Time, not content.)",
  },
];

const faqs: { q: string; a: string }[] = [
  {
    q: "Will I only pay one of the above price points?",
    a: "Not necessarily. We complete a free discovery for every new opportunity you have. During this process, we make a specific budget recommendation based on the current performance, the goals and expectations, and how competitive the market is. While we can always work with the above price points, we may need to adjust expectations or timeline to success.",
  },
  {
    q: "How much should I sell these for?",
    a: "Every partner is different. We recommend selling these campaigns for at least 2×. Partners that provide SEO as part of a larger marketing campaign sometimes choose to go a bit lower. Partners that only sell SEO and add their own value often sell for 2.5× or 3× these prices.",
  },
  {
    q: "Can I create my own custom packages?",
    a: "Yes, absolutely. After we have worked on a campaign or two together and better understand your agency's needs, your account manager can work with you to customize packages unique to your clients and your workflow. These are often variations of our existing customized solutions for your business.",
  },
  {
    q: "I have an existing book of business. Can you support it all?",
    a: "Of course. We have worked with many agency partners and have successfully migrated as many as 60 campaigns within the first few months of working together. Be sure to mention this during your demo call. We'll iron out the details to ensure you and your clients have a seamless transition.",
  },
  {
    q: "What currency do you charge in?",
    a: "All of our listed and quoted prices are in USD, and that's how we bill by default. Canadian partners can inquire about CAD billing at a fixed conversion rate.",
  },
  {
    q: "How does invoicing work? What if I have 10 campaigns?",
    a: "All of our invoices are prorated to the first of the month. If you start a campaign on the 15th, you'll pay half of the monthly amount and then the full monthly amount on the 1st going forward. Most clients view SEO in monthly cadences with monthly reports, so billing aligns to that. By default, each campaign gets its own invoice (a single line for the full amount, labeled \"SEO Campaign\") and they're charged together as a single credit card transaction. If you'd prefer one consolidated invoice across all your campaigns for accounting, we can arrange that.",
  },
  {
    q: "Do your campaigns have annual contracts?",
    a: "No. All of our individual campaigns have a month-to-month contract with a one-month cancellation policy.",
  },
  {
    q: "What is your cancellation policy?",
    a: "We require a one-month cancellation notice. For example, if you want to cancel a campaign so it does not bill on March 1st, you'll need to submit your cancellation request by January 31st.",
  },
  {
    q: "Do you offer refunds?",
    a: "No. We do not offer refunds on services. If there is ever an error with billing (such as an incorrect amount or a missed cancellation), these will always be rectified, including refunds. We do not offer refunds for any other reason.",
  },
  {
    q: "My client ghosted and stopped paying me. What can we do?",
    a: "We're on the same team. While this doesn't happen often, we have experienced situations where clients stopped paying our partners. The most important thing is to communicate transparently and quickly so we can align on a plan forward, whether that's extending the invoice due date, pausing service temporarily, or another solution. Your account manager will work with you on a resolution.",
  },
  {
    q: "I think I'm set. How do I get started?",
    a: "Your first step is to book a demo. Mike will walk you through the deliverables and systems you'll use, answer your questions, align on hot topics, and confirm we're a good fit. Once we're aligned, campaigns activate on a Monday or the 1st of the month, whichever you prefer. Your first month prorates from the start date, and after that billing runs on the 1st with cancel-anytime terms.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.a,
    },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Pricing", item: new URL("/pricing/", Astro.site).href },
  ],
};
---

<Layout
  title="White-Label SEO Packages and Pricing | SEO Brothers"
  description="Wholesale white-label SEO pricing for agency partners. Three SEO packages plus website builds and recurring add-ons. These are the partner rates you pay; you mark them up to your client. No annual contracts."
  schema={[breadcrumbSchema, faqSchema]}
>
  <Nav />

  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="pricing-hero">
    <div class="pricing-hero__bg">
      <div class="pricing-hero__orb pricing-hero__orb--1"></div>
      <div class="pricing-hero__orb pricing-hero__orb--2"></div>
      <div class="pricing-hero__orb pricing-hero__orb--3"></div>
      <div class="pricing-hero__grid"></div>
    </div>

    <div class="container pricing-hero__inner">
      <span class="pricing-hero__label" data-animate>
        <span class="pricing-hero__label-dot"></span>
        White-Label SEO Packages
      </span>

      <h1 class="pricing-hero__title" data-animate>
        White-label SEO packages<br />
        <span class="pricing-hero__title-gradient">priced for partners.</span>
      </h1>

      <p class="pricing-hero__subtitle" data-animate>
        This is our complete white-label SEO pricing rate card. Every number
        below is the wholesale price you pay as a partner agency. You mark it
        up and bill your own client. The three packages are real,
        frequently-quoted starting points, and your account manager can tune
        any of them to fit your clients' competition, geography, and goals.
      </p>

      <div class="pricing-hero__meta" data-animate>
        <span class="pricing-hero__meta-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          Month-to-month, no annual contracts
        </span>
        <span class="pricing-hero__meta-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          Free discovery on every opportunity
        </span>
        <span class="pricing-hero__meta-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          Billed in USD, inquire for CAD in Canada
        </span>
      </div>
    </div>
  </section>

  <!-- ═══════════════ TIERS ═══════════════ -->
  <section class="tiers">
    <div class="container">
      <div class="tiers__intro" data-animate>
        <span class="section-label">Wholesale Partner Rates</span>
        <h2 class="section-heading">
          Standard pricing for local businesses
        </h2>
        <p class="section-subtext">
          Wholesale pricing for SEO campaigns run on local or multi-location
          business websites. The packages below are real starting points, not
          a fixed menu. Every campaign includes a free discovery, so the
          actual quote reflects budget, current performance, competition, and
          expectations.
        </p>
      </div>

      <div class="wholesale-banner-wrap" data-animate>
        <div class="wholesale-banner">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
          </svg>
          <span>
            <strong>Partner pricing.</strong> Direct clients receive proposals
            from a partner agency.
          </span>
        </div>
      </div>

      <div class="tiers__grid" data-stagger>
        {
          tiers.map((tier) => (
            <article
              class:list={[
                "tier",
                `tier--${tier.accent}`,
                tier.featured && "tier--featured",
              ]}
              data-animate
            >
              {tier.featured && (
                <span class="tier__badge">Most popular</span>
              )}
              <header class="tier__head">
                <h3 class="tier__name">{tier.name}</h3>
                <p class="tier__blurb">{tier.blurb}</p>
              </header>

              <div class="tier__price">
                <span class="tier__price-value">{usd(tier.price)}</span>
                <span class="tier__price-suffix">/ mo</span>
              </div>

              <ul class="tier__highlights">
                {tier.highlights.map((h) => (
                  <li>
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>

              <a
                href="/partner-package/"
                class:list={[
                  "tier__cta",
                  tier.featured ? "btn btn-primary" : "btn btn-outline--dark",
                ]}
              >
                Get Access
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                  <path
                    d="M3 8h10M9 4l4 4-4 4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </article>
          ))
        }
      </div>

      <!-- ─── Comparison table ─── -->
      <div class="comparison" data-animate>
        <header class="comparison__head">
          <h3 class="comparison__title">What's included at each tier</h3>
          <p class="comparison__subtitle">
            Counts and cadences below are starting points. Anything can scale
            up, scale down, or run on a different schedule.
          </p>
        </header>

        <div class="comparison__table-wrap">
          <table class="comparison__table">
            <thead>
              <tr>
                <th scope="col" class="comparison__th comparison__th--label">
                  Deliverable
                </th>
                {tiers.map((tier) => (
                  <th
                    scope="col"
                    class:list={[
                      "comparison__th",
                      `comparison__th--${tier.accent}`,
                      tier.featured && "comparison__th--featured",
                    ]}
                  >
                    <span class="comparison__th-name">{tier.name}</span>
                    <span class="comparison__th-price">{usd(tier.price)}/mo</span>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {comparison.map((row) => (
                <tr class="comparison__row">
                  <th scope="row" class="comparison__row-label">
                    {row.label}
                  </th>
                  {row.values.map((v, i) => (
                    <td
                      class:list={[
                        "comparison__cell",
                        tiers[i].featured && "comparison__cell--featured",
                      ]}
                    >
                      {v === true ? (
                        <svg
                          class="comparison__check"
                          width="18"
                          height="18"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-label="Included"
                        >
                          <polyline points="20 6 9 17 4 12" />
                        </svg>
                      ) : (
                        <span class="comparison__value">{v}</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <p class="compare-note" data-animate>
        This isn't a menu of different work per plan. Every campaign can include
        any of it; the package size sets how much SEO Time we have, not which
        work we do, and we focus the budget on the next most valuable thing.
        <a href="/white-label-seo-services/#seo-work">See everything SEO Time covers</a>.
      </p>

      <!-- ─── Cadence flexibility callout ─── -->
      <aside class="cadence" data-animate>
        <div class="cadence__copy">
          <span class="cadence__eyebrow">Build your own cadence</span>
          <h3 class="cadence__title">
            Pricing flexes with the cadence.
          </h3>
          <p class="cadence__lede">
            Any deliverable can run on a different schedule and stay priced
            monthly. Your account manager scopes the proposal that fits each
            client's competition, geography, and goals.
          </p>
        </div>
        <ul class="cadence__examples">
          <li>
            <span class="cadence__example-label">Authority content every other month</span>
            <span class="cadence__example-price">From $60 / mo</span>
          </li>
          <li>
            <span class="cadence__example-label">GBP posting, any number of locations</span>
            <span class="cadence__example-price">$50 / mo</span>
          </li>
          <li>
            <span class="cadence__example-label">Custom backlink or SEO Time hours</span>
            <span class="cadence__example-price">Scoped during discovery</span>
          </li>
        </ul>
      </aside>

      <!-- ─── Websites & add-ons ─── -->
      <div class="addons" data-animate>
        <header class="addons__head">
          <span class="section-label">À la carte</span>
          <h3 class="addons__title">The full rate card</h3>
          <p class="addons__subtitle">
            The building blocks behind the packages. Every campaign includes
            reporting and a health score; strategy, SEO Time, authority
            content, and links scale to the plan. Build any mix you want. These
            are wholesale prices you pay us and mark up to your client.
          </p>
        </header>

        <div class="addons__grid" data-stagger>
          <a
            class="addon"
            href="/white-label-web-design/"
            data-animate
          >
            <span class="addon__name">{WEB_BUILDS[0].name}</span>
            <span class="addon__price">
              <span class="addon__price-value">{usd(WEB_BUILDS[0].price)}</span>
              <span class="addon__price-suffix">one-time</span>
            </span>
            <span class="addon__note">{WEB_BUILDS[0].blurb}</span>
          </a>

          <a
            class="addon addon--featured"
            href="/white-label-web-design/"
            data-animate
          >
            <span class="addon__badge">Most popular</span>
            <span class="addon__name">{WEB_BUILDS[1].name}</span>
            <span class="addon__price">
              <span class="addon__price-value">{usd(WEB_BUILDS[1].price)}</span>
              <span class="addon__price-suffix">one-time</span>
            </span>
            <span class="addon__note">{WEB_BUILDS[1].blurb}</span>
          </a>

          {rateCard.map((item) => (
            <div class="addon" data-animate>
              {item.tag && <span class="addon__badge">{item.tag}</span>}
              <span class="addon__name">{item.name}</span>
              <span class="addon__price">
                <span class="addon__price-value">{item.value}</span>
                <span class="addon__price-suffix">{item.suffix}</span>
              </span>
              <span class="addon__note">{item.note}</span>
            </div>
          ))}
        </div>

        <p class="addons__footnote">
          Want it all in one number? <a href="/partner-package/">Build your own
          package</a> and we will scope a single monthly quote across SEO, the
          website, and the add-ons.
        </p>
      </div>

      <!-- ─── Definitions ─── -->
      <div class="definitions" data-animate>
        <header class="definitions__head">
          <span class="section-label">Glossary</span>
          <h3 class="definitions__title">What each deliverable means</h3>
        </header>
        <dl class="definitions__list" data-stagger>
          {definitions.map((d) => (
            <div class="definitions__item" data-animate>
              <dt class="definitions__term">{d.term}</dt>
              <dd class="definitions__body">{d.body}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ═══════════════ FAQ ═══════════════ -->
  <section class="faq">
    <div class="container">
      <div class="faq__head" data-animate>
        <span class="section-label">FAQ</span>
        <h2 class="section-heading">Questions partners ask</h2>
      </div>

      <div class="faq__list" data-stagger>
        {
          faqs.map((faq) => (
            <details class="faq__item" data-animate>
              <summary class="faq__question">
                <span>{faq.q}</span>
                <span class="faq__icon" aria-hidden="true">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 6l4 4 4-4" />
                  </svg>
                </span>
              </summary>
              <div class="faq__answer">
                <p>{faq.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner variant="partner" />
  <Footer />
</Layout>

<style>
  /* ═══════════════════════════════════════════════════════════════════
     HERO
     ═══════════════════════════════════════════════════════════════════ */
  .pricing-hero {
    position: relative;
    background: var(--dark);
    overflow: hidden;
    padding: 180px 0 120px;
  }

  .pricing-hero__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .pricing-hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.22;
  }

  .pricing-hero__orb--1 {
    width: 520px;
    height: 520px;
    background: var(--teal);
    top: -10%;
    left: -8%;
  }

  .pricing-hero__orb--2 {
    width: 480px;
    height: 480px;
    background: var(--purple);
    top: -5%;
    right: -8%;
  }

  .pricing-hero__orb--3 {
    width: 380px;
    height: 380px;
    background: var(--green);
    bottom: -25%;
    left: 40%;
  }

  .pricing-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at 50% 30%, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(
      ellipse at 50% 30%,
      black 30%,
      transparent 75%
    );
  }

  .pricing-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 880px;
  }

  .pricing-hero__label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal-light);
    margin-bottom: 28px;
  }

  .pricing-hero__label-dot {
    width: 8px;
    height: 8px;
    background: var(--green);
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(68, 185, 123, 0.18);
  }

  .pricing-hero__title {
    font-family: var(--font-display);
    font-size: clamp(40px, 6.5vw, 68px);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--text-on-dark);
    margin-bottom: 24px;
  }

  .pricing-hero__title-gradient {
    background: linear-gradient(135deg, var(--green) 0%, var(--green-light) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .pricing-hero__subtitle {
    font-size: clamp(16px, 1.8vw, 19px);
    line-height: 1.7;
    color: var(--text-on-dark-muted);
    max-width: 640px;
    margin-bottom: 36px;
  }

  .pricing-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
  }

  .pricing-hero__meta-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text-on-dark-muted);
  }

  .pricing-hero__meta-item svg {
    color: var(--green);
  }

  /* ═══════════════════════════════════════════════════════════════════
     TIERS
     ═══════════════════════════════════════════════════════════════════ */
  .tiers {
    padding: 120px 0;
    background: var(--white);
  }

  .tiers__intro {
    max-width: 720px;
    margin: 0 auto 72px;
    text-align: center;
  }

  .tiers__intro .section-label,
  .tiers__intro .section-subtext {
    margin-left: auto;
    margin-right: auto;
  }

  .tiers__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    align-items: stretch;
  }

  .tier {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 40px 36px;
    border-radius: var(--radius-xl);
    background: var(--white);
    border: 1px solid var(--border-light);
    transition: all var(--transition);
    overflow: hidden;
  }

  .tier::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    pointer-events: none;
  }

  .tier--teal::after {
    background: var(--teal);
  }

  .tier--purple::after {
    background: linear-gradient(90deg, var(--teal) 0%, var(--purple) 50%, var(--green) 100%);
    background: linear-gradient(90deg in oklch, var(--teal) 0%, var(--purple) 50%, var(--green) 100%);
  }

  .tier--green::after {
    background: var(--green-dark);
  }

  .tier:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  /* background-clip two-layer technique for the gradient border ring.
     Same approach as .wl-pricing-card--featured. Avoids the ::before +
     mask-composite trick that broke in Firefox. */
  .tier--featured {
    background:
      linear-gradient(var(--dark), var(--dark)) padding-box,
      linear-gradient(135deg, var(--teal) 0%, var(--purple) 50%, var(--green) 100%) border-box;
    background:
      linear-gradient(var(--dark), var(--dark)) padding-box,
      linear-gradient(135deg in oklch, var(--teal) 0%, var(--purple) 50%, var(--green) 100%) border-box;
    border: 1.5px solid transparent;
    color: var(--text-on-dark);
    transform: translateY(-12px);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
  }

  .tier--featured:hover {
    transform: translateY(-16px);
  }

  .tier__badge {
    position: absolute;
    top: 24px;
    right: 24px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--teal) 0%, var(--purple) 100%);
    background: linear-gradient(135deg in oklch, var(--teal) 0%, var(--purple) 100%);
    color: var(--white);
  }

  .tier__head {
    margin-bottom: 32px;
  }

  .tier__name {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 16px;
  }

  .tier--featured .tier__name {
    color: var(--teal-light);
  }

  .tier--green .tier__name {
    color: var(--green-dark);
  }

  .tier__blurb {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
    min-height: 96px;
  }

  .tier--featured .tier__blurb {
    color: var(--text-on-dark-muted);
  }

  .tier__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 36px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--border-light);
  }

  .tier--featured .tier__price {
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  .tier__price-value {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 56px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .tier--featured .tier__price-value {
    background: linear-gradient(135deg, var(--green) 0%, var(--green-light) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .tier__price-suffix {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .tier--featured .tier__price-suffix {
    color: var(--text-on-dark-muted);
  }

  .tier__highlights {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tier__highlights li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .tier--featured .tier__highlights li {
    color: var(--text-on-dark);
  }

  .tier__highlights svg {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--green);
  }

  .tier--featured .tier__highlights svg {
    color: var(--green-light);
  }

  .tier__cta {
    width: 100%;
    margin-top: auto;
  }

  .tier--featured .tier__cta.btn-outline--dark {
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--text-on-dark);
  }

  .tier--featured .tier__cta.btn-outline--dark:hover {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.06);
  }

  /* ═══════════════════════════════════════════════════════════════════
     WHOLESALE BANNER
     ═══════════════════════════════════════════════════════════════════ */
  .wholesale-banner-wrap {
    text-align: center;
    margin-bottom: 48px;
  }

  .wholesale-banner {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    background: linear-gradient(
      90deg,
      rgba(40, 165, 177, 0.06),
      rgba(124, 89, 184, 0.06) 50%,
      rgba(68, 185, 123, 0.06)
    );
    border: 1px solid rgba(40, 165, 177, 0.22);
    border-radius: var(--radius-full);
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-secondary);
    text-align: left;
  }

  .wholesale-banner strong {
    color: var(--text-primary);
    font-weight: 700;
  }

  .wholesale-banner svg {
    flex-shrink: 0;
    color: var(--teal);
  }

  /* ═══════════════════════════════════════════════════════════════════
     COMPARISON TABLE
     ═══════════════════════════════════════════════════════════════════ */
  .comparison {
    margin-top: 96px;
    padding: 56px 48px;
    background: var(--light);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-light);
  }

  .comparison__head {
    text-align: center;
    margin-bottom: 40px;
  }

  .comparison__title {
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 12px;
  }

  .comparison__subtitle {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 auto;
    max-width: 540px;
  }

  .comparison__table-wrap {
    overflow-x: auto;
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid var(--border-light);
  }

  .comparison__table {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
  }

  .comparison__th {
    padding: 24px 20px 20px;
    font-family: var(--font-display);
    font-weight: 700;
    text-align: center;
    border-bottom: 2px solid var(--border-light);
  }

  .comparison__th-name {
    display: block;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .comparison__th-price {
    display: block;
    font-size: 18px;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    font-weight: 800;
    text-transform: none;
  }

  .comparison__th--label {
    text-align: left;
    color: var(--text-muted);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 24px 20px 20px;
  }

  .comparison__th--teal .comparison__th-name { color: var(--teal); }
  .comparison__th--purple .comparison__th-name { color: var(--purple); }
  .comparison__th--green .comparison__th-name { color: var(--green-dark); }

  .comparison__th--featured {
    background: linear-gradient(
      180deg,
      rgba(124, 89, 184, 0.1),
      rgba(124, 89, 184, 0) 80%
    );
  }

  .comparison__row {
    border-bottom: 1px solid var(--border-light);
  }

  .comparison__row:last-child {
    border-bottom: none;
  }

  .comparison__row:hover {
    background: rgba(40, 165, 177, 0.025);
  }

  .comparison__row-label {
    text-align: left;
    padding: 18px 20px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-primary);
    font-family: inherit;
  }

  .comparison__cell {
    text-align: center;
    padding: 18px 20px;
    font-size: 15px;
    color: var(--text-secondary);
    vertical-align: middle;
  }

  .comparison__cell--featured {
    background: rgba(124, 89, 184, 0.04);
  }

  .comparison__check {
    color: var(--green);
    vertical-align: middle;
  }

  .comparison__value {
    font-weight: 700;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 16px;
  }

  /* ═══════════════════════════════════════════════════════════════════
     CADENCE CALLOUT
     ═══════════════════════════════════════════════════════════════════ */
  .cadence {
    margin-top: 56px;
    padding: 48px 56px;
    background: var(--dark);
    color: var(--text-on-dark);
    border-radius: var(--radius-xl);
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .cadence::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 95% 50%, rgba(40, 165, 177, 0.22), transparent 55%),
      radial-gradient(circle at 5% 110%, rgba(124, 89, 184, 0.2), transparent 50%);
    pointer-events: none;
  }

  .cadence > * {
    position: relative;
    z-index: 1;
  }

  .cadence__eyebrow {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--teal-light);
    margin-bottom: 16px;
  }

  .cadence__title {
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 16px;
    color: var(--text-on-dark);
  }

  .cadence__lede {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-on-dark-muted);
    margin: 0;
    max-width: 460px;
  }

  .cadence__examples {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cadence__examples li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    font-size: 14px;
    transition: all var(--transition);
  }

  .cadence__examples li:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(40, 165, 177, 0.35);
  }

  .cadence__example-label {
    color: var(--text-on-dark);
    font-weight: 500;
  }

  .cadence__example-price {
    color: var(--teal-light);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    white-space: nowrap;
  }

  /* ═══════════════════════════════════════════════════════════════════
     WEBSITES & ADD-ONS
     ═══════════════════════════════════════════════════════════════════ */
  .addons {
    margin-top: 96px;
  }

  .addons__head {
    text-align: center;
    margin-bottom: 48px;
  }

  .addons__head .section-label {
    margin-left: auto;
    margin-right: auto;
  }

  .addons__title {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.5vw, 36px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 12px 0 16px;
  }

  .addons__subtitle {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 auto;
    max-width: 560px;
  }

  .addons__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 960px;
    margin: 0 auto;
  }

  .addon {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 28px 30px;
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    transition: all var(--transition);
    text-decoration: none;
  }

  a.addon:hover {
    border-color: rgba(40, 165, 177, 0.35);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .addon--featured {
    border-color: rgba(124, 89, 184, 0.4);
    box-shadow: var(--shadow-md);
  }

  .addon__badge {
    position: absolute;
    top: -11px;
    left: 28px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--teal) 0%, var(--purple) 100%);
    background: linear-gradient(135deg in oklch, var(--teal) 0%, var(--purple) 100%);
    color: var(--white);
  }

  .addon__name {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal);
  }

  .addon--featured .addon__name {
    color: var(--purple);
  }

  .addon__price {
    display: flex;
    align-items: baseline;
    gap: 7px;
  }

  .addon__price-value {
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 32px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .addon__price-suffix {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .addon__note {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .addons__footnote {
    text-align: center;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 40px auto 0;
    max-width: 560px;
  }

  .addons__footnote a {
    color: var(--teal);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid rgba(40, 165, 177, 0.35);
  }

  .addons__footnote a:hover {
    border-bottom-color: var(--teal);
  }

  /* ═══════════════════════════════════════════════════════════════════
     DEFINITIONS
     ═══════════════════════════════════════════════════════════════════ */
  .definitions {
    margin-top: 96px;
  }

  .definitions__head {
    text-align: center;
    margin-bottom: 48px;
  }

  .definitions__head .section-label {
    margin-left: auto;
    margin-right: auto;
  }

  .definitions__title {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.5vw, 36px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 12px 0 0;
  }

  .definitions__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 960px;
    margin: 0 auto;
  }

  .definitions__item {
    padding: 28px 32px;
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    transition: all var(--transition);
  }

  .definitions__item:hover {
    border-color: rgba(40, 165, 177, 0.25);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .definitions__term {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .definitions__body {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }

  /* ═══════════════════════════════════════════════════════════════════
     FAQ
     ═══════════════════════════════════════════════════════════════════ */
  .faq {
    padding: 0 0 120px;
    background: var(--white);
  }

  .faq__head {
    max-width: 640px;
    margin: 0 auto 56px;
    text-align: center;
  }

  .faq__head .section-label {
    margin-left: auto;
    margin-right: auto;
  }

  .faq__list {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq__item {
    border-radius: var(--radius-lg);
    background: var(--light);
    border: 1px solid var(--border-light);
    transition: all var(--transition);
    overflow: hidden;
  }

  .faq__item[open] {
    background: var(--white);
    border-color: rgba(40, 165, 177, 0.25);
    box-shadow: var(--shadow-md);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 28px;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--text-primary);
    list-style: none;
    transition: color var(--transition);
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:hover {
    color: var(--teal);
  }

  .faq__icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--white);
    border: 1px solid var(--border-light);
    color: var(--text-secondary);
    transition: all var(--transition);
  }

  .faq__item[open] .faq__icon {
    background: var(--teal);
    border-color: var(--teal);
    color: var(--white);
    transform: rotate(180deg);
  }

  .faq__answer {
    padding: 0 28px 24px;
  }

  .faq__answer p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0;
  }

  /* ═══════════════════════════════════════════════════════════════════
     RESPONSIVE
     ═══════════════════════════════════════════════════════════════════ */
  @media (max-width: 1024px) {
    .tiers__grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin-left: auto;
      margin-right: auto;
    }

    .tier--featured {
      transform: none;
    }

    .tier--featured:hover {
      transform: translateY(-4px);
    }

    .tier__blurb {
      min-height: 0;
    }

    .cadence {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 40px 36px;
    }

    .definitions__list {
      grid-template-columns: 1fr;
    }

    .addons__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .pricing-hero {
      padding: 140px 0 80px;
    }

    .tiers {
      padding: 80px 0;
    }

    .faq {
      padding-bottom: 80px;
    }

    .tier {
      padding: 32px 28px;
    }

    .comparison {
      padding: 40px 24px;
      margin-top: 64px;
    }

    .comparison__th,
    .comparison__row-label,
    .comparison__cell {
      padding: 14px 16px;
    }

    .cadence {
      padding: 32px 24px;
      margin-top: 40px;
    }

    .definitions {
      margin-top: 64px;
    }

    .definitions__item {
      padding: 22px 24px;
    }

    .addons {
      margin-top: 64px;
    }

    .addons__grid {
      grid-template-columns: 1fr;
      max-width: 480px;
    }

    .faq__question {
