---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const processSteps = [
  {
    number: "01",
    title: "World-Class Free Discovery",
    description:
      "We offer free audits that others charge thousands for. We identify opportunities, assess competition, and support your sales efforts before you commit to anything. No other white-label provider offers this.",
  },
  {
    number: "02",
    title: "Strategic Onboarding",
    description:
      "Every campaign starts with a strategic onboard that lays the foundation: priorities, quick wins, and a clear roadmap. Your account manager walks you through every detail.",
  },
  {
    number: "03",
    title: "Execute & Optimize",
    description:
      "On-page optimizations, content marketing, technical improvements, link acquisition, and more, all driven by the strategic plan for each campaign.",
  },
  {
    number: "04",
    title: "Review & Pivot",
    description:
      "Reviews happen on whatever cadence each campaign needs. We compare performance to plan, look at what competitors have shifted, and adjust priorities so we're always pointed at the gap that's actually limiting growth.",
  },
  {
    number: "05",
    title: "Reports & Dashboards",
    description:
      "White-label branded reports and real-time data dashboards you can reference any time. Always know what's happening across every campaign.",
  },
];

const components = [
  {
    icon: "strategy",
    title: "Quality Onboarding & Strategy",
    description:
      "Every campaign starts with our strategic onboarding month, setting the campaign up for success while capitalizing on quick wins.",
  },
  {
    icon: "keywords",
    title: "Keyword Research & Mapping",
    description:
      "The backbone of campaign success. Understanding existing content, identifying gaps, and mapping keywords to the right pages.",
  },
  {
    icon: "onpage",
    title: "On-Page Optimizations",
    description:
      "Page-specific meta data, headers, body copy, and content optimized to improve relevance and search visibility.",
  },
  {
    icon: "technical",
    title: "Technical SEO & Crawl Fixes",
    description:
      "Page speed, schema, broken links, canonical tags, and other technical elements reviewed and improved continuously.",
  },
  {
    icon: "links",
    title: "High-Quality Link Acquisition",
    description:
      "Quality links from authoritative sources with well-balanced anchor text for long-term website authority and campaign success.",
  },
  {
    icon: "local",
    title: "GBP & Local SEO",
    description:
      "Strategic GBP profile improvements, local citation building, and geo-targeted optimization for local map visibility.",
  },
  {
    icon: "content",
    title: "Strategic Content Marketing",
    description:
      "Improvements to existing pages, new content creation, and blog support to build topical authority and relevance.",
  },
  {
    icon: "reporting",
    title: "Reporting & Data Access",
    description:
      "Real-time campaign data dashboards and formatted monthly reports delivered to your inbox on the first of every month.",
  },
];

const faqGroups = [
  {
    heading: "About White Label SEO",
    items: [
      {
        question: "What exactly is white label SEO?",
        answer:
          "White label SEO is when you partner with an SEO provider (like us) who delivers SEO services under your agency's brand. Your clients see your branding on reports and communications, and they never know we exist. It lets you offer expert SEO services without hiring in-house or building the infrastructure yourself.",
      },
      {
        question:
          "What's the difference between white label SEO and outsourced SEO?",
        answer:
          "Outsourced SEO is the broader category: any time you pay an external team to do SEO work for your clients. White label SEO is a specific kind of outsourced SEO where everything (reports, dashboards, deliverables) is branded as your agency. Both apply to us. Most of our partners think of it as outsourcing the SEO function while keeping a fully branded experience for their clients.",
      },
      {
        question: "How is this different from reseller SEO packages?",
        answer:
          "Reseller SEO is typically a pre-set package of actions at a fixed price with limited customization and support. White label SEO with SEO Brothers gives you access to a dedicated team, strategic guidance, education, and campaigns tailored to each client's needs. We combine the best of both: the predictability of reseller packages with the strategic depth of a true white-label partnership.",
      },
      {
        question: "Is white label SEO worth it for small agencies?",
        answer:
          "It tends to make the most sense for agencies that already have client relationships and want to add SEO without hiring a specialist. Most of our partners start with one or two campaigns to test the model before scaling. If you're sending one client a year, the math is harder. If you're regularly turning down or referring SEO work, white label is usually the cleanest way to capture that revenue.",
      },
    ],
  },
  {
    heading: "About Partnering With Us",
    items: [
      {
        question: "What kind of margins can I expect?",
        answer:
          "Most of our partners run 50%+ gross service margins on their SEO offerings. We help you price campaigns at a point that makes sense for your business while delivering real value to your clients.",
      },
      {
        question: "Do I need SEO experience to get started?",
        answer:
          "No. That's the point of a true white-label partnership. We provide the SEO expertise, training, and support. Many of our most successful partners came to us with little or no SEO experience. Your account manager helps you understand the process and communicate effectively with your clients.",
      },
      {
        question: "Can I start with just one campaign?",
        answer:
          "Yes. Many of our partners start with a single campaign to test the process before scaling. There's no minimum commitment. Start with one and grow at your own pace.",
      },
      {
        question: "How quickly can we onboard a new client?",
        answer:
          "Most campaigns kick off within a week of the partner ordering through Portal. The onboarding month is structured to capture quick wins early while we build the longer-term strategy.",
      },
      {
        question: "Will you join client calls under our brand?",
        answer:
          "When the situation calls for it, yes. Some partners prefer to keep all client communication in-house and we stay fully behind the scenes. Others bring us into strategy or QBR calls as part of their team. Either model works. We follow your lead on the level of visibility you want.",
      },
      {
        question: "What happens if a client wants to leave?",
        answer:
          "You decide. The work belongs to your agency. If a client cancels, you can pause or cancel the matching campaign on our end through Portal. We don't lock you into long contracts and we don't poach. We've never approached a partner's client.",
      },
      {
        question: "How long before I see results for my clients?",
        answer:
          "SEO is a long-term play, but our onboarding is built around early wins. Most campaigns show meaningful movement in the first 3 to 4 months, with compounding results over time. Your account manager sets clear expectations during the discovery call.",
      },
      {
        question: "What does Portal include?",
        answer:
          "Our self-serve partner portal lets you order new campaigns, manage billing (start, stop, upgrade, downgrade), access real-time campaign data, communicate with your team through our support system, and add team members for collaboration. Everything you need in one place.",
      },
      {
        question: "Do you offer any kind of free trial or audit?",
        answer:
          "We offer unlimited free discovery audits to all partners. These audits are the same quality competitors charge thousands for. They help you identify good-fit campaigns, support your sales process, and close more deals.",
      },
    ],
  },
];
---

<Layout
  title="White Label SEO Services | SEO Brothers"
  description="Partner with SEO Brothers for white label SEO services. No upfront cost, dedicated campaign managers, and 50%+ margins for your agency."
>
  <Nav />

  <!-- ===== HERO ===== -->
  <section class="wl-hero">
    <div class="wl-hero-bg">
      <div class="wl-hero-orb wl-hero-orb--teal"></div>
      <div class="wl-hero-orb wl-hero-orb--purple"></div>
      <div class="wl-hero-orb wl-hero-orb--green"></div>
      <div class="wl-hero-grid"></div>
    </div>

    <div class="wl-hero-content container">
      <div class="wl-hero-badge" data-animate>
        <span class="wl-hero-badge-dot"></span>
        Trusted by 100+ agency partners
      </div>

      <h1 class="wl-hero-title" data-animate>
        White Label SEO<br />
        <span class="wl-hero-title-gradient">Without the Headaches</span>
      </h1>

      <p class="wl-hero-subtitle" data-animate>
        Outsourced SEO for growth-focused agencies. Scale your agency without
        extra hires. We handle your clients' SEO under your brand, with 50%+
        margins for you.
      </p>

      <div class="wl-hero-actions" data-animate>
        <a href="/sign-up" class="btn btn-primary wl-btn-lg">
          Sign Up
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <div class="wl-hero-pills" data-animate>
        <span class="wl-hero-pill">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          No upfront cost
        </span>
        <span class="wl-hero-pill">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Cancel anytime
        </span>
        <span class="wl-hero-pill">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Free discovery audits
        </span>
      </div>
    </div>
  </section>

  <!-- ===== WHAT IS WHITE LABEL SEO ===== -->
  <section class="wl-what">
    <div class="container">
      <div class="wl-what-grid">
        <div class="wl-what-content" data-animate>
          <span class="section-label">More Than a Reseller</span>
          <h2 class="section-heading">
            A True Partnership,<br />
            Not a Reseller Box
          </h2>
          <p class="wl-what-text">
            White Label SEO at SEO Brothers involves a <strong
              >true partnership</strong
            >. We are more than a basic reseller solution. We enable your
            marketing or digital agency to offer and sell organic SEO services to
            your clients without hiring an in-house team or piecing together
            outsourced contractors.
          </p>
          <p class="wl-what-text">
            You deliver high-quality SEO services through your own brand without
            having to do any of the work, oftentimes while still leaving plenty
            of margin for your business.
          </p>
        </div>
        <div class="wl-what-benefits" data-animate>
          <div class="wl-benefit-card">
            <div class="wl-benefit-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                ></path>
              </svg>
            </div>
            <div>
              <h3 class="wl-benefit-title">Fully White-Labeled</h3>
              <p class="wl-benefit-desc">
                Your brand on every report, dashboard, and deliverable. Your
                clients never know we exist.
              </p>
            </div>
          </div>
          <div class="wl-benefit-card">
            <div class="wl-benefit-icon wl-benefit-icon--purple">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"
                ></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <div>
              <h3 class="wl-benefit-title">No Hiring Required</h3>
              <p class="wl-benefit-desc">
                Skip the $50k+ salary, training, and management overhead. Get a
                full SEO team instantly.
              </p>
            </div>
          </div>
          <div class="wl-benefit-card">
            <div class="wl-benefit-icon wl-benefit-icon--green">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                <polyline points="17 6 23 6 23 12"></polyline>
              </svg>
            </div>
            <div>
              <h3 class="wl-benefit-title">50%+ Service Margins</h3>
              <p class="wl-benefit-desc">
                Pricing structured to ensure healthy margins for your agency from
                day one.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PROVEN PROCESS ===== -->
  <section class="wl-process">
    <div class="container">
      <div class="wl-process-header" data-animate>
        <span class="section-label">Proven Campaign Process</span>
        <h2 class="section-heading">
          SEO Brothers' White Label<br />
          Campaign Success Formula
        </h2>
        <p class="section-subtext" style="margin:0 auto;">
          We follow a proven process to ensure you can bring to market a highly
          profitable SEO solution while providing the best value to your clients.
        </p>
      </div>

      <div class="wl-process-timeline">
        <div class="wl-process-line"></div>
        {
          processSteps.map((step) => (
            <div class="wl-process-step" data-animate>
              <div class="wl-process-marker">
                <span class="wl-process-number">{step.number}</span>
              </div>
              <div class="wl-process-step-body">
                <h3 class="wl-process-step-title">{step.title}</h3>
                <p class="wl-process-step-desc">{step.description}</p>
              </div>
            </div>
          ))
        }
      </div>

      <div class="wl-process-cta" data-animate>
        <a href="/sign-up" class="btn btn-primary">
          Sign Up
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== COMPETITIVE APPROACH ===== -->
  <section class="wl-approach">
    <div class="wl-approach-bg">
      <div class="wl-approach-orb wl-approach-orb--1"></div>
      <div class="wl-approach-orb wl-approach-orb--2"></div>
    </div>
    <div class="container">
      <div class="wl-approach-header" data-animate>
        <span class="section-label">How We Operate</span>
        <h2 class="section-heading">
          How We Make Every<br />
          Dollar Count
        </h2>
        <p class="section-subtext" style="margin:0 auto;">
          White-label SEO works when every hour produces value. We use software,
          automation, and a competitor-first prioritization model so every dollar
          your client spends actually moves the campaign forward.
        </p>
      </div>

      <div class="wl-approach-grid" data-stagger>
        <div class="wl-approach-card" data-animate>
          <div class="wl-approach-icon wl-approach-icon--teal">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="22" y1="12" x2="18" y2="12"></line>
              <line x1="6" y1="12" x2="2" y2="12"></line>
              <line x1="12" y1="6" x2="12" y2="2"></line>
              <line x1="12" y1="22" x2="12" y2="18"></line>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </div>
          <h3 class="wl-approach-card-title">Close the Gap to #1</h3>
          <p class="wl-approach-card-desc">
            Every campaign starts with a clear question: what's already
            ranking, and what do they have? If a competitor has better content,
            we need better content. More links, more links. Better page speed,
            better page speed.
          </p>
          <p class="wl-approach-card-desc">
            But we don't chase what isn't moving the needle. If we're at a B
            for page speed and the top rankers are at C and D, page speed isn't
            the differentiator. We deprioritize and put the time where it
            actually counts.
          </p>
        </div>

        <div class="wl-approach-card" data-animate>
          <div class="wl-approach-icon wl-approach-icon--purple">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
          </div>
          <h3 class="wl-approach-card-title">
            Approvals Built Into the Portal
          </h3>
          <p class="wl-approach-card-desc">
            We don't email for permission on every change. Set partner-level
            rules once. Set campaign-level rules per client. Then we move.
          </p>
          <p class="wl-approach-card-desc">
            Need approval on certain types of work? Set it once and it routes
            through Portal. Want full freedom for the team to optimize as
            needed? Set that too. The system flexes to your team's preference,
            not the other way around.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CAMPAIGN COMPONENTS ===== -->
  <section class="wl-components">
    <div class="container">
      <div class="wl-components-header" data-animate>
        <span class="section-label">What's Included</span>
        <h2 class="section-heading">
          White Label SEO<br />
          Campaign Components
        </h2>
        <p class="section-subtext" style="margin:0 auto;">
          We combine essential SEO components with quality reporting and the
          ability to scale each campaign up and down as needed.
        </p>
      </div>

      <div class="wl-components-grid" data-stagger>
        {
          components.map((comp, i) => (
            <div class="wl-comp-card" data-animate>
              <div
                class={`wl-comp-icon wl-comp-icon--${i % 3 === 0 ? "teal" : i % 3 === 1 ? "purple" : "green"}`}
              >
                {comp.icon === "strategy" && (
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                  </svg>
                )}
                {comp.icon === "keywords" && (
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                  </svg>
                )}
                {comp.icon === "onpage" && (
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                  </svg>
                )}
                {comp.icon === "technical" && (
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="16 18 22 12 16 6" />
                    <polyline points="8 6 2 12 8 18" />
                  </svg>
                )}
                {comp.icon === "links" && (
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                  </svg>
                )}
                {comp.icon === "local" && (
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                )}
                {comp.icon === "content" && (
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                  </svg>
                )}
                {comp.icon === "reporting" && (
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="20" x2="18" y2="10" />
                    <line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                    <line x1="2" y1="20" x2="22" y2="20" />
                  </svg>
                )}
              </div>
              <h3 class="wl-comp-title">{comp.title}</h3>
              <p class="wl-comp-desc">{comp.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== PARTNER PORTAL ===== -->
  <section class="wl-portal">
    <div class="wl-portal-bg">
      <div class="wl-portal-orb wl-portal-orb--1"></div>
      <div class="wl-portal-orb wl-portal-orb--2"></div>
    </div>
    <div class="container">
      <div class="wl-portal-content" data-animate>
        <span class="section-label section-label--light"
          >Partner Portal</span
        >
        <h2 class="section-heading section-heading--light">
          Manage Everything<br />
          From One Place
        </h2>
        <p class="section-subtext section-subtext--light">
          Our self-serve partner portal takes the hassle out of ordering
          campaigns, getting support, and having visibility on existing
          campaigns.
        </p>
      </div>

      <div class="wl-portal-grid" data-stagger>
        <div class="wl-portal-feature" data-animate>
          <div class="wl-portal-feature-icon">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <rect x="1" y="4" width="22" height="16" rx="2" ry="2"
              ></rect>
              <line x1="1" y1="10" x2="23" y2="10"></line>
            </svg>
          </div>
          <h3 class="wl-portal-feature-title">Order & Manage Billing</h3>
          <p class="wl-portal-feature-desc">
            Order white label SEO campaigns and projects. Start, stop,
            upgrade, or downgrade with self-serve billing.
          </p>
        </div>

        <div class="wl-portal-feature" data-animate>
          <div class="wl-portal-feature-icon">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
