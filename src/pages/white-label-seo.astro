---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import GrowthCallEmbed from "../components/GrowthCallEmbed.astro";

const processSteps = [
  {
    number: "01",
    title: "World-Class Free Discovery",
    description:
      "We offer free audits that others charge thousands for. We identify opportunities, assess competition, and support your sales efforts before you commit to anything. No other white-label provider offers this.",
  },
  {
    number: "02",
    title: "Strategic Onboarding",
    description:
      "Every campaign starts with a strategic onboard that lays the foundation: priorities, quick wins, and a clear roadmap. Your account manager walks you through every detail.",
  },
  {
    number: "03",
    title: "Execute & Optimize",
    description:
      "On-page optimizations, content marketing, technical improvements, link acquisition, and more, all driven by the strategic plan for each campaign.",
  },
  {
    number: "04",
    title: "Review & Pivot",
    description:
      "Reviews happen on whatever cadence each campaign needs. We compare performance to plan, look at what competitors have shifted, and adjust priorities so we're always pointed at the gap that's actually limiting growth.",
  },
  {
    number: "05",
    title: "Reports & Dashboards",
    description:
      "White-label branded reports and real-time data dashboards you can reference any time. Always know what's happening across every campaign.",
  },
];

const components = [
  {
    icon: "strategy",
    title: "Onboarding & Priority Intents",
    description:
      "Every campaign starts with strategic onboarding that sets the Priority Intents we'll be chasing and captures the early quick wins.",
  },
  {
    icon: "keywords",
    title: "Keyword Research & Mapping",
    description:
      "Deep keyword research and competitor analysis. Understanding what's ranking, where the gaps are, and mapping target keywords to the pages best positioned to win them.",
  },
  {
    icon: "onpage",
    title: "SEO Initiatives",
    description:
      "Specialist time on the next most important thing for the site: geo and service pages, on-page work, page speed, and technical improvements. The proactive work, not just fixing crawl errors.",
  },
  {
    icon: "technical",
    title: "Health & Crawl Score",
    description:
      "A monthly health and crawl-score check that catches and fixes errors: broken links, canonical and indexation issues, and crawl blockers. Proactive technical work like page speed is part of SEO initiatives.",
  },
  {
    icon: "links",
    title: "Link Building & Digital PR",
    description:
      "Quality link building from authoritative, relevant sources with balanced anchor text, plus digital PR placements that earn high-authority backlinks.",
  },
  {
    icon: "local",
    title: "GBP & Local SEO",
    description:
      "Strategic Google Business Profile improvements, local citation building with consistent business details across listings, and geo-targeted optimization for local search.",
  },
  {
    icon: "content",
    title: "Authority Content",
    description:
      "Blog and authority content that keeps the site fresh and builds topical authority in the space. Usually one, sometimes two pieces a month depending on the size of the site.",
  },
  {
    icon: "ai",
    title: "AI Search Optimization",
    description:
      "Tracking visibility across AI Overviews, ChatGPT, Perplexity, and Gemini. Structuring content for LLM citation. Monitoring where your client shows up across AI surfaces, not just traditional rankings.",
  },
  {
    icon: "reporting",
    title: "Reporting & Data Access",
    description:
      "Real-time campaign data dashboards and formatted monthly reports delivered to your inbox on the first of every month.",
  },
];

const faqGroups = [
  {
    heading: "About White Label SEO",
    items: [
      {
        question: "What exactly is white label SEO?",
        answer:
          "White label SEO is when you partner with an SEO provider (like us) who delivers SEO services under your agency's brand. Your clients see your branding on reports and communications, and they never know we exist. It lets you offer expert SEO services without hiring in-house or building the infrastructure yourself.",
      },
      {
        question:
          "What's the difference between white label SEO and outsourced SEO?",
        answer:
          "Outsourced SEO is the broader category: any time you pay an external team to do SEO work for your clients. White label SEO is a specific kind of outsourced SEO where everything (reports, dashboards, deliverables) is branded as your agency. Both apply to us. Most of our partners think of it as outsourcing the SEO function while keeping a fully branded experience for their clients.",
      },
      {
        question: "How is this different from reseller SEO packages?",
        answer:
          "Reseller SEO is typically a pre-set package of actions at a fixed price with limited customization and support. White label SEO with SEO Brothers gives you access to a dedicated team, strategic guidance, education, and campaigns tailored to each client's needs. We combine the best of both: the predictability of reseller packages with the strategic depth of a true white-label partnership.",
      },
      {
        question: "Is white label SEO worth it for small agencies?",
        answer:
          "It tends to make the most sense for agencies that already have client relationships and want to add SEO without hiring a specialist. Most of our partners start with one or two campaigns to test the model before scaling. If you're sending one client a year, the math is harder. If you're regularly turning down or referring SEO work, white label is usually the cleanest way to capture that revenue.",
      },
      {
        question:
          "Do you handle SEO for AI search and Google AI Overviews?",
        answer:
          "Yes. AI surfaces (Google AI Overviews, ChatGPT, Perplexity, Gemini) increasingly send traffic alongside traditional rankings, and the playbook is still evolving. We handle AI surfaces the same way we've always handled algorithm shifts: track them closely, test what works, fold the proven plays in. Concretely, that means structured content answer engines can cite, entity markup that helps LLMs understand who the brand is, and ongoing monitoring of where each client shows up across AI responses. It's part of every campaign, not a separate add-on.",
      },
      {
        question: "How is white label SEO different from outsourcing or freelancers?",
        answer:
          "The work is similar but the model is different. A freelancer works for you on a project-by-project basis, often with their own brand visible. Outsourcing is the broad category. White label SEO is a structured partnership where everything client-facing carries your brand. The benefit over freelancers is predictability and capacity. The benefit over hiring is variable cost and no management overhead.",
      },
    ],
  },
  {
    heading: "About Partnering With Us",
    items: [
      {
        question: "What kind of margins can I expect?",
        answer:
          "Most of our partners run 50%+ gross service margins on their SEO offerings. We help you price campaigns at a point that makes sense for your business while delivering real value to your clients.",
      },
      {
        question: "Do I need SEO experience to get started?",
        answer:
          "No. That's the point of a true white-label partnership. We provide the SEO expertise, training, and support. Many of our most successful partners came to us with little or no SEO experience. Your account manager helps you understand the process and communicate effectively with your clients.",
      },
      {
        question: "Can I start with just one campaign?",
        answer:
          "Yes. Many of our partners start with a single campaign to test the process before scaling. There's no minimum commitment. Start with one and grow at your own pace.",
      },
      {
        question: "How quickly can we onboard a new client?",
        answer:
          "Most campaigns kick off within a week of the partner ordering through Portal. The onboarding month is structured to capture quick wins early while we build the longer-term strategy.",
      },
      {
        question: "Will you join client calls under our brand?",
        answer:
          "When the situation calls for it, yes. Some partners prefer to keep all client communication in-house and we stay fully behind the scenes. Others bring us into strategy or QBR calls as part of their team. Either model works. We follow your lead on the level of visibility you want.",
      },
      {
        question: "What happens if a client wants to leave?",
        answer:
          "You decide. The work belongs to your agency. If a client cancels, you can pause or cancel the matching campaign on our end through Portal. We don't lock you into long contracts and we don't poach. We've never approached a partner's client.",
      },
      {
        question: "Who owns the content and links created during a campaign?",
        answer:
          "Your agency. The content we publish, the optimizations we run, and the backlinks we acquire all belong to your client's site and your agency's relationship with that client. If a partnership ever ends, you keep the work. We don't reclaim links, we don't strip content, and we don't approach the client.",
      },
      {
        question: "What if a campaign isn't performing?",
        answer:
          "First, we figure out why. Strategic reviews exist for exactly this. We compare actual performance to the plan, look at what competitors have shifted, and re-set the Priority Intents if needed. SEO is a long game, but a campaign that isn't moving after 4 to 6 months usually has a specific cause: wrong intent targeting, undercompetitive link velocity, technical drag, or budget set below what the competition demands. Your account manager will walk you through what we see and what the options are.",
      },
      {
        question: "How long before I see results for my clients?",
        answer:
          "SEO is a long-term play, but our onboarding is built around early wins. Most campaigns show meaningful movement in the first 3 to 4 months, with compounding results over time. Your account manager sets clear expectations during the discovery call.",
      },
      {
        question: "What does Portal include?",
        answer:
          "Our self-serve partner portal lets you order new campaigns, manage billing (start, stop, upgrade, downgrade), access real-time campaign data, communicate with your team through our support system, and add team members for collaboration. Everything you need in one place.",
      },
      {
        question: "Do you offer any kind of free trial or audit?",
        answer:
          "We offer unlimited free discovery audits to all partners. These audits are the same quality competitors charge thousands for. They help you identify good-fit campaigns, support your sales process, and close more deals.",
      },
    ],
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqGroups.flatMap((group) =>
    group.items.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  ),
};
---

<Layout
  title="White Label SEO Services for Agencies | SEO Brothers"
  description="White label SEO services for growth-focused agencies. Deliver SEO under your brand with dedicated account managers, free discovery audits, and 50%+ margins."
  schema={faqSchema}
>
  <Nav />

  <!-- ===== HERO ===== -->
  <section class="wl-hero">
    <div class="wl-hero-bg">
      <div class="wl-hero-orb wl-hero-orb--teal"></div>
      <div class="wl-hero-orb wl-hero-orb--purple"></div>
      <div class="wl-hero-orb wl-hero-orb--green"></div>
      <div class="wl-hero-grid"></div>
    </div>

    <div class="wl-hero-content container">
      <div class="wl-hero-badge" data-animate>
        <span class="wl-hero-badge-dot"></span>
        Trusted by 100+ agency partners
      </div>

      <h1 class="wl-hero-title" data-animate>
        <span class="wl-hero-title-line">White Label SEO Services</span><br />
        <span class="wl-hero-title-gradient">Without the Headaches</span>
      </h1>

      <p class="wl-hero-subtitle" data-animate>
        Outsourced SEO for growth-focused agencies. Scale your agency without
        extra hires. We handle your clients' SEO under your brand, with 50%+
        margins for you.
      </p>

      <div class="wl-hero-actions" data-animate>
        <a href="/partner-package/" class="btn btn-primary wl-btn-lg">
          Get Access
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <div class="wl-hero-pills" data-animate>
        <span class="wl-hero-pill">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          No upfront cost
        </span>
        <span class="wl-hero-pill">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Cancel anytime
        </span>
        <span class="wl-hero-pill">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Free discovery audits
        </span>
      </div>
    </div>
  </section>

  <!-- ===== WHAT IS WHITE LABEL SEO ===== -->
  <section class="wl-what">
    <div class="container">
      <div class="wl-what-content" data-animate>
        <span class="section-label">SEO Basics</span>
        <h2 class="section-heading">What Is White Label SEO?</h2>

        <p class="wl-what-text">
          White label SEO is the model where a specialist provider does the
          SEO work and a partner agency delivers it to the end client under
          its own brand. The agency owns the relationship, the strategy
          conversations, and the reporting. The provider runs the actual
          search engine optimization in the background. The client sees one
          brand, one invoice, one point of contact.
        </p>
        <p class="wl-what-text">
          For a marketing agency or digital agency, the point is simple. You
          can offer SEO services without building and managing an in-house
          team. You sell what your clients are already asking for, you keep
          the margin, and you don't take on the overhead of hiring SEO
          experts, buying tools, and managing fulfillment yourself.
        </p>

        <h3 class="wl-what-subhead">How White Label SEO Works in Practice</h3>
        <p class="wl-what-text">
          Most partnerships follow the same shape. The agency brings a client
          need, the white label SEO provider runs a discovery, both teams
          align on scope and pricing, and then delivery starts under the
          agency's brand. Reports come back in agency colors. Dashboards live
          at agency URLs. Communication routes through the agency's account
          team.
        </p>
        <p class="wl-what-text">
          What changes between providers is the depth of partnership. Some
          operate like a vending machine: order a package, get a deliverable.
          Others (us included) operate like an extension of your team, with
          named account managers, strategy calls, and direct access when
          something complicated comes up.
        </p>

        <h3 class="wl-what-subhead">What's Usually Included</h3>
        <p class="wl-what-text">
          A full white label SEO partnership covers the work an in-house SEO
          team would handle:
        </p>
        <ul class="wl-what-list">
          <li><a href="/guides/keyword-research/">Keyword research</a> and mapping</li>
          <li>Technical SEO and on-page optimization</li>
          <li>Content production for new and existing pages</li>
          <li><a href="/guides/link-building/">Link building</a> from authoritative, relevant sources</li>
          <li><a href="/guides/local-seo/">Local SEO</a> and Google Business Profile management</li>
          <li>Reporting and live dashboards</li>
        </ul>
        <p class="wl-what-text">
          Some agencies use white label for the full stack. Others bring us in
          only for the parts they don't want to build, usually link building
          and content. Both work.
        </p>

        <h3 class="wl-what-subhead">Who White Label SEO Is For</h3>
        <p class="wl-what-text">
          The model fits agencies that already have client relationships and
          want to add SEO without hiring. That's a broad set:
        </p>
        <ul class="wl-what-list">
          <li>Marketing and digital agencies adding SEO to existing service offerings</li>
          <li>Web design and development shops whose clients keep asking about ranking</li>
          <li>PR firms and content agencies looking to bundle organic search</li>
          <li>Solo consultants who don't want to be the bottleneck on delivery</li>
        </ul>
        <p class="wl-what-text">
          The campaigns underneath span the same variety: local service
          businesses, SaaS, eCommerce, and national B2B. Each needs a
          different prioritization, but the underlying model is the same. It
          tends not to fit anyone sending one campaign a year. The math works
          once you have a couple of clients, and it scales cleanly from there.
        </p>

        <h3 class="wl-what-subhead">
          White Label SEO vs. Outsourced SEO vs. Reseller SEO
        </h3>
        <p class="wl-what-text">
          These terms get used interchangeably and they shouldn't be.
        </p>
        <p class="wl-what-text">
          <strong>Outsourced SEO</strong> is the broad category. Any time an
          agency pays an external team to do SEO work for clients, that's
          outsourcing. The relationship can be public or private.
        </p>
        <p class="wl-what-text">
          <strong>White label SEO</strong> is a specific kind of outsourcing
          where everything client-facing carries the agency's brand. Reports,
          dashboards, deliverables, and sometimes the calls themselves. The
          provider stays invisible.
        </p>
        <p class="wl-what-text">
          <strong>Reseller SEO</strong> is usually a pre-set package at a
          fixed price with limited customization. Cheaper, faster to order,
          lighter on strategy. Good if you need volume and consistency, less
          good if your clients need real strategic depth.
        </p>
        <p class="wl-what-text">
          We sit in the white label category but operate more like a partner
          than a reseller. The packages on this page have predictable pricing,
          but every campaign gets a real strategy and a real account manager.
          That's the part most reseller models leave out.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== SPECIALTIES (hub -> spokes) ===== -->
  <section class="wl-specialties">
    <div class="container">
      <div class="wl-specialties-header" data-animate>
        <span class="section-label">Specialties</span>
        <h2 class="section-heading">White label SEO, by focus area</h2>
        <p class="section-subtext" style="margin:0 auto;">
          Local is our core, but partners resell us across the board. Each of
          these is delivered under your brand.
        </p>
      </div>
      <div class="wl-specialties-grid" data-stagger>
        {[
          { href: "/white-label-seo/local/", name: "Local SEO", desc: "Map pack, Google Business Profile, and local content for service-area clients." },
          { href: "/white-label-seo/link-building/", name: "Link Building", desc: "Editorial links and our Publishing House, built safely under your brand." },
          { href: "/white-label-seo/ecommerce/", name: "Ecommerce SEO", desc: "Category, product, and faceted-nav SEO for online stores." },
          { href: "/white-label-seo/enterprise/", name: "Enterprise SEO", desc: "Large, complex portfolios and the reporting that satisfies stakeholders." },
          { href: "/white-label-seo/ai-seo/", name: "AI SEO", desc: "Getting your clients cited in AI Overviews, ChatGPT, and Perplexity." },
        ].map((s) => (
          <a href={s.href} class="wl-specialty" data-animate>
            <h3 class="wl-specialty-name">{s.name}</h3>
            <p class="wl-specialty-desc">{s.desc}</p>
            <span class="wl-specialty-cta">
              Explore
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== ROLES (RESELLER VS PROVIDER) ===== -->
  <section class="wl-roles">
    <div class="container">
      <div class="wl-roles-header" data-animate>
        <span class="section-label">Who Does What</span>
        <h2 class="section-heading">Reseller vs. Provider</h2>
        <p class="section-subtext" style="margin:0 auto;">
          A white label SEO partnership splits the work in two. Understanding
          who owns what saves a lot of back-and-forth later.
        </p>
      </div>

      <div class="wl-roles-grid" data-stagger>
        <div class="wl-role-card" data-animate>
          <span class="wl-role-tag">The Reseller</span>
          <h3 class="wl-role-who">Your Agency</h3>
          <p class="wl-role-desc">
            Sales, account ownership, billing the client, and most day-to-day
            client communication. You're the brand. You're the relationship.
          </p>
        </div>
        <div class="wl-role-card wl-role-card--provider" data-animate>
          <span class="wl-role-tag">The Provider</span>
          <h3 class="wl-role-who">SEO Brothers</h3>
          <p class="wl-role-desc">
            Strategy, fulfillment, quality control, and reporting. We work
            behind the scenes, deliver under your brand, and stay close
            enough to your team to answer the harder questions when they
            come up.
          </p>
        </div>
      </div>

      <p class="wl-roles-footer" data-animate>
        The cleaner the split, the easier the partnership runs. We've worked
        with agencies that want us fully behind the scenes and never on a
        client call. We've worked with others that want us on QBRs as "their
        senior strategist." Both models work. The wrong model is the one
        where neither side knows whose job it is to spot a problem.
      </p>
    </div>
  </section>

  <!-- ===== WHY AGENCIES USE WL SEO ===== -->
  <section class="wl-why">
    <div class="container">
      <div class="wl-why-header" data-animate>
        <span class="section-label">Why It Works</span>
        <h2 class="section-heading">
          Why Agencies Use<br />
          White Label SEO
        </h2>
      </div>

      <div class="wl-why-grid" data-stagger>
        <div class="wl-why-card" data-animate>
          <div class="wl-why-icon wl-why-icon--teal">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"></line>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3 class="wl-why-title">Cash flow flexibility, not a fixed team cost</h3>
          <p class="wl-why-desc">
            White label SEO is a variable cost. You flex up when you sign
            clients and flex down when a campaign ends. An in-house team is
            a fixed cost that keeps drawing salary whether your campaigns
            are billing or not, which ties your cash flow directly to your
            client roster. White label moves salary, benefits, and tooling
            off your balance sheet and turns them into a line item that
            scales with revenue.
          </p>
        </div>

        <div class="wl-why-card" data-animate>
          <div class="wl-why-icon wl-why-icon--purple">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="8.5" cy="7" r="4"></circle>
              <polyline points="17 11 19 13 23 9"></polyline>
            </svg>
          </div>
          <h3 class="wl-why-title">Specialized expertise without the hiring lift</h3>
          <p class="wl-why-desc">
            SEO has gotten more specialized, not less. Keyword research,
            technical fixes, link acquisition, content production, and AI
            search optimization each lean on different skill sets, and good
            people in each are expensive and hard to find. A white label SEO
            partner gives you a full team on day one. You don't manage them,
            you don't train them, and you don't lose three months when one
            of them leaves.
          </p>
        </div>

        <div class="wl-why-card" data-animate>
          <div class="wl-why-icon wl-why-icon--green">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="13 17 18 12 13 7"></polyline>
              <polyline points="6 17 11 12 6 7"></polyline>
            </svg>
          </div>
          <h3 class="wl-why-title">Speed to market</h3>
          <p class="wl-why-desc">
            Adding SEO to your service catalog in-house is a multi-quarter
            project. Hire, onboard, build process, buy tools, build reports.
            A white label partnership compresses that to weeks. You can
            quote the next prospect that asks about SEO without waiting for
            any of the buildout.
          </p>
        </div>

        <div class="wl-why-card" data-animate>
          <div class="wl-why-icon wl-why-icon--teal">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
              <polyline points="17 6 23 6 23 12"></polyline>
            </svg>
          </div>
          <h3 class="wl-why-title">Predictable wholesale pricing, healthy margins</h3>
          <p class="wl-why-desc">
            Our pricing is wholesale and predictable so your packages can be
            predictable too. Most partners run 50%+ gross service margins on
            their SEO offerings, with room to undercut competitors or upsell
            strategically depending on the market.
          </p>
        </div>

        <div class="wl-why-card" data-animate>
          <div class="wl-why-icon wl-why-icon--purple">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="wl-why-title">Your brand, your relationship</h3>
          <p class="wl-why-desc">
            Reports, dashboards, and deliverables ship under your brand. We
            don't approach your clients, we don't show up in their inbox,
            and the work belongs to your agency. If a partnership ever ends,
            your clients stay with you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== MID-PAGE CTA ===== -->
  <section class="wl-mid-cta">
    <div class="container">
      <div class="wl-mid-cta-card" data-animate>
        <h2 class="wl-mid-cta-title">See it on your client's site first</h2>
