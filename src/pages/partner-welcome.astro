---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

// Destination the partner opt-in (/partner-package/) redirects to on success.
// Holds the unlocked package: book with Mike, walkthrough videos, request an
// audit. noindex: post-opt-in page, not for search. It's reachable directly
// (the opt-in is a soft gate for lead capture, not hard security), which is fine.
//
// ⚙️ CONFIG — Devon:
//   videos[].url: drop the Loom share URLs in. Until a video has a url it
//     renders as a "coming soon" placeholder card.
//   sampleReportUrl: link to a downloadable/hosted sample white-label report.
//     Empty string => card invites them to ask Mike for samples on the call.
const calendlyUrl = "https://calendly.com/mike-2473/mike-s-good-fit-demo";
const sampleReportUrl = "";

interface Video {
  title: string;
  description: string;
  url?: string;
}
const videos: Video[] = [
  {
    title: "Discovery in Portal",
    description:
      "How our free discovery audits and findings show up for you and your client inside the Portal.",
  },
  {
    title: "Campaigns in Portal",
    description:
      "Managing live campaigns, priorities, and progress, all under your brand.",
  },
  {
    title: "Action items & White Label Features",
    description:
      "Action items, reporting, and the white-label controls your clients never see our name on.",
  },
];
---

<Layout
  title="Your partner package | SEO Brothers"
  description="Welcome to the SEO Brothers partner package: book a walkthrough, watch how the Portal works, or request a free audit for a prospect."
  noindex={true}
>
  <Nav variant="light" hideCta={true} />

  <section class="pw">
    <div class="pw__bg">
      <div class="pw__orb pw__orb--1"></div>
      <div class="pw__orb pw__orb--2"></div>
    </div>

    <div class="container pw__inner">
      <div class="pw__head">
        <span class="section-label">You're in</span>
        <h1 class="pw__title">Welcome to the partner package</h1>
        <p class="pw__lede">
          Here's everything in one place. Book a walkthrough with Mike, see how
          the Portal works for you and your clients, and grab a free audit for a
          prospect whenever you need one.
        </p>
      </div>

      <!-- Primary action: book the demo with Mike (Calendly embed) -->
      <section class="pw__book">
        <h2 class="pw__book-title">Book your demo with Mike</h2>
        <p class="pw__book-desc">
          A real conversation about how we'd work together under your brand, no
          slide-deck pitch. Grab a time that works below.
        </p>
        <iframe
          class="pw__calendly"
          src={`${calendlyUrl}?hide_gdpr_banner=1`}
          title="Book a demo with Mike"
          loading="lazy"></iframe>
      </section>

      <!-- Walkthrough videos -->
      <h2 class="pw__videos-title">Watch how it works</h2>
      <div class="pw__videos">
        {videos.map((v) => (
          <article class="pw__video">
            {v.url ? (
              <a class="pw__video-thumb pw__video-thumb--ready" href={v.url} target="_blank" rel="noopener noreferrer" aria-label={`Watch: ${v.title}`}>
                <span class="pw__video-play" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
              </a>
            ) : (
              <div class="pw__video-thumb">
                <span class="pw__video-play" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
                <span class="pw__video-soon">Coming soon</span>
              </div>
            )}
            <h3 class="pw__video-title">{v.title}</h3>
            <p class="pw__video-desc">{v.description}</p>
          </article>
        ))}
      </div>

      <!-- Sample reports + pricing (the rest of what the gate promised) -->
      <div class="pw__extras">
        <div class="pw__extra">
          <div class="pw__extra-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <h3 class="pw__extra-title">Sample white-label reports</h3>
          <p class="pw__extra-desc">The exact branded reporting your clients receive, with our name nowhere on it.</p>
          {sampleReportUrl ? (
            <a class="pw__extra-link" href={sampleReportUrl} target="_blank" rel="noopener noreferrer">View a sample
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
            </a>
          ) : (
            <span class="pw__extra-note">Mike will share live samples on your call.</span>
          )}
        </div>

        <div class="pw__extra">
          <div class="pw__extra-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3 class="pw__extra-title">Partner pricing</h3>
          <p class="pw__extra-desc">Our wholesale rate card and à la carte options, so you can build real margin into what you resell.</p>
          <a class="pw__extra-link" href="/pricing/">See partner pricing
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
        </div>
      </div>

      <!-- Single next step: into the Portal (where discoveries live) -->
      <div class="pw__portal">
        <span class="pw__portal-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        </span>
        <p>
          Prefer to dive in? <a href="/sign-up/">Set up a Portal account</a> to
          follow along and request a free discovery whenever you're ready. No
          commitment.
        </p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .pw {
    position: relative;
    padding: 150px 0 110px;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    overflow: hidden;
  }
  .pw__bg { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .pw__orb { position: absolute; border-radius: 50%; filter: blur(120px); opacity: 0.22; }
  .pw__orb--1 { width: 460px; height: 460px; top: -120px; left: -140px; background: var(--teal); }
  .pw__orb--2 { width: 420px; height: 420px; bottom: -160px; right: -120px; background: var(--purple); }
  .pw__inner { position: relative; z-index: 1; max-width: 1000px; margin: 0 auto; }

  .pw__head { text-align: center; max-width: 620px; margin: 0 auto 40px; }
  .pw__head .section-label { display: inline-block; }
  .pw__title { font-family: var(--font-display); font-size: clamp(32px, 5vw, 48px); font-weight: 700; letter-spacing: -0.02em; color: var(--text-primary); margin: 10px 0 14px; }
  .pw__lede { font-size: 18px; line-height: 1.7; color: var(--text-secondary); }

  /* Book with Mike (Calendly embed) */
  .pw__book {
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl); padding: 28px 28px 12px; margin-bottom: 56px;
    box-shadow: var(--shadow-md);
  }
  .pw__book-title { font-family: var(--font-display); font-size: 22px; font-weight: 700; color: var(--text-primary); margin-bottom: 6px; letter-spacing: -0.01em; }
  .pw__book-desc { font-size: 15px; line-height: 1.6; color: var(--text-secondary); margin: 0 0 18px; max-width: 640px; }
  .pw__calendly { width: 100%; min-height: 720px; border: 0; border-radius: var(--radius-md); display: block; }

  /* Videos */
  .pw__videos-title { font-family: var(--font-display); font-size: 22px; font-weight: 700; letter-spacing: -0.01em; color: var(--text-primary); margin-bottom: 20px; }
  .pw__videos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-bottom: 48px; }
  .pw__video-thumb {
    position: relative; display: flex; align-items: center; justify-content: center;
    aspect-ratio: 16 / 9; border-radius: var(--radius-md); margin-bottom: 14px; overflow: hidden;
    background:
      radial-gradient(circle at 30% 30%, rgba(40,165,177,0.25), transparent 60%),
      radial-gradient(circle at 70% 70%, rgba(140,99,170,0.25), transparent 60%),
      var(--dark);
    border: 1px solid var(--border-light);
  }
  .pw__video-play {
    width: 52px; height: 52px; border-radius: 50%;
    background: rgba(255,255,255,0.92); color: var(--dark);
    display: flex; align-items: center; justify-content: center; padding-left: 3px;
    transition: transform var(--transition);
  }
  .pw__video-thumb--ready { cursor: pointer; }
  .pw__video-thumb--ready:hover .pw__video-play { transform: scale(1.08); }
  .pw__video-soon {
    position: absolute; top: 10px; right: 10px;
    font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--white); background: rgba(255,255,255,0.16); border: 1px solid rgba(255,255,255,0.25);
    padding: 3px 9px; border-radius: var(--radius-full); backdrop-filter: blur(4px);
  }
  .pw__video-title { font-family: var(--font-display); font-size: 16px; font-weight: 600; color: var(--text-primary); margin-bottom: 6px; }
  .pw__video-desc { font-size: 14px; line-height: 1.6; color: var(--text-secondary); }

  /* Sample reports + pricing */
  .pw__extras { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 48px; }
  .pw__extra {
    display: flex; flex-direction: column;
    background: var(--white); border: 1px solid var(--border-light);
    border-radius: var(--radius-lg); padding: 26px;
  }
  .pw__extra-icon { width: 44px; height: 44px; border-radius: 50%; background: rgba(140,99,170,0.1); color: var(--purple); display: flex; align-items: center; justify-content: center; margin-bottom: 14px; }
  .pw__extra-title { font-family: var(--font-display); font-size: 17px; font-weight: 600; color: var(--text-primary); margin-bottom: 8px; }
  .pw__extra-desc { font-size: 14px; line-height: 1.6; color: var(--text-secondary); margin-bottom: 16px; flex-grow: 1; }
  .pw__extra-link { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: var(--teal); transition: gap var(--transition); margin-top: auto; }
  .pw__extra-link:hover { gap: 12px; }
  .pw__extra-note { font-size: 13px; color: var(--text-muted); font-style: italic; margin-top: auto; }

  /* Single next step: portal */
  .pw__portal {
    display: flex; align-items: center; gap: 14px;
    background: var(--light); border: 1px solid var(--border-light);
    border-radius: var(--radius-lg); padding: 20px 24px;
  }
  .pw__portal p { font-size: 15px; line-height: 1.6; color: var(--text-secondary); margin: 0; }
  .pw__portal a { color: var(--teal-dark); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .pw__portal-icon {
    flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%;
    background: rgba(40,165,177,0.1); color: var(--teal);
    display: flex; align-items: center; justify-content: center;
  }

  @media (max-width: 860px) {
    .pw { padding: 120px 0 80px; }
    .pw__calendly { min-height: 1000px; }
    .pw__videos { grid-template-columns: 1fr; }
    .pw__extras { grid-template-columns: 1fr; }
  }
</style>
