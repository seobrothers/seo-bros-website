---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PackageBuilder from "../components/PackageBuilder.astro";

// The unlocked partner page (destination of the /partner-package/ opt-in). What
// the gate promised: request a world-class free discovery (for you or a client),
// book a walkthrough with Mike, watch how it works, grab case studies + reports,
// and build a custom package with real numbers. noindex: post-opt-in, not for
// search. Reachable directly (the gate is soft lead-capture, not hard security).
//
// ⚙️ CONFIG — Devon:
//   videos[].url: drop the share URLs in. No url => "coming soon" placeholder.
//   downloads[].url: link a hosted PDF/report. No url => "coming soon" note.
const calendlyUrl = "https://calendly.com/mike-2473/mike-s-good-fit-demo";

interface Video {
  title: string;
  description: string;
  url?: string;
}
const videos: Video[] = [
  {
    title: "World Class Free Discovery",
    description:
      "How our free discovery audits and findings show up for you and your client inside the Portal.",
    url: "https://youtu.be/b-z9A3s7T3I",
  },
  {
    title: "Campaigns in Portal",
    description:
      "Managing live campaigns, priorities, and progress, all under your brand.",
  },
  {
    title: "Action items & White Label Features",
    description:
      "Action items, reporting, and the white-label controls your clients never see our name on.",
  },
];

interface Download {
  title: string;
  description: string;
  url?: string;
}
const downloads: Download[] = [
  {
    title: "Sample white-label report",
    description:
      "The exact branded reporting your clients receive, with our name nowhere on it.",
  },
  {
    title: "Case study: local services",
    description:
      "A home-services client from launch to local-pack dominance, with the numbers.",
  },
  {
    title: "Case study: multi-location",
    description:
      "How we scale rankings across territories for a multi-location brand.",
  },
];
---

<Layout
  title="Your partner package | SEO Brothers"
  description="Your unlocked SEO Brothers partner package: request a free discovery, book a walkthrough with Mike, watch how it works, grab case studies, and build a custom package."
  noindex={true}
>
  <Nav variant="light" hideCta={true} />

  <section class="pw">
    <div class="pw__bg">
      <div class="pw__orb pw__orb--1"></div>
      <div class="pw__orb pw__orb--2"></div>
    </div>

    <div class="container pw__inner">
      <div class="pw__head">
        <span class="section-label">You're in</span>
        <h1 class="pw__title">Your partner package</h1>
        <p class="pw__lede">
          Everything in one place. Request a world-class free discovery for your
          own site or a prospect's, book a walkthrough with Mike, see how it
          works, and build a custom package with real numbers below.
        </p>
      </div>

      <!-- ─── Free discovery (form) + book Mike (Calendly), side by side ─── -->
      <div class="pw__top">
        <section class="pw__disco">
          <h2 class="pw__card-title">Get a free discovery</h2>
          <p class="pw__card-desc">
            For you or a client's site. We run a world-class discovery others
            charge thousands for, then walk you through what we'd do.
          </p>

          <form class="pw__form" id="discovery-form" novalidate>
            <div class="pw__hp" aria-hidden="true">
              <label>Phone<input type="text" name="phoneNumber" tabindex="-1" autocomplete="off" /></label>
            </div>
            <div class="pw__field">
              <label for="disco-email">Your email</label>
              <input type="email" id="disco-email" name="email" autocomplete="email" required />
            </div>
            <div class="pw__field">
              <label for="disco-url">Site to review</label>
              <input type="text" id="disco-url" name="url" placeholder="yourclient.com" required />
            </div>
            <div class="pw__field">
              <label for="disco-notes">Tell us about it <span class="pw__optional">(optional)</span></label>
              <textarea id="disco-notes" name="notes" rows="4" placeholder="Tell us as much as you'd like about this discovery so we can do our best work. The more details the better."></textarea>
            </div>
            <button type="submit" class="btn btn-primary pw__submit">
              <span class="pw__submit-label">Request my free discovery</span>
            </button>
            <p class="pw__form-error" role="alert" hidden></p>
          </form>

          <div class="pw__form-success" id="discovery-success" hidden>
            <div class="pw__success-icon" aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <h3>Discovery requested</h3>
            <p>We've got it. Our team runs these by hand, so grab a time with Mike if you'd like to walk through it live.</p>
          </div>
        </section>

        <section class="pw__book">
          <h2 class="pw__card-title">Book a walkthrough with Mike</h2>
          <p class="pw__card-desc">
            A real conversation about how we'd work together under your brand, no
            slide-deck pitch. Grab a time below.
          </p>
          <iframe
            class="pw__calendly"
            src={`${calendlyUrl}?hide_gdpr_banner=1`}
            title="Book a walkthrough with Mike"
            loading="lazy"></iframe>
        </section>
      </div>

      <!-- ─── Walkthrough videos ─── -->
      <h2 class="pw__section-title">Watch how it works</h2>
      <div class="pw__videos">
        {videos.map((v) => (
          <article class="pw__video">
            {v.url ? (
              <a class="pw__video-thumb pw__video-thumb--ready" href={v.url} target="_blank" rel="noopener noreferrer" aria-label={`Watch: ${v.title}`}>
                <span class="pw__video-play" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
              </a>
            ) : (
              <div class="pw__video-thumb">
                <span class="pw__video-play" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
                <span class="pw__video-soon">Coming soon</span>
              </div>
            )}
            <h3 class="pw__video-title">{v.title}</h3>
            <p class="pw__video-desc">{v.description}</p>
          </article>
        ))}
      </div>

      <!-- ─── Case studies + reports to download ─── -->
      <h2 class="pw__section-title">Case studies &amp; reports</h2>
      <p class="pw__section-sub">
        Proof to put in front of a prospect, plus the branded reporting they'd
        receive. See more in our <a href="/case-studies/">case studies</a>.
      </p>
      <div class="pw__downloads">
        {downloads.map((d) => (
          <article class="pw__download">
            <span class="pw__download-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </span>
            <h3 class="pw__download-title">{d.title}</h3>
            <p class="pw__download-desc">{d.description}</p>
            {d.url ? (
              <a class="pw__download-link" href={d.url} target="_blank" rel="noopener noreferrer">
                Download
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              </a>
            ) : (
              <span class="pw__download-note">Coming soon, ask Mike for a copy.</span>
            )}
          </article>
        ))}
      </div>

      <!-- ─── Build your package (pricing builder) ─── -->
      <div class="pw__builder-head">
        <h2 class="pw__section-title pw__section-title--center">Build your package</h2>
        <p class="pw__section-sub pw__section-sub--center">
          Mix the white-label services you want and see your wholesale cost,
          plus a suggested resale price at your markup. Final scope is confirmed
          on your discovery.
        </p>
      </div>
      <PackageBuilder />
    </div>
  </section>

  <Footer />
</Layout>

<script>
  import { prefillForm, saveLead } from "../lib/leadMemory";

  const form = document.getElementById("discovery-form") as HTMLFormElement | null;
  const success = document.getElementById("discovery-success");
  if (form) {
    // Carry the email the agency gave at the opt-in gate so they don't retype it.
    prefillForm(form);
    const errEl = form.querySelector(".pw__form-error") as HTMLElement | null;
    const btn = form.querySelector(".pw__submit") as HTMLButtonElement | null;
    const label = form.querySelector(".pw__submit-label") as HTMLElement | null;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (errEl) errEl.hidden = true;

      const data = Object.fromEntries(new FormData(form).entries());
      const email = String(data.email ?? "").trim();
      const url = String(data.url ?? "").trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || !url) {
        if (errEl) {
          errEl.textContent = "Please add your email and the site you'd like us to look at.";
          errEl.hidden = false;
        }
        return;
      }

      if (btn) btn.disabled = true;
      if (label) label.textContent = "Sending…";

      try {
        const res = await fetch("/api/discovery/", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(data),
        });
        const out = (await res.json()) as { ok: boolean; error?: string };
        if (!res.ok || !out.ok) throw new Error(out.error || "Something went wrong.");
        saveLead({ email });
        form.hidden = true;
        if (success) success.hidden = false;
      } catch (err) {
        if (errEl) {
          errEl.textContent = err instanceof Error ? err.message : "Something went wrong. Please try again.";
          errEl.hidden = false;
        }
        if (btn) btn.disabled = false;
        if (label) label.textContent = "Request my free discovery";
      }
    });
  }
</script>

<style>
  .pw {
    position: relative;
    padding: 150px 0 110px;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    overflow: hidden;
  }
  .pw__bg { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .pw__orb { position: absolute; border-radius: 50%; filter: blur(120px); opacity: 0.22; }
  .pw__orb--1 { width: 460px; height: 460px; top: -120px; left: -140px; background: var(--teal); }
  .pw__orb--2 { width: 420px; height: 420px; bottom: -160px; right: -120px; background: var(--purple); }
  .pw__inner { position: relative; z-index: 1; max-width: 1040px; margin: 0 auto; }

  .pw__head { text-align: center; max-width: 660px; margin: 0 auto 44px; }
  .pw__head .section-label { display: inline-block; }
  .pw__title { font-family: var(--font-display); font-size: clamp(32px, 5vw, 48px); font-weight: 700; letter-spacing: -0.02em; color: var(--text-primary); margin: 10px 0 14px; }
  .pw__lede { font-size: 18px; line-height: 1.7; color: var(--text-secondary); }

  /* Top row: discovery form + Calendly */
  .pw__top { display: grid; grid-template-columns: 1fr 1.05fr; gap: 24px; margin-bottom: 60px; align-items: start; }
  .pw__disco, .pw__book {
    background: var(--white); border: 1px solid var(--border-light);
    border-radius: var(--radius-xl); padding: 28px; box-shadow: var(--shadow-md);
  }
  .pw__card-title { font-family: var(--font-display); font-size: 22px; font-weight: 700; color: var(--text-primary); margin-bottom: 6px; letter-spacing: -0.01em; }
  .pw__card-desc { font-size: 15px; line-height: 1.6; color: var(--text-secondary); margin: 0 0 20px; }

  .pw__form { display: flex; flex-direction: column; gap: 16px; }
  .pw__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .pw__field { display: flex; flex-direction: column; }
  .pw__field label { font-family: var(--font-display); font-size: 13px; font-weight: 600; color: var(--text-primary); margin-bottom: 6px; }
  .pw__optional { font-weight: 400; color: var(--text-muted); }
  .pw__field input, .pw__field textarea {
    font-family: var(--font-body); font-size: 15px; padding: 11px 14px;
    border: 1px solid var(--border-light); border-radius: var(--radius-md);
    color: var(--text-primary); background: var(--white);
    transition: border-color 0.15s ease, box-shadow 0.15s ease; outline: none; resize: vertical;
  }
  .pw__field input:focus, .pw__field textarea:focus { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(45,175,175,0.15); }
  .pw__submit { width: 100%; justify-content: center; }
  .pw__submit:disabled { opacity: 0.7; cursor: not-allowed; }
  .pw__form-error { font-size: 13px; line-height: 1.5; color: #c0392b; background: rgba(220,50,50,0.06); border: 1px solid rgba(220,50,50,0.18); border-radius: var(--radius-md); padding: 10px 12px; margin: 0; }

  .pw__form-success { text-align: center; padding: 24px 8px; }
  .pw__success-icon { width: 52px; height: 52px; border-radius: 50%; background: rgba(68,185,123,0.14); color: var(--green); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }
  .pw__form-success h3 { font-family: var(--font-display); font-size: 20px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; }
  .pw__form-success p { font-size: 15px; line-height: 1.6; color: var(--text-secondary); }

  .pw__calendly { width: 100%; min-height: 640px; border: 0; border-radius: var(--radius-md); display: block; }

  /* Section headings */
  .pw__section-title { font-family: var(--font-display); font-size: 24px; font-weight: 700; letter-spacing: -0.01em; color: var(--text-primary); margin-bottom: 8px; }
  .pw__section-title--center { text-align: center; }
  .pw__section-sub { font-size: 15px; line-height: 1.6; color: var(--text-secondary); margin: 0 0 24px; max-width: 640px; }
  .pw__section-sub--center { text-align: center; margin-left: auto; margin-right: auto; }
  .pw__section-sub a { color: var(--teal-dark); text-decoration: underline; text-underline-offset: 3px; }

  /* Videos */
  .pw__videos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-bottom: 56px; }
  .pw__video-thumb {
    position: relative; display: flex; align-items: center; justify-content: center;
    aspect-ratio: 16 / 9; border-radius: var(--radius-md); margin-bottom: 14px; overflow: hidden;
    background:
      radial-gradient(circle at 30% 30%, rgba(40,165,177,0.25), transparent 60%),
      radial-gradient(circle at 70% 70%, rgba(140,99,170,0.25), transparent 60%),
      var(--dark);
    border: 1px solid var(--border-light);
  }
  .pw__video-play {
    width: 52px; height: 52px; border-radius: 50%;
    background: rgba(255,255,255,0.92); color: var(--dark);
    display: flex; align-items: center; justify-content: center; padding-left: 3px;
    transition: transform var(--transition);
  }
  .pw__video-thumb--ready { cursor: pointer; }
  .pw__video-thumb--ready:hover .pw__video-play { transform: scale(1.08); }
  .pw__video-soon {
    position: absolute; top: 10px; right: 10px;
    font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--white); background: rgba(255,255,255,0.16); border: 1px solid rgba(255,255,255,0.25);
    padding: 3px 9px; border-radius: var(--radius-full); backdrop-filter: blur(4px);
  }
  .pw__video-title { font-family: var(--font-display); font-size: 16px; font-weight: 600; color: var(--text-primary); margin-bottom: 6px; }
  .pw__video-desc { font-size: 14px; line-height: 1.6; color: var(--text-secondary); }

  /* Downloads */
  .pw__downloads { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 60px; }
  .pw__download {
    display: flex; flex-direction: column;
    background: var(--white); border: 1px solid var(--border-light);
    border-radius: var(--radius-lg); padding: 24px;
  }
  .pw__download-icon { width: 44px; height: 44px; border-radius: 50%; background: rgba(140,99,170,0.1); color: var(--purple); display: flex; align-items: center; justify-content: center; margin-bottom: 14px; }
  .pw__download-title { font-family: var(--font-display); font-size: 17px; font-weight: 600; color: var(--text-primary); margin-bottom: 8px; }
  .pw__download-desc { font-size: 14px; line-height: 1.6; color: var(--text-secondary); margin-bottom: 16px; flex-grow: 1; }
  .pw__download-link { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: var(--teal); transition: gap var(--transition); margin-top: auto; }
  .pw__download-link:hover { gap: 12px; }
  .pw__download-note { font-size: 13px; color: var(--text-muted); font-style: italic; margin-top: auto; }

  .pw__builder-head { margin-bottom: 24px; }

  @media (max-width: 860px) {
    .pw { padding: 120px 0 80px; }
    .pw__top { grid-template-columns: 1fr; }
    .pw__calendly { min-height: 1000px; }
    .pw__videos { grid-template-columns: 1fr; }
    .pw__downloads { grid-template-columns: 1fr; }
  }
</style>
