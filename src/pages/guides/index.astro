---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import { INDUSTRIES } from "../../data/industries";

const allGuides = (await getCollection("guides"))
  .filter((g) => !import.meta.env.PROD || !g.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

interface CardItem {
  title: string;
  href: string;
  meta: string;
}

interface CategorySpec {
  label: string;
  blurb: string;
  accent: "teal" | "purple" | "green";
  hubHref: string;
  cta: string;
  items: CardItem[];
}

function fmtDate(d: Date) {
  return d.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}

function guidesFor(slug: string, n: number): CardItem[] {
  return allGuides
    .filter((g) => g.data.category === slug)
    .slice(0, n)
    .map((g) => ({
      title: g.data.title,
      href: `/guides/${g.id}/`,
      meta: `${g.data.author} · ${fmtDate(g.data.publishDate)}`,
    }));
}

// Industry cards pull from the INDUSTRIES map (rendered as guides at
// /guides/{guideId}/), limited to verticals whose guide exists and isn't a draft.
const liveIndustries = INDUSTRIES.filter((i) =>
  allGuides.some((g) => g.id === i.guideId),
);
const industryItems: CardItem[] = liveIndustries.slice(0, 3).map((i) => ({
  title: `${i.name} SEO`,
  href: `/guides/${i.guideId}/`,
  meta: i.group,
}));

const categories: CategorySpec[] = [
  {
    label: "SEO Guides",
    blurb:
      "Practical SEO guides covering local, technical, content, AI search, and link building. Useful whether you're sharpening your own playbook or briefing a client.",
    accent: "teal",
    hubHref: "/guides/seo/",
    cta: "Explore all SEO guides",
    items: guidesFor("seo", 3),
  },
  {
    label: "Industries",
    blurb:
      "How we help agencies dominate specific verticals, from home services to health and professional practices. The playbook behind each campaign you resell.",
    accent: "purple",
    hubHref: "/guides/industry/",
    cta: "Explore all industries",
    items: industryItems,
  },
  {
    label: "Agency Guides",
    blurb:
      "Operating playbooks for agencies that resell SEO. Selling it, delivering it white-label, reporting, and retention.",
    accent: "green",
    hubHref: "/guides/agency/",
    cta: "Explore all agency guides",
    items: guidesFor("agency", 3),
  },
  {
    label: "Local Market Research",
    blurb:
      "How local search actually behaves in specific metros. Real volume data, the suburbs that carry their own search, and how we read a market before a campaign starts.",
    accent: "teal",
    hubHref: "/guides/cities/",
    cta: "Explore all markets",
    items: guidesFor("cities", 3),
  },
];
---

<Layout
  title="Agency SEO Guides and Resources | SEO Brothers"
  description="A library of agency, industry, and SEO resources. Interviews with agency owners, in-depth research, and how-to guides for growth-focused teams."
>
  <Nav />

  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="guides-hero">
    <div class="guides-hero__bg">
      <div class="guides-hero__orb guides-hero__orb--1"></div>
      <div class="guides-hero__orb guides-hero__orb--2"></div>
      <div class="guides-hero__orb guides-hero__orb--3"></div>
      <div class="guides-hero__grid"></div>
    </div>

    <div class="container guides-hero__inner">
      <span class="guides-hero__label" data-animate>
        <span class="guides-hero__label-dot"></span>
        Guides &amp; Resources
      </span>
      <h1 class="guides-hero__title" data-animate>
        SEO and agency<br />
        <span class="guides-hero__title-gradient">guides by the brothers.</span>
      </h1>
      <p class="guides-hero__subtitle" data-animate>
        A growing library of practical SEO resources: how-to guides, the
        industry playbooks behind our campaigns, and operating playbooks for the
        agencies we partner with.
      </p>
    </div>
  </section>

  <!-- ═══════════════ CATEGORIES ═══════════════ -->
  <section class="cats">
    <div class="container">
      <div class="cats__grid" data-stagger>
        {
          categories.map((cat) => {
            return (
              <article
                class:list={["cat", `cat--${cat.accent}`]}
                data-animate
              >
                <header class="cat__head">
                  <h2 class="cat__title">{cat.label}</h2>
                  <p class="cat__blurb">{cat.blurb}</p>
                </header>

                <ul class="cat__posts">
                  {cat.items.map((item) => (
                    <li class="cat__post">
                      <a href={item.href} class="cat__post-link">
                        <h3 class="cat__post-title">{item.title}</h3>
                        <p class="cat__post-meta">{item.meta}</p>
                      </a>
                    </li>
                  ))}
                  {cat.items.length === 0 && (
                    <li class="cat__empty">More guides coming soon.</li>
                  )}
                </ul>

                <a href={cat.hubHref} class="cat__cta">
                  {cat.cta}
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M3 8h10M9 4l4 4-4 4" />
                  </svg>
                </a>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <NewsletterSignup />
  <CtaBanner />
  <Footer />
</Layout>

<style>
  /* ═══════════════════════════════════════════════════════════════════
     HERO
     ═══════════════════════════════════════════════════════════════════ */
  .guides-hero {
    position: relative;
    background: var(--dark);
    overflow: hidden;
    padding: 180px 0 96px;
  }

  .guides-hero__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .guides-hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.22;
  }

  .guides-hero__orb--1 {
    width: 520px;
    height: 520px;
    background: var(--teal);
    top: -10%;
    right: -8%;
  }

  .guides-hero__orb--2 {
    width: 460px;
    height: 460px;
    background: var(--purple);
    bottom: -25%;
    left: -8%;
  }

  .guides-hero__orb--3 {
    width: 360px;
    height: 360px;
    background: var(--green);
    top: 15%;
    left: 35%;
  }

  .guides-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at 50% 30%, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(
      ellipse at 50% 30%,
      black 30%,
      transparent 75%
    );
  }

  .guides-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 880px;
  }

  .guides-hero__label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal-light);
    margin-bottom: 28px;
  }

  .guides-hero__label-dot {
    width: 8px;
    height: 8px;
    background: var(--green);
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(68, 185, 123, 0.18);
  }

  .guides-hero__title {
    font-family: var(--font-display);
    font-size: clamp(40px, 6.5vw, 68px);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--text-on-dark);
    margin-bottom: 24px;
  }

  .guides-hero__title-gradient {
    background: linear-gradient(135deg, var(--purple) 0%, var(--purple-light) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .guides-hero__subtitle {
    font-size: clamp(16px, 1.8vw, 19px);
    line-height: 1.7;
    color: var(--text-on-dark-muted);
    max-width: 640px;
  }

  .guides-hero__inline-link {
    color: var(--teal-light);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .guides-hero__inline-link:hover {
    color: var(--white);
  }

  /* ═══════════════════════════════════════════════════════════════════
     CATEGORY CARDS
     ═══════════════════════════════════════════════════════════════════ */
  .cats {
    padding: 96px 0 120px;
    background: var(--white);
  }

  .cats__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  /* Gradient lives behind a solid border; border-color transitions to
     transparent on hover, revealing it as a border ring. See the matching
     pattern on .cs-card in case-studies/index.astro. */
  .cat {
    display: flex;
    flex-direction: column;
    padding: 36px;
    border-radius: var(--radius-xl);
    background:
      linear-gradient(var(--light), var(--light)) padding-box,
      linear-gradient(135deg, var(--teal), var(--purple), var(--green)) border-box;
    background:
      linear-gradient(var(--light), var(--light)) padding-box,
      linear-gradient(135deg in oklch, var(--teal), var(--purple), var(--green)) border-box;
    border: 1px solid var(--border-light);
    transition: all var(--transition);
    position: relative;
    overflow: hidden;
  }

  .cat:hover {
    border-color: transparent;
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  .cat__head {
    margin-bottom: 28px;
  }

  .cat__title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .cat--teal .cat__title {
    color: var(--teal-dark);
  }

  .cat--purple .cat__title {
    color: var(--purple-dark);
  }

  .cat--green .cat__title {
    color: var(--green-dark);
  }

  .cat__blurb {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .cat__posts {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-grow: 1;
  }

  .cat__post {
    border-top: 1px solid var(--border-light);
  }

  .cat__post:first-child {
    border-top: none;
  }

  .cat__post-link {
    display: block;
    padding: 16px 0;
    color: inherit;
    transition: transform var(--transition);
  }

  .cat__post-link:hover {
    transform: translateX(6px);
  }

  .cat__post-title {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text-primary);
    margin-bottom: 6px;
    transition: color var(--transition);
  }

  .cat__post-link:hover .cat__post-title {
    color: var(--teal);
  }

  .cat__post-meta {
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .cat__empty {
    padding: 16px 0;
    font-size: 14px;
    color: var(--text-muted);
    font-style: italic;
  }

  .cat__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--teal);
    transition: gap var(--transition);
    margin-top: auto;
  }

  .cat--purple .cat__cta {
    color: var(--purple-dark);
  }

  .cat--green .cat__cta {
    color: var(--green-dark);
  }

  .cat__cta:hover {
    gap: 12px;
  }

  /* ═══════════════════════════════════════════════════════════════════
     RESPONSIVE
     ═══════════════════════════════════════════════════════════════════ */
  @media (max-width: 1024px) {
    .cats__grid {
      grid-template-columns: 1fr;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 768px) {
    .guides-hero {
      padding: 140px 0 64px;
    }

    .cats {
      padding: 64px 0 80px;
    }

    .cat {
      padding: 28px;
    }
  }
</style>
