---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import GuideList from "../../components/GuideList.astro";
import { GUIDE_GROUPS } from "../../data/guideGroups";
---

<Layout
  title="Agency Guides | Selling and Delivering SEO | SEO Brothers"
  description="Operating playbooks for agency owners who resell SEO: how to sell it, run a report-review call, deliver it white-label, report on it, and keep clients longer."
>
  <Nav />
  <GuideList
    category="agency"
    label="Agency Guides"
    blurb="Operating playbooks for agencies that resell SEO: pitching it, delivering it under your brand, reporting, and retention. The business-of-SEO layer, separate from our SEO how-to guides."
    accent="green"
    groups={GUIDE_GROUPS.agency}
  />
  <CtaBanner variant="partner" />
  <Footer />
</Layout>
