---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const careersEmail = "careers@seobrothers.co";
const mailto = `mailto:${careersEmail}`;

const openRoles = [
  {
    title: "SEO Manager",
    location: "Halifax, NS / Remote",
    type: "Full-time",
    status: "Posting soon",
    blurb:
      "Lead campaign strategy for a portfolio of agency partners. Own onboarding, quarterly planning, and the relationship between the strategy team and the partner. Posting goes live shortly. Reach out early if you want to be considered first.",
  },
];

const whyItems = [
  {
    title: "A small, senior team",
    body: "Forty plus people across strategy, fulfillment, and development. We have a structure, but the brothers stay close to the work and the team is small enough that everyone knows everyone.",
  },
  {
    title: "Tech-first by design",
    body: "We build the software our team and partners use. Real development investment, not bolted-on tooling.",
  },
  {
    title: "Agencies, not end clients",
    body: "Our partners are other digital agencies. The work is consistent, the relationships are long, and the politics are minimal.",
  },
];
---

<Layout
  title="Careers | SEO Brothers"
  description="SEO Brothers is hiring. See open roles or send your resume to careers@seobrothers.co. Halifax-based, 100% remote, technology-first SEO agency."
>
  <Nav variant="light" />

  <section class="careers-hero">
    <div class="careers-hero__bg">
      <div class="careers-hero__orb careers-hero__orb--1"></div>
      <div class="careers-hero__orb careers-hero__orb--2"></div>
      <div class="careers-hero__grid"></div>
    </div>

    <div class="container careers-hero__inner">
      <span class="section-label" data-animate>Careers</span>
      <h1 class="careers-hero__title" data-animate>
        Help us build a technology-first SEO agency
      </h1>
      <p class="careers-hero__lede" data-animate>
        SEO Brothers is a Halifax-headquartered, but 100% remote team of
        forty plus SEO professionals. We hire selectively, work directly
        with agency partners, and build our own software. If that sounds
        like the kind of place you want to spend your time, we want to
        hear from you.
      </p>
    </div>
  </section>

  <section class="careers-roles">
    <div class="container">
      <div class="careers-roles__header" data-animate>
        <span class="section-label">Open Roles</span>
        <h2 class="section-heading">What we're hiring for</h2>
      </div>

      <div class="careers-roles__list" data-stagger>
        {
          openRoles.map((role) => (
            <article class="role-card" data-animate>
              <div class="role-card__main">
                <div class="role-card__head">
                  <h3 class="role-card__title">{role.title}</h3>
                  <span class="role-card__status">{role.status}</span>
                </div>
                <div class="role-card__meta">
                  <span class="role-card__meta-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                      <circle cx="12" cy="10" r="3" />
                    </svg>
                    {role.location}
                  </span>
                  <span class="role-card__meta-divider" aria-hidden="true">
                    •
                  </span>
                  <span class="role-card__meta-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10" />
                      <polyline points="12 6 12 12 16 14" />
                    </svg>
                    {role.type}
                  </span>
                </div>
                <p class="role-card__blurb">{role.blurb}</p>
              </div>
              <div class="role-card__cta">
                <a
                  href={`${mailto}?subject=${encodeURIComponent(`Early interest: ${role.title}`)}`}
                  class="btn btn-primary role-card__btn"
                >
                  Get in early
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="careers-why">
    <div class="container">
      <div class="careers-why__header" data-animate>
        <span class="section-label">Why SEO Brothers</span>
        <h2 class="section-heading">What working here looks like</h2>
      </div>

      <div class="careers-why__grid" data-stagger>
        {
          whyItems.map((item) => (
            <div class="careers-why__card" data-animate>
              <h3 class="careers-why__card-title">{item.title}</h3>
              <p class="careers-why__card-body">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="careers-resume">
    <div class="container">
      <div class="careers-resume__card" data-animate>
        <div class="careers-resume__copy">
          <span class="section-label">Always Open</span>
          <h2 class="careers-resume__title">
            Don't see your role? Send us your resume anyway.
          </h2>
          <p class="careers-resume__body">
            We're always interested in hearing from strong SEO specialists,
            content writers, link builders, account managers, and developers.
            If we think there's a fit now or later, we'll be in touch.
          </p>
        </div>
        <div class="careers-resume__cta">
          <a href={mailto} class="btn btn-primary careers-resume__btn">
            Email {careersEmail}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <p class="careers-resume__hint">
            Attach a resume and a short note on what you're looking for.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .careers-hero {
    position: relative;
    padding: 140px 0 80px;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    overflow: hidden;
  }

  .careers-hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .careers-hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.22;
  }

  .careers-hero__orb--1 {
    width: 480px;
    height: 480px;
    top: -140px;
    left: -160px;
    background: var(--teal);
  }

  .careers-hero__orb--2 {
    width: 420px;
    height: 420px;
    top: -80px;
    right: -120px;
    background: var(--green);
  }

  .careers-hero__grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
        rgba(15, 23, 42, 0.04) 1px,
        transparent 1px
      ),
      linear-gradient(90deg, rgba(15, 23, 42, 0.04) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(
      ellipse at center,
      black 30%,
      transparent 80%
    );
    -webkit-mask-image: radial-gradient(
      ellipse at center,
      black 30%,
      transparent 80%
    );
  }

  .careers-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 820px;
  }

  .careers-hero__title {
    font-family: var(--font-display);
    font-size: clamp(36px, 5.4vw, 60px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 14px 0 22px;
  }

  .careers-hero__lede {
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 680px;
    margin: 0;
  }

  .careers-roles {
    padding: 80px 0;
    background: var(--white);
  }

  .careers-roles__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .careers-roles__list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 880px;
    margin: 0 auto;
  }

  .role-card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: center;
    padding: 28px 32px;
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm, 0 1px 2px rgba(15, 23, 42, 0.04));
    transition: border-color var(--transition), box-shadow var(--transition),
      transform var(--transition);
  }

  .role-card:hover {
    border-color: rgba(45, 175, 175, 0.4);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
    transform: translateY(-1px);
  }

  .role-card__head {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .role-card__title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.25;
  }

  .role-card__status {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
    color: var(--green);
    background: rgba(68, 185, 123, 0.12);
    border-radius: 999px;
    letter-spacing: 0.02em;
  }

  .role-card__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .role-card__meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .role-card__meta-divider {
    color: var(--border-light);
  }

  .role-card__blurb {
    margin: 14px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 580px;
  }

  .role-card__cta {
    display: flex;
    align-items: center;
  }

  .role-card__btn {
    white-space: nowrap;
  }

  .careers-why {
    padding: 80px 0;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  }

  .careers-why__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .careers-why__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 1040px;
    margin: 0 auto;
  }

  .careers-why__card {
    padding: 28px;
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
  }

  .careers-why__card-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 10px;
    line-height: 1.3;
  }

  .careers-why__card-body {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  .careers-resume {
    padding: 60px 0 100px;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }

  .careers-resume__card {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 48px;
    align-items: center;
    max-width: 1000px;
    margin: 0 auto;
    padding: 48px;
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .careers-resume__title {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.8vw, 30px);
    font-weight: 600;
    line-height: 1.25;
    color: var(--text-primary);
    margin: 12px 0 14px;
    letter-spacing: -0.01em;
  }

  .careers-resume__body {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }

  .careers-resume__cta {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
  }

  .careers-resume__btn {
    justify-content: center;
  }

  .careers-resume__hint {
    font-size: 13px;
    color: var(--text-muted);
    text-align: center;
    margin: 0;
  }

  @media (max-width: 900px) {
    .careers-hero {
      padding: 110px 0 64px;
    }

    .careers-roles,
    .careers-why {
      padding: 64px 0;
    }

    .careers-why__grid {
      grid-template-columns: 1fr;
    }

    .role-card {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 24px;
    }

    .role-card__cta {
      justify-content: flex-start;
    }

    .careers-resume__card {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 32px;
    }
  }

  @media (max-width: 480px) {
    .careers-resume {
      padding: 40px 0 72px;
    }
  }
</style>
