---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

// Where Calendly sends people after they book. Each event type is set to
// "Redirect to an external site" -> https://seobrothers.com/call-booked/ with
// "Pass event details to your redirected page" on, so the URL arrives with
// invitee_full_name, invitee_email, event_type_name, event_start_time and
// invitee_uuid. The page fires the GA4 conversion from our own domain (the
// Calendly iframe cannot), then points the booker at the free trial.
//
// Direct visits (no invitee_uuid) still render the confirmation, without the
// event. noindex: this page only exists as a landing after a booking.
export const prerender = true;
---

<Layout
  title="You're booked | SEO Brothers"
  description="Your call with SEO Brothers is booked."
  noindex={true}
>
  <Nav variant="light" hideCta={true} />

  <section class="cb">
    <div class="cb__bg" aria-hidden="true">
      <div class="cb__orb cb__orb--1"></div>
      <div class="cb__orb cb__orb--2"></div>
    </div>

    <div class="container cb__inner">
      <div class="cb__card" data-animate>
        <div class="cb__icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
        </div>
        <span class="section-label">You're booked</span>
        <h1 class="cb__title" id="cb-title">See you soon.</h1>
        <p class="cb__when" id="cb-when" hidden></p>
        <p class="cb__lede">
          The calendar invite is on its way to your inbox. Reply to it with anything
          you want us to look at before we talk, and we will come prepared.
        </p>
      </div>

      <div class="cb__trial" data-animate>
        <span class="cb__trial-label">While you wait</span>
        <h2 class="cb__trial-title">Get inside the platform before the call.</h2>
        <p class="cb__trial-body">
          Create your Tideworthy account now and run a free discovery on a client
          or a prospect, so we can talk through a real site instead of a slide deck.
        </p>
        <p class="cb__trial-body cb__trial-body--strong">
          Your free trial doesn't start until you start a campaign. Using the
          platform and running discoveries is free.
        </p>
        <div class="cb__actions">
          <a href="/sign-up/" class="btn btn-primary btn-lg">
            Start Free Trial
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href="/tideworthy/" class="btn btn-outline--dark btn-lg">How the platform works</a>
        </div>
        <p class="cb__secondary">
          <a href="/case-studies/">See results we've gotten</a>
          <span aria-hidden="true">·</span>
          <a href="/pricing/">See the plans</a>
        </p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  import { track } from "../lib/analytics";

  const params = new URLSearchParams(location.search);
  const inviteeUuid = params.get("invitee_uuid");
  const name = params.get("invitee_full_name")?.trim();
  const eventName = params.get("event_type_name")?.trim();
  const start = params.get("event_start_time");

  const title = document.getElementById("cb-title");
  const when = document.getElementById("cb-when");

  if (title && name) {
    const first = name.split(/\s+/)[0];
    title.textContent = `See you soon, ${first}.`;
  }

  if (when && start) {
    const date = new Date(start);
    if (!Number.isNaN(date.getTime())) {
      const day = date.toLocaleDateString(undefined, { weekday: "long", month: "long", day: "numeric" });
      const time = date.toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit", timeZoneName: "short" });
      when.textContent = `${eventName ? `${eventName}, ` : ""}${day} at ${time}`;
      when.hidden = false;
    }
  }

  // Fire the conversion once per booking. The inline Calendly widget already
  // reports the same booking through a postMessage before it redirects here
  // (see initCalendlyTracking in src/lib/analytics.ts); both paths share this
  // sessionStorage key so a booking is never counted twice, and a reload of
  // this page does not count again either.
  if (inviteeUuid) {
    const key = `calendly_tracked:${inviteeUuid}`;
    let seen = false;
    try {
      seen = sessionStorage.getItem(key) === "1";
      sessionStorage.setItem(key, "1");
    } catch {}
    if (!seen) {
      track("calendar_event_scheduled", {
        event_type: eventName,
        invitee_uuid: inviteeUuid,
        method: "redirect",
      });
    }
  }
</script>

<style>
  .cb {
    position: relative;
    padding: 150px 0 110px;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    overflow: hidden;
  }
  .cb__bg { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .cb__orb { position: absolute; border-radius: 50%; filter: blur(120px); opacity: 0.22; }
  .cb__orb--1 { width: 460px; height: 460px; top: -120px; left: -140px; background: var(--teal); }
  .cb__orb--2 { width: 420px; height: 420px; bottom: -160px; right: -120px; background: var(--purple); }

  .cb__inner {
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 48px;
    align-items: start;
  }

  .cb__card { padding-top: 8px; }
  .cb__icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(68, 185, 123, 0.14);
    color: var(--green);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }
  .cb__card .section-label { display: inline-block; }
  .cb__title {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 10px 0 12px;
  }
  .cb__when {
    font-size: 16px;
    font-weight: 600;
    color: var(--teal-dark);
    margin-bottom: 16px;
  }
  .cb__lede { font-size: 18px; line-height: 1.7; color: var(--text-secondary); }

  .cb__trial {
    background: var(--dark);
    color: var(--text-on-dark);
    border-radius: var(--radius-xl);
    padding: 40px;
    box-shadow: var(--shadow-lg);
  }
  .cb__trial-label {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal-light);
    margin-bottom: 14px;
  }
  .cb__trial-title {
    font-family: var(--font-display);
    font-size: clamp(24px, 3.2vw, 32px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
    text-wrap: balance;
  }
  .cb__trial-body { font-size: 16px; line-height: 1.7; color: var(--text-on-dark-muted); margin-bottom: 14px; }
  .cb__trial-body--strong { color: var(--text-on-dark); font-weight: 600; }
  .cb__actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 24px 0 18px; }
  .cb__actions .btn-outline--dark { color: var(--text-on-dark); border-color: rgba(255, 255, 255, 0.25); }
  .cb__actions .btn-outline--dark:hover { color: var(--teal-light); border-color: var(--teal-light); background: rgba(255, 255, 255, 0.05); }
  .cb__secondary { font-size: 14px; color: var(--text-on-dark-muted); display: flex; gap: 10px; flex-wrap: wrap; }
  .cb__secondary a { color: var(--teal-light); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 900px) {
    .cb { padding: 120px 0 80px; }
    .cb__inner { grid-template-columns: 1fr; gap: 32px; }
    .cb__trial { padding: 28px 24px; }
  }
</style>
