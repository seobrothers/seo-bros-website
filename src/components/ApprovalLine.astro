---
// Two-column "who does what" diagram for guides (via MDX): what the agent
// does alone on the left, what a person approves on the right, with the
// approval line drawn between them.
interface Props {
  title?: string;
  agent: string[];
  person: string[];
  agentLabel?: string;
  personLabel?: string;
}

const {
  title,
  agent,
  person,
  agentLabel = "The agent does alone",
  personLabel = "A person approves",
} = Astro.props;
---

<figure class="line">
  {title && <figcaption class="line__title">{title}</figcaption>}
  <div class="line__cols">
    <div class="line__col line__col--agent">
      <span class="line__label">
        <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="5" width="14" height="11" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="7.5" cy="10.5" r="1.3" fill="currentColor"/><circle cx="12.5" cy="10.5" r="1.3" fill="currentColor"/><path d="M10 2v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        {agentLabel}
      </span>
      <ul>{agent.map((a) => <li>{a}</li>)}</ul>
    </div>
    <div class="line__divider" aria-hidden="true">
      <span>approval line</span>
    </div>
    <div class="line__col line__col--person">
      <span class="line__label">
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="6.5" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3.5 17c.8-3.4 3.4-5.2 6.5-5.2s5.7 1.8 6.5 5.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        {personLabel}
      </span>
      <ul>{person.map((p) => <li>{p}</li>)}</ul>
    </div>
  </div>
</figure>

<style>
  .line {
    margin: 32px 0;
  }

  .line__title {
    margin-bottom: 12px;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .line__cols {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    background: var(--white);
    overflow: hidden;
  }

  .line .line__col {
    padding: 22px 24px;
  }

  .line__col--agent {
    background: var(--light);
  }

  .line .line__label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .line .line__label svg {
    width: 20px;
    height: 20px;
    flex: none;
    color: var(--teal-dark);
  }

  .line .line__col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .line .line__col li {
    position: relative;
    margin: 0 0 8px;
    padding-left: 16px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .line .line__col li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal);
  }

  .line__divider {
    position: relative;
    width: 2px;
    background: repeating-linear-gradient(
      to bottom,
      var(--teal) 0 8px,
      transparent 8px 14px
    );
  }

  .line__divider span {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-90deg);
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--teal-dark);
    background: var(--white);
    border: 1px solid var(--teal);
    border-radius: var(--radius-full);
  }

  @media (max-width: 680px) {
    .line__cols {
      grid-template-columns: 1fr;
    }

    .line__divider {
      width: auto;
      height: 2px;
      margin: 0 20px;
      background: repeating-linear-gradient(
        to right,
        var(--teal) 0 8px,
        transparent 8px 14px
      );
    }

    .line__divider span {
      transform: translate(-50%, -50%);
    }
  }
</style>
