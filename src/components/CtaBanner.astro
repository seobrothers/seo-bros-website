---
// Closing CTA used across the site.
//   variant="audit"   (default) business-facing free-audit CTA with an inline
//                     AuditForm. The #book-audit anchor lives here so hero
//                     "Get My Free Audit" buttons can scroll to it.
//   variant="partner" agency/white-label CTA pointing at the partner package.
import AuditForm from "./AuditForm.astro";

interface Props {
  variant?: "audit" | "partner";
}

const { variant = "audit" } = Astro.props;
---

<section class="cta-banner" id="book-audit">
  <div class="cta-bg">
    <div class="cta-orb cta-orb--1"></div>
    <div class="cta-orb cta-orb--2"></div>
  </div>

  <div class="container">
    {variant === "audit" ? (
      <div class="cta-audit" data-animate>
        <div class="cta-audit__copy">
          <h2 class="cta-heading">See Where Your Business Stands in Search</h2>
          <p class="cta-text">
            Get a free audit. We'll show you where you rank now, where the
            opportunity is, and what it would take to get in front of more local
            customers. An instant snapshot, plus a real audit from our team.
          </p>
          <div class="cta-meta">
            <span class="cta-meta-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Instant results
            </span>
            <span class="cta-meta-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Plus a real human audit
            </span>
            <span class="cta-meta-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              No contracts
            </span>
          </div>
        </div>
        <div class="cta-audit__form">
          <AuditForm source="cta-banner" />
        </div>
      </div>
    ) : (
      <div class="cta-content" data-animate>
        <h2 class="cta-heading">Test Us On Your Next Account.</h2>
        <p class="cta-text">
          We've been a white-label SEO and website partner to agencies since
          2015. Get the partner package, then put us to work: pricing, sample
          reports, a free discovery audit, and a walkthrough of how we deliver
          under your brand.
        </p>
        <div class="cta-actions">
          <a href="/partner-package/" class="btn btn-primary btn-lg">
            Test Us
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
        <div class="cta-meta">
          <span class="cta-meta-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            White-label under your brand
          </span>
          <span class="cta-meta-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Free discovery audits
          </span>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .cta-banner {
    padding: 120px 0;
    background: var(--dark);
    position: relative;
    overflow: hidden;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
  }

  .cta-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(150px);
    opacity: 0.2;
  }

  .cta-orb--1 {
    width: 500px;
    height: 500px;
    background: var(--teal);
    bottom: -30%;
    left: -10%;
  }

  .cta-orb--2 {
    width: 400px;
    height: 400px;
    background: var(--purple);
    top: -30%;
    right: -10%;
  }

  /* ===== audit variant: copy + form, two columns ===== */
  .cta-audit {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
    max-width: 1040px;
    margin: 0 auto;
  }

  .cta-audit__copy .cta-heading,
  .cta-audit__copy .cta-text {
    text-align: left;
  }

  .cta-audit__copy .cta-meta {
    justify-content: flex-start;
  }

  .cta-audit__form {
    width: 100%;
    max-width: 460px;
    justify-self: end;
  }

  /* ===== partner variant: centered ===== */
  .cta-content {
    text-align: center;
    position: relative;
    z-index: 1;
    max-width: 640px;
    margin: 0 auto;
  }

  .cta-heading {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-on-dark);
    margin-bottom: 20px;
    text-wrap: balance;
  }

  .cta-text {
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-on-dark-muted);
    margin-bottom: 28px;
  }

  .cta-actions {
    margin-bottom: 28px;
  }

  .btn-lg {
    padding: 16px 36px;
    font-size: 16px;
  }

  .cta-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .cta-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--text-on-dark-muted);
  }

  .cta-meta-item svg {
    color: var(--green);
  }

  @media (max-width: 900px) {
    .cta-audit {
      grid-template-columns: 1fr;
      gap: 36px;
      max-width: 520px;
    }

    .cta-audit__copy .cta-heading,
    .cta-audit__copy .cta-text {
      text-align: center;
    }

    .cta-audit__copy .cta-meta {
      justify-content: center;
    }

    .cta-audit__form {
      justify-self: center;
      max-width: 100%;
    }
  }

  @media (max-width: 600px) {
    .cta-banner {
      padding: 80px 0;
    }

    .cta-meta {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
