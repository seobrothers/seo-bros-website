---
// Hero-number tiles for guides (via MDX). A headline figure reads better as
// a big number than as a table row, so the few numbers a skimmer should
// leave with get a tile each. Keep it to 3 or 4 tiles.
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
  caption?: string;
}

const { stats, caption } = Astro.props;
---

<figure class="stats">
  <dl class="stats__grid">
    {
      stats.map((s) => (
        <div class="stats__tile">
          <dt class="stats__label">{s.label}</dt>
          <dd class="stats__value">{s.value}</dd>
        </div>
      ))
    }
  </dl>
  {caption && <figcaption class="stats__caption">{caption}</figcaption>}
</figure>

<style>
  .stats {
    margin: 32px 0;
  }

  .stats .stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
    margin: 0;
  }

  .stats .stats__tile {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
    padding: 20px 20px 18px;
    background: var(--white);
    border: 1px solid var(--border-light);
    border-top: 3px solid var(--teal);
    border-radius: var(--radius-md);
  }

  .stats .stats__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
  }

  .stats .stats__label {
    font-size: 14px;
    line-height: 1.35;
    color: var(--text-secondary);
  }

  .stats__caption {
    margin-top: 10px;
    font-size: 13px;
    color: var(--text-muted);
  }

  @media (max-width: 560px) {
    .stats .stats__grid {
      grid-template-columns: 1fr 1fr;
    }

    .stats .stats__value {
      font-size: 28px;
    }
  }
</style>
