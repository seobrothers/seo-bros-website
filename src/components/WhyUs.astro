---
// Homepage: who we are and why the partnership holds. One team of SEOs,
// developers, and website builders; agent-driven delivery with human
// strategy; support that stays ahead of the partner's clients.
const large = [
  {
    icon: "spark",
    title: "Agentic Technology, Human Strategy",
    body: "Our platform's agents do the daily delivery work on every campaign: research, content, technical fixes, monitoring. Our strategists set the direction and check the work. You get the speed of software at a price that leaves room for your margin.",
  },
  {
    icon: "people",
    title: "Support Means SEO Guidance, Not a Help Desk",
    body: "A named team that knows your accounts, helps you answer the hard client question before the call, and trains your people so you sound like the expert you are. No ticket queue, no bots.",
  },
];

const small = [
  {
    icon: "eye",
    title: "We Stay Invisible",
    body: "Our name is nowhere your client can look. Reports, portal, deliverables, all yours.",
  },
  {
    icon: "server",
    title: "The DevOps Is Ours",
    body: "Hosting, deploys, backups, uptime, and updates on every site we build. You sell the website; we keep it running.",
  },
  {
    icon: "scale",
    title: "Local Is Our Bread and Butter",
    body: "Local service businesses are what we do best: map pack, Business Profile, multi-location and franchise. We run $10K programs for publicly traded companies too.",
  },
  {
    icon: "tag",
    title: "Wholesale Pricing, Your Markup",
    body: "Partner rates on every campaign and site. You set the retail price and keep the margin.",
  },
];
---

<section class="why">
  <div class="container">
    <div class="why-header" data-animate>
      <span class="section-label section-label--light">Why SEO Brothers</span>
      <h2 class="section-heading section-heading--light">
        SEOs, Developers, and Website Builders.<br />
        One Partner.
      </h2>
      <p class="section-subtext section-subtext--light">
        Most providers give you hands or a dashboard. We give you the people who
        run the campaigns, the software they run them in, and the support in
        between.
      </p>
    </div>

    <div class="why-grid" data-stagger>
      {
        large.map((c) => (
          <div class="why-card why-card--large" data-animate>
            <div class="why-card-icon">
              {c.icon === "spark" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9.94 15.5A2 2 0 0 0 8.5 14.06l-6.14-1.58a.5.5 0 0 1 0-.96L8.5 9.94A2 2 0 0 0 9.94 8.5l1.58-6.14a.5.5 0 0 1 .96 0L14.06 8.5A2 2 0 0 0 15.5 9.94l6.14 1.58a.5.5 0 0 1 0 .96L15.5 14.06a2 2 0 0 0-1.44 1.44l-1.58 6.14a.5.5 0 0 1-.96 0z" />
                  <path d="M20 3v4M22 5h-4M4 17v2M5 18H3" />
                </svg>
              )}
              {c.icon === "people" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
              )}
            </div>
            <h3 class="why-card-title">{c.title}</h3>
            <p class="why-card-desc">{c.body}</p>
          </div>
        ))
      }

      {
        small.map((c) => (
          <div class="why-card" data-animate>
            <div class="why-card-icon why-card-icon--sm">
              {c.icon === "eye" && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
                  <line x1="1" y1="1" x2="23" y2="23" />
                </svg>
              )}
              {c.icon === "server" && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="8" rx="2" ry="2" />
                  <rect x="2" y="14" width="20" height="8" rx="2" ry="2" />
                  <line x1="6" y1="6" x2="6.01" y2="6" />
                  <line x1="6" y1="18" x2="6.01" y2="18" />
                </svg>
              )}
              {c.icon === "scale" && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
                  <polyline points="17 6 23 6 23 12" />
                </svg>
              )}
              {c.icon === "tag" && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.59 13.41 13.42 20.6a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" />
                  <circle cx="7" cy="7" r="1.5" />
                </svg>
              )}
            </div>
            <h3 class="why-card-title">{c.title}</h3>
            <p class="why-card-desc">{c.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why {
    padding: 120px 0;
    background: var(--dark);
    position: relative;
    overflow: hidden;
  }

  .why::before {
    content: "";
    position: absolute;
    top: -200px;
    right: -200px;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: var(--purple);
    filter: blur(200px);
    opacity: 0.1;
  }

  .why-header {
    text-align: center;
    margin-bottom: 64px;
    position: relative;
    z-index: 1;
  }

  .why-header .section-subtext--light {
    margin: 0 auto;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    position: relative;
    z-index: 1;
  }

  .why-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-lg);
    padding: 28px;
    transition: all var(--transition);
  }

  .why-card:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }

  .why-card--large {
    grid-column: span 2;
    padding: 36px;
  }

  .why-card-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: rgba(40, 165, 177, 0.12);
    color: var(--teal-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .why-card-icon--sm {
    width: 40px;
    height: 40px;
  }

  .why-card-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    color: var(--text-on-dark);
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .why-card--large .why-card-title {
    font-size: 22px;
  }

  .why-card-desc {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-on-dark-muted);
  }

  @media (max-width: 900px) {
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .why-card--large {
      grid-column: span 1;
    }
  }

  @media (max-width: 600px) {
    .why {
      padding: 80px 0;
    }

    .why-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
