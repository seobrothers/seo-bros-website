---
// Homepage: the white-label portal, shown with a real capture of a demo
// client's portal as the client sees it. Replaces the old reporting feature
// block. Dasher (usedasher.com) is dental-only and still in development, so
// it no longer gets a homepage slot; the platform page carries the software
// story.
import { Image } from "astro:assets";
import portalShot from "../assets/shots/client-portal.png";

const points = [
  {
    title: "Your domain",
    body: "Clients sign in at an address on your own domain, not ours.",
  },
  {
    title: "Your look",
    body: "Your logo, your colors, and the name your clients already know.",
  },
  {
    title: "Client approvals, under your brand",
    body: "Send content and site changes to your client for sign-off inside what looks like your software.",
  },
  {
    title: "Reports that wear your logo",
    body: "Rankings, work completed, and leads go out the door as yours. Our name is nowhere your client will look.",
  },
];
---

<section class="portal">
  <div class="container">
    <div class="portal__card" data-animate>
      <div class="portal__copy">
        <span class="portal__label">
          <span class="portal__label-dot"></span>
          Your Client Portal
        </span>
        <h2 class="portal__title">
          White-labeled down to the domain, with your flair on top
        </h2>
        <p class="portal__text">
          Every campaign, plan, ranking, and report lives in a portal your
          clients experience as yours. You brand it once. From then on, the work
          we do shows up as work your agency did.
        </p>

        <ul class="portal__points">
          {
            points.map((p) => (
              <li class="portal__point">
                <span class="portal__point-icon" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                </span>
                <div>
                  <span class="portal__point-title">{p.title}</span>
                  <span class="portal__point-body">{p.body}</span>
                </div>
              </li>
            ))
          }
        </ul>

        <a href="/tideworthy/" class="btn btn-primary portal__cta">
          See the platform
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <figure class="portal__shot">
        <div class="portal__bar" aria-hidden="true">
          <span class="portal__dot"></span>
          <span class="portal__dot"></span>
          <span class="portal__dot"></span>
          <span class="portal__url">portal.youragency.com</span>
        </div>
        <Image
          src={portalShot}
          alt="A client portal branded as Demo Agency, showing the Abruzzo Pizza campaign's current phase and what to expect from the campaign process"
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 900px) 100vw, 640px"
          format="webp"
          loading="lazy"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .portal {
    padding: 100px 0;
    background: var(--white);
  }

  .portal__card {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 56px;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 56px;
    border-radius: var(--radius-xl);
    background:
      linear-gradient(var(--light), var(--light)) padding-box,
      linear-gradient(135deg in oklch, var(--teal), var(--teal-light)) border-box;
    border: 1px solid transparent;
  }

  .portal__label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal-dark);
    margin-bottom: 18px;
  }

  .portal__label-dot {
    width: 8px;
    height: 8px;
    background: var(--green);
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(68, 185, 123, 0.18);
  }

  .portal__title {
    font-family: var(--font-display);
    font-size: clamp(26px, 3.4vw, 36px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 16px;
    text-wrap: balance;
  }

  .portal__text {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 26px;
  }

  .portal__points {
    list-style: none;
    margin: 0 0 30px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .portal__point {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .portal__point-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(68, 185, 123, 0.12);
    color: var(--green);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }

  .portal__point-title {
    display: block;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .portal__point-body {
    display: block;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--text-secondary);
    margin-top: 2px;
  }

  .portal__shot {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-xl);
  }

  .portal__shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .portal__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--light-100);
    border-bottom: 1px solid var(--border-light);
  }

  .portal__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #cbd5e1;
  }

  .portal__url {
    margin-left: 10px;
    padding: 4px 12px;
    font-family: ui-monospace, Menlo, monospace;
    font-size: 12px;
    color: var(--text-secondary);
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
  }

  @media (max-width: 900px) {
    .portal {
      padding: 72px 0;
    }

    .portal__card {
      grid-template-columns: 1fr;
      gap: 36px;
      padding: 36px 28px;
    }
  }
</style>
