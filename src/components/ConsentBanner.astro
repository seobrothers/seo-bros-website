---
import { CONSENT_VERSION, CONSENT_STORAGE_KEY } from "../lib/consent";
---

<div
  id="consent-banner"
  class="consent-banner"
  role="dialog"
  aria-modal="false"
  aria-labelledby="consent-banner-heading"
  aria-describedby="consent-banner-body"
  data-consent-version={CONSENT_VERSION}
  hidden
>
  <div class="consent-banner__inner">
    <div class="consent-banner__content">
      <h2 id="consent-banner-heading" class="consent-banner__heading">
        Your privacy choices
      </h2>
      <p id="consent-banner-body" class="consent-banner__body">
        We use essential cookies to make this site work. With your consent, we'd
        also like to use analytics and advertising cookies to understand how
        visitors use the site and improve it. You can change your choice at any
        time. See our <a href="/privacy">Privacy Policy</a> for details.
      </p>
    </div>

    <div class="consent-banner__actions">
      <button type="button" class="consent-banner__btn consent-banner__btn--reject" data-consent-action="reject">
        Reject non-essential
      </button>
      <button type="button" class="consent-banner__btn consent-banner__btn--accept" data-consent-action="accept">
        Accept all
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ CONSENT_VERSION, CONSENT_STORAGE_KEY }}>
  (function () {
    const banner = document.getElementById("consent-banner");
    if (!banner) return;

    function readChoice() {
      try {
        const raw = localStorage.getItem(CONSENT_STORAGE_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== "object") return null;
        return parsed;
      } catch {
        return null;
      }
    }

    function updateGtag(choice) {
      if (typeof window.gtag !== "function") return;
      const state = choice === "accept" ? "granted" : "denied";
      window.gtag("consent", "update", {
        ad_storage: state,
        ad_user_data: state,
        ad_personalization: state,
        analytics_storage: state,
        personalization_storage: state,
      });
    }

    function writeChoice(choice) {
      const record = {
        choice,
        version: CONSENT_VERSION,
        timestamp: new Date().toISOString(),
      };
      try {
        localStorage.setItem(CONSENT_STORAGE_KEY, JSON.stringify(record));
      } catch {
        // localStorage may be unavailable (private mode); fail silently
      }
      updateGtag(choice);
      window.dispatchEvent(
        new CustomEvent("consent-updated", { detail: record })
      );
    }

    function show() {
      banner.hidden = false;
      requestAnimationFrame(() => banner.classList.add("is-visible"));
    }

    function hide() {
      banner.classList.remove("is-visible");
      setTimeout(() => {
        banner.hidden = true;
      }, 300);
    }

    function shouldShow() {
      const existing = readChoice();
      if (!existing) return true;
      return existing.version !== CONSENT_VERSION;
    }

    if (shouldShow()) show();

    banner.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const action = target.dataset.consentAction;
      if (!action) return;
      writeChoice(action);
      hide();
    });

    window.seobrothersConsent = {
      get: readChoice,
      set: (choice) => {
        writeChoice(choice);
        hide();
      },
      reopen: show,
    };
  })();
</script>

<style>
  .consent-banner {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 10000;
    background: var(--dark);
    color: var(--text-on-dark);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.45);
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .consent-banner.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .consent-banner__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 22px 28px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 28px;
    align-items: center;
  }

  .consent-banner__heading {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--text-on-dark);
    margin: 0 0 4px 0;
    letter-spacing: -0.005em;
  }

  .consent-banner__body {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-on-dark-muted);
    margin: 0;
    max-width: 720px;
  }

  .consent-banner__body a {
    color: var(--teal-light);
    border-bottom: 1px solid rgba(51, 196, 209, 0.35);
    transition: all 0.2s;
  }

  .consent-banner__body a:hover {
    color: var(--teal);
    border-bottom-color: var(--teal-light);
  }

  .consent-banner__actions {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }

  .consent-banner__btn {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    padding: 11px 22px;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .consent-banner__btn--reject {
    background: transparent;
    color: var(--text-on-dark);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .consent-banner__btn--reject:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .consent-banner__btn--accept {
    background: var(--teal);
    color: var(--white);
  }

  .consent-banner__btn--accept:hover {
    background: var(--teal-light);
    box-shadow: 0 0 0 4px rgba(40, 165, 177, 0.18);
    transform: translateY(-1px);
  }

  @media (max-width: 720px) {
    .consent-banner {
      left: 12px;
      right: 12px;
      bottom: 12px;
    }

    .consent-banner__inner {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 20px 22px;
    }

    .consent-banner__actions {
      width: 100%;
      gap: 8px;
    }

    .consent-banner__btn {
      flex: 1;
      padding: 12px 16px;
    }
  }
</style>
