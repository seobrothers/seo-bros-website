---
// Build Your Package — interactive white-label cost calculator. An agency picks
// an SEO tier, extra Maps locations, a website build, hosting, and maintenance,
// then a markup slider shows their cost vs a suggested client resale price.
// All prices come from src/data/pricing.ts (single source of truth). Pure
// vanilla JS: each input carries data-monthly / data-onetime, the script sums
// the selected ones and applies the markup. No framework.
import {
  SEO_TIERS,
  EXTRA_LOCATION,
  HOSTING,
  MAINTENANCE,
  WEB_BUILDS,
  usd,
} from "../data/pricing";
---

<div class="pb" id="package-builder">
  <div class="pb__grid">
    <!-- ─────────── CONTROLS ─────────── -->
    <div class="pb__controls">
      <fieldset class="pb__group">
        <legend class="pb__legend">White-label SEO</legend>
        <div class="pb__options">
          <label class="pb__opt">
            <input type="radio" name="pb-seo" value="none" data-monthly="0" checked />
            <span class="pb__opt-body"><span class="pb__opt-name">No SEO</span><span class="pb__opt-price">$0</span></span>
          </label>
          {SEO_TIERS.map((t) => (
            <label class="pb__opt">
              <input type="radio" name="pb-seo" value={t.id} data-monthly={t.price} />
              <span class="pb__opt-body">
                <span class="pb__opt-name">{t.name}</span>
                <span class="pb__opt-price">{usd(t.price)}/mo</span>
              </span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="pb__group">
        <legend class="pb__legend">{EXTRA_LOCATION.label}s</legend>
        <div class="pb__stepper">
          <button type="button" class="pb__step" data-step="-1" aria-label="Fewer locations">&minus;</button>
          <input
            type="number"
            id="pb-locations"
            class="pb__num"
            min="0"
            max="50"
            value="0"
            data-unit={EXTRA_LOCATION.price}
            aria-label="Extra Maps locations"
          />
          <button type="button" class="pb__step" data-step="1" aria-label="More locations">+</button>
          <span class="pb__stepper-note">{usd(EXTRA_LOCATION.price)}/mo each</span>
        </div>
      </fieldset>

      <fieldset class="pb__group">
        <legend class="pb__legend">Website</legend>
        <div class="pb__options">
          <label class="pb__opt">
            <input type="radio" name="pb-web" value="none" data-onetime="0" checked />
            <span class="pb__opt-body"><span class="pb__opt-name">No website</span><span class="pb__opt-price">$0</span></span>
          </label>
          {WEB_BUILDS.map((b) => (
            <label class="pb__opt">
              <input type="radio" name="pb-web" value={b.id} data-onetime={b.price} />
              <span class="pb__opt-body">
                <span class="pb__opt-name">{b.name}</span>
                <span class="pb__opt-price">{usd(b.price)} once</span>
              </span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="pb__group">
        <legend class="pb__legend">Recurring add-ons</legend>
        <div class="pb__toggles">
          <label class="pb__toggle">
            <input type="checkbox" id="pb-hosting" data-monthly={HOSTING.price} />
            <span class="pb__toggle-name">{HOSTING.label}</span>
            <span class="pb__toggle-price">+{usd(HOSTING.price)}/mo</span>
          </label>
          <label class="pb__toggle">
            <input type="checkbox" id="pb-maint" data-monthly={MAINTENANCE.price} />
            <span class="pb__toggle-name">{MAINTENANCE.label}</span>
            <span class="pb__toggle-price">+{usd(MAINTENANCE.price)}/mo</span>
          </label>
        </div>
      </fieldset>

      <fieldset class="pb__group">
        <legend class="pb__legend">
          Your markup <span class="pb__markup-val" id="pb-markup-val">50%</span>
        </legend>
        <input type="range" id="pb-markup" class="pb__range" min="0" max="200" step="5" value="50" />
        <p class="pb__hint">What you add on top to resell to your client. Slide to model your margin.</p>
      </fieldset>
    </div>

    <!-- ─────────── SUMMARY ─────────── -->
    <aside class="pb__summary" aria-live="polite">
      <h3 class="pb__summary-title">Your white-label cost</h3>
      <div class="pb__line">
        <span>Monthly</span>
        <span class="pb__amt" id="pb-cost-monthly">$0<small>/mo</small></span>
      </div>
      <div class="pb__line">
        <span>One-time</span>
        <span class="pb__amt" id="pb-cost-onetime">$0</span>
      </div>

      <div class="pb__divider"></div>

      <h3 class="pb__summary-title pb__summary-title--resell">Suggested client resale</h3>
      <div class="pb__line">
        <span>Monthly</span>
        <span class="pb__amt pb__amt--resell" id="pb-sell-monthly">$0<small>/mo</small></span>
      </div>
      <div class="pb__line">
        <span>One-time</span>
        <span class="pb__amt pb__amt--resell" id="pb-sell-onetime">$0</span>
      </div>

      <div class="pb__profit" id="pb-profit">
        Your monthly margin: <strong id="pb-margin">$0/mo</strong>
      </div>

      <a href="#discovery-form" class="btn btn-primary pb__cta">Request a quote on this scope</a>
      <p class="pb__disclaimer">Wholesale prices you pay us. Final scope is confirmed on your discovery. Hosting and maintenance start at the rates shown.</p>
    </aside>
  </div>
</div>

<script>
  const root = document.getElementById("package-builder");
  if (root) {
    const $ = (id: string) => document.getElementById(id) as HTMLElement | null;
    const money = (n: number) => "$" + Math.round(n).toLocaleString("en-US");

    const locations = $("pb-locations") as HTMLInputElement | null;
    const markup = $("pb-markup") as HTMLInputElement | null;

    function recalc() {
      let monthly = 0;
      let onetime = 0;

      // Radios + checkboxes that carry data-monthly / data-onetime.
      root!
        .querySelectorAll<HTMLInputElement>("input[data-monthly]")
        .forEach((el) => {
          if ((el.type === "radio" || el.type === "checkbox") && el.checked) {
            monthly += Number(el.dataset.monthly || 0);
          }
        });
      root!
        .querySelectorAll<HTMLInputElement>("input[data-onetime]")
        .forEach((el) => {
          if (el.checked) onetime += Number(el.dataset.onetime || 0);
        });

      // Extra Maps locations: count x unit price.
      if (locations) {
        const n = Math.max(0, Math.min(50, Number(locations.value) || 0));
        const unit = Number(locations.dataset.unit || 0);
        monthly += n * unit;
      }

      const pct = markup ? Number(markup.value) || 0 : 0;
      const factor = 1 + pct / 100;

      const setText = (id: string, html: string) => {
        const el = $(id);
        if (el) el.innerHTML = html;
      };

      setText("pb-cost-monthly", money(monthly) + "<small>/mo</small>");
      setText("pb-cost-onetime", money(onetime));
      setText("pb-sell-monthly", money(monthly * factor) + "<small>/mo</small>");
      setText("pb-sell-onetime", money(onetime * factor));
      setText("pb-markup-val", pct + "%");
      setText("pb-margin", money(monthly * factor - monthly) + "/mo");
    }

    // Stepper buttons.
    root.querySelectorAll<HTMLButtonElement>(".pb__step").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (!locations) return;
        const cur = Number(locations.value) || 0;
        const next = Math.max(0, Math.min(50, cur + Number(btn.dataset.step || 0)));
        locations.value = String(next);
        recalc();
      });
    });

    root.addEventListener("input", recalc);
    root.addEventListener("change", recalc);
    recalc();
  }
</script>

<style>
  .pb {
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .pb__grid {
    display: grid;
    grid-template-columns: 1fr 320px;
  }

  .pb__controls {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .pb__group {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .pb__legend {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 12px;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pb__markup-val {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
    color: var(--teal-dark);
  }

  .pb__options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 10px;
  }
  .pb__opt {
    cursor: pointer;
  }
  .pb__opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .pb__opt-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 12px 14px;
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
    transition: all var(--transition);
  }
  .pb__opt:hover .pb__opt-body {
    border-color: var(--teal-light);
  }
  .pb__opt input:checked + .pb__opt-body {
    border-color: var(--teal);
    background: rgba(40, 165, 177, 0.06);
    box-shadow: 0 0 0 3px rgba(40, 165, 177, 0.12);
  }
  .pb__opt input:focus-visible + .pb__opt-body {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }
  .pb__opt-name {
    font-weight: 600;
    font-size: 14px;
    color: var(--text-primary);
  }
  .pb__opt-price {
    font-size: 13px;
    color: var(--text-muted);
  }

  .pb__stepper {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pb__step {
    width: 38px;
    height: 38px;
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
    background: var(--white);
    font-size: 20px;
    line-height: 1;
    color: var(--text-primary);
    cursor: pointer;
    transition: all var(--transition);
  }
  .pb__step:hover {
    border-color: var(--teal);
    color: var(--teal-dark);
  }
  .pb__num {
    width: 64px;
    height: 38px;
    text-align: center;
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    -moz-appearance: textfield;
  }
  .pb__num::-webkit-outer-spin-button,
  .pb__num::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .pb__stepper-note {
    font-size: 13px;
    color: var(--text-muted);
  }

  .pb__toggles {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .pb__toggle {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--transition);
  }
  .pb__toggle:hover {
    border-color: var(--teal-light);
  }
  .pb__toggle:has(input:checked) {
    border-color: var(--teal);
    background: rgba(40, 165, 177, 0.06);
  }
  .pb__toggle input {
    width: 18px;
    height: 18px;
    accent-color: var(--teal);
    flex-shrink: 0;
  }
  .pb__toggle-name {
    font-weight: 600;
    font-size: 14px;
    color: var(--text-primary);
    flex-grow: 1;
  }
  .pb__toggle-price {
    font-size: 13px;
    color: var(--text-muted);
  }

  .pb__range {
    width: 100%;
    accent-color: var(--teal);
  }
  .pb__hint {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-muted);
    margin-top: 8px;
  }

  /* Summary panel */
  .pb__summary {
    background: var(--dark);
    color: var(--text-on-dark);
    padding: 32px;
    display: flex;
    flex-direction: column;
  }
  .pb__summary-title {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
    margin-bottom: 14px;
  }
  .pb__summary-title--resell {
    color: var(--teal-light);
    margin-top: 4px;
  }
  .pb__line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
    font-size: 14px;
    color: var(--text-on-dark-muted);
  }
  .pb__amt {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    color: var(--text-on-dark);
  }
  .pb__amt small {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-on-dark-muted);
  }
  .pb__amt--resell {
    color: var(--teal-light);
  }
  .pb__divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
    margin: 18px 0;
  }
  .pb__profit {
    margin-top: 18px;
    padding: 12px 14px;
    background: rgba(68, 185, 123, 0.14);
    border-radius: var(--radius-md);
    font-size: 13px;
    color: var(--text-on-dark-muted);
  }
  .pb__profit strong {
    color: var(--green);
    font-size: 15px;
  }
  .pb__cta {
    width: 100%;
    justify-content: center;
    margin-top: 22px;
  }
  .pb__disclaimer {
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--text-on-dark-muted);
    opacity: 0.8;
    margin-top: 14px;
  }

  @media (max-width: 860px) {
    .pb__grid {
      grid-template-columns: 1fr;
    }
    .pb__summary {
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }
  }
</style>
