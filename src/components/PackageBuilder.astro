---
// Build Your Package — à-la-carte white-label cost calculator. No preset tier:
// every line is a variable the agency dials up, down, or to zero. A flat managed
// base (reporting + health score) is always included; strategy is a cadence;
// SEO Time, content, and backlinks are steppers. A markup/resale-multiple slider
// shows wholesale cost vs suggested client resale. All prices come from
// src/data/pricing.ts. Pure vanilla JS: data-base on the root + data-monthly /
// data-monthly-unit / data-onetime on inputs; the script sums them.
import {
  MANAGED_INCLUDED,
  MANAGED_BASE_TOTAL,
  STRATEGY,
  strategyMonthly,
  EXTRA_HOUR,
  EXTRA_BLOG,
  BACKLINK,
  HOSTING,
  MAINTENANCE,
  WEB_BUILDS,
  usd,
} from "../data/pricing";

const lineItems = [
  { id: "pb-hours", label: "SEO Time", unit: EXTRA_HOUR.price, suffix: "per hour", noun: "hours", def: 3, note: "Local business? Budget about 2 hours per location each month so every market gets attention." },
  { id: "pb-content", label: "Content", unit: EXTRA_BLOG.price, suffix: "each", noun: "pieces", def: 1 },
  { id: "pb-links", label: "Backlinks", unit: BACKLINK.price, suffix: "each", noun: "links", def: 2 },
];
---

<div class="pb" id="package-builder" data-base={MANAGED_BASE_TOTAL}>
  <div class="pb__grid">
    <!-- ─────────── CONTROLS ─────────── -->
    <div class="pb__controls">
      <fieldset class="pb__group">
        <legend class="pb__legend">Included with every managed campaign</legend>
        {MANAGED_INCLUDED.map((item) => (
          <div class="pb__base">
            <div>
              <span class="pb__base-name">{item.label}</span>
              <span class="pb__base-note">{item.note}</span>
            </div>
            <span class="pb__base-price">{usd(item.price)}/mo</span>
          </div>
        ))}
      </fieldset>

      <fieldset class="pb__group">
        <legend class="pb__legend">{STRATEGY.label}</legend>
        <div class="pb__options">
          {STRATEGY.cadences.map((c) => (
            <label class="pb__opt">
              <input
                type="radio"
                name="pb-strategy"
                value={c.id}
                data-monthly={strategyMonthly(c.perYear)}
                checked={c.id === "quarterly"}
              />
              <span class="pb__opt-body">
                <span class="pb__opt-name">{c.label}</span>
                <span class="pb__opt-price">{usd(strategyMonthly(c.perYear))}/mo</span>
              </span>
            </label>
          ))}
        </div>
        <p class="pb__hint">{STRATEGY.note} ({usd(STRATEGY.pricePerReview)} per review.)</p>
      </fieldset>

      <fieldset class="pb__group">
        <legend class="pb__legend">Build the work</legend>
        <div class="pb__steppers">
          {lineItems.map((s) => (
            <div class="pb__stepper-wrap">
              <div class="pb__stepper-row">
                <div class="pb__stepper-meta">
                  <span class="pb__stepper-label">{s.label}</span>
                  <span class="pb__stepper-note">{usd(s.unit)}/mo {s.suffix}</span>
                </div>
                <div class="pb__stepper">
                  <button type="button" class="pb__step" data-step="-1" aria-label={`Fewer ${s.noun}`}>&minus;</button>
                  <input
                    type="number"
                    id={s.id}
                    class="pb__num"
                    min="0"
                    max="80"
                    value={s.def}
                    data-monthly-unit={s.unit}
                    aria-label={s.label}
                  />
                  <button type="button" class="pb__step" data-step="1" aria-label={`More ${s.noun}`}>+</button>
                </div>
              </div>
              {s.note && <p class="pb__note">{s.note}</p>}
            </div>
          ))}
        </div>
      </fieldset>

      <fieldset class="pb__group">
        <legend class="pb__legend">Website</legend>
        <div class="pb__options">
          <label class="pb__opt">
            <input type="radio" name="pb-web" value="none" data-onetime="0" checked />
            <span class="pb__opt-body"><span class="pb__opt-name">No website</span><span class="pb__opt-price">$0</span></span>
          </label>
          {WEB_BUILDS.map((b) => (
            <label class="pb__opt">
              <input type="radio" name="pb-web" value={b.id} data-onetime={b.price} />
              <span class="pb__opt-body">
                <span class="pb__opt-name">{b.name}</span>
                <span class="pb__opt-price">{usd(b.price)} once</span>
              </span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="pb__group">
        <legend class="pb__legend">Recurring add-ons</legend>
        <div class="pb__toggles">
          <label class="pb__toggle">
            <input type="checkbox" id="pb-hosting" data-monthly={HOSTING.price} />
            <span class="pb__toggle-name">{HOSTING.label}</span>
            <span class="pb__toggle-price">+{usd(HOSTING.price)}/mo</span>
          </label>
          <label class="pb__toggle">
            <input type="checkbox" id="pb-maint" data-monthly={MAINTENANCE.price} />
            <span class="pb__toggle-name">{MAINTENANCE.label}</span>
            <span class="pb__toggle-price">+{usd(MAINTENANCE.price)}/mo</span>
          </label>
        </div>
      </fieldset>

      <fieldset class="pb__group">
        <legend class="pb__legend">
          Resale multiple <span class="pb__markup-val" id="pb-markup-val">3.0&times;</span>
        </legend>
        <input type="range" id="pb-markup" class="pb__range" min="1.5" max="5" step="0.5" value="3" />
        <p class="pb__hint">White-label SEO typically resells at 2 to 3 times wholesale. Slide to model your margin.</p>
      </fieldset>
    </div>

    <!-- ─────────── SUMMARY ─────────── -->
    <aside class="pb__summary" aria-live="polite">
      <h3 class="pb__summary-title">Your white-label cost</h3>
      <div class="pb__line">
        <span>Monthly</span>
        <span class="pb__amt" id="pb-cost-monthly">$0<small>/mo</small></span>
      </div>
      <div class="pb__line">
        <span>One-time</span>
        <span class="pb__amt" id="pb-cost-onetime">$0</span>
      </div>

      <div class="pb__divider"></div>

      <h3 class="pb__summary-title pb__summary-title--resell">Suggested client resale</h3>
      <div class="pb__line">
        <span>Monthly</span>
        <span class="pb__amt pb__amt--resell" id="pb-sell-monthly">$0<small>/mo</small></span>
      </div>
      <div class="pb__line">
        <span>One-time</span>
        <span class="pb__amt pb__amt--resell" id="pb-sell-onetime">$0</span>
      </div>

      <div class="pb__profit" id="pb-profit">
        Your monthly margin: <strong id="pb-margin">$0/mo</strong>
      </div>

      <a href="#discovery-form" id="pb-quote" class="btn btn-primary pb__cta">Request a quote on this scope</a>
      <p class="pb__disclaimer">Wholesale prices you pay us. Build it your way: every line adjusts, and you can take any to zero. Final scope is confirmed on your discovery.</p>
    </aside>
  </div>
</div>

<script>
  const root = document.getElementById("package-builder");
  if (root) {
    const $ = (id: string) => document.getElementById(id) as HTMLElement | null;
    const money = (n: number) => "$" + Math.round(n).toLocaleString("en-US");
    const markup = $("pb-markup") as HTMLInputElement | null;
    const base = Number(root.dataset.base || 0);

    function recalc() {
      let monthly = base;
      let onetime = 0;

      root!
        .querySelectorAll<HTMLInputElement>("input[data-monthly]")
        .forEach((el) => {
          if ((el.type === "radio" || el.type === "checkbox") && el.checked) {
            monthly += Number(el.dataset.monthly || 0);
          }
        });
      root!
        .querySelectorAll<HTMLInputElement>("input[data-onetime]")
        .forEach((el) => {
          if (el.checked) onetime += Number(el.dataset.onetime || 0);
        });
      root!
        .querySelectorAll<HTMLInputElement>(".pb__num")
        .forEach((el) => {
          const n = Math.max(0, Math.min(80, Number(el.value) || 0));
          monthly += n * Number(el.dataset.monthlyUnit || 0);
        });

      const mult = markup ? Number(markup.value) || 1 : 1;
      const setText = (id: string, html: string) => {
        const el = $(id);
        if (el) el.innerHTML = html;
      };

      setText("pb-cost-monthly", money(monthly) + "<small>/mo</small>");
      setText("pb-cost-onetime", money(onetime));
      setText("pb-sell-monthly", money(monthly * mult) + "<small>/mo</small>");
      setText("pb-sell-onetime", money(onetime * mult));
      setText("pb-markup-val", mult.toFixed(1) + "×");
      setText("pb-margin", money(monthly * mult - monthly) + "/mo");
    }

    root.querySelectorAll<HTMLButtonElement>(".pb__step").forEach((btn) => {
      btn.addEventListener("click", () => {
        const input = btn
          .closest(".pb__stepper")
          ?.querySelector<HTMLInputElement>(".pb__num");
        if (!input) return;
        const cur = Number(input.value) || 0;
        const next = Math.max(0, Math.min(80, cur + Number(btn.dataset.step || 0)));
        input.value = String(next);
        recalc();
      });
    });

    root.addEventListener("input", recalc);
    root.addEventListener("change", recalc);

    // "Request a quote on this scope" → write a readable summary of the build
    // into the discovery form's notes, then the anchor scrolls up to it.
    function buildSummary(): string {
      const lines: string[] = [];
      const strat = root!.querySelector<HTMLInputElement>('input[name="pb-strategy"]:checked');
      if (strat) {
        const label = strat.closest(".pb__opt")?.querySelector(".pb__opt-name")?.textContent?.trim();
        if (label) lines.push(`Strategy reviews: ${label}`);
      }
      const numLabels: Record<string, string> = {
        "pb-hours": "SEO Time (hours/mo)",
        "pb-content": "Content pieces/mo",
        "pb-links": "Backlinks/mo",
      };
      Object.keys(numLabels).forEach((id) => {
        const n = Number(($(id) as HTMLInputElement | null)?.value || 0);
        if (n > 0) lines.push(`${numLabels[id]}: ${n}`);
      });
      const web = root!.querySelector<HTMLInputElement>('input[name="pb-web"]:checked');
      if (web && web.value !== "none") {
        const wl = web.closest(".pb__opt")?.querySelector(".pb__opt-name")?.textContent?.trim();
        if (wl) lines.push(`Website: ${wl}`);
      }
      if (($("pb-hosting") as HTMLInputElement | null)?.checked) lines.push("Managed hosting: yes");
      if (($("pb-maint") as HTMLInputElement | null)?.checked) lines.push("Website maintenance: yes");

      const mult = markup ? Number(markup.value) || 3 : 3;
      const monthly = $("pb-cost-monthly")?.textContent?.trim() || "";
      const onetime = $("pb-cost-onetime")?.textContent?.trim() || "";
      return (
        "Here's the package I built (reporting & health score base included):\n" +
        lines.map((l) => "- " + l).join("\n") +
        `\n- Resale multiple: ${mult.toFixed(1)}x` +
        `\n\nEstimated wholesale: ${monthly}` +
        (onetime && onetime !== "$0" ? ` + ${onetime} one-time` : "") +
        ". Please quote this scope."
      );
    }

    $("pb-quote")?.addEventListener("click", () => {
      const notes = document.getElementById("disco-notes") as HTMLTextAreaElement | null;
      if (notes) {
        notes.value = buildSummary();
        notes.dispatchEvent(new Event("input", { bubbles: true }));
      }
    });

    recalc();
  }
</script>

<style>
  .pb {
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .pb__grid {
    display: grid;
    grid-template-columns: 1fr 320px;
  }

  .pb__controls {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .pb__group {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .pb__legend {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 12px;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pb__markup-val {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
    color: var(--teal-dark);
  }

  /* Always-included base line */
  .pb__base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 18px;
    border: 1.5px dashed var(--border-light);
    border-radius: var(--radius-md);
    background: var(--light);
  }
  .pb__base + .pb__base { margin-top: 10px; }
  .pb__base-name { display: block; font-family: var(--font-display); font-weight: 600; font-size: 15px; color: var(--text-primary); }
  .pb__base-note { display: block; font-size: 13px; line-height: 1.5; color: var(--text-muted); margin-top: 2px; }
  .pb__base-price { flex-shrink: 0; font-family: var(--font-display); font-weight: 700; font-size: 16px; color: var(--text-primary); }

  .pb__options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 10px;
  }
  .pb__opt { cursor: pointer; }
  .pb__opt input { position: absolute; opacity: 0; pointer-events: none; }
  .pb__opt-body {
    display: flex; flex-direction: column; gap: 3px;
    padding: 12px 14px;
    border: 1.5px solid var(--border-light); border-radius: var(--radius-md);
    transition: all var(--transition);
  }
  .pb__opt:hover .pb__opt-body { border-color: var(--teal-light); }
  .pb__opt input:checked + .pb__opt-body {
    border-color: var(--teal); background: rgba(40, 165, 177, 0.06);
    box-shadow: 0 0 0 3px rgba(40, 165, 177, 0.12);
  }
  .pb__opt input:focus-visible + .pb__opt-body { outline: 2px solid var(--teal); outline-offset: 2px; }
  .pb__opt-name { font-weight: 600; font-size: 14px; color: var(--text-primary); }
  .pb__opt-price { font-size: 13px; color: var(--text-muted); }

  .pb__steppers { display: flex; flex-direction: column; gap: 16px; }
  .pb__stepper-wrap { display: flex; flex-direction: column; gap: 6px; }
  .pb__stepper-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .pb__stepper-meta { display: flex; flex-direction: column; gap: 2px; }
  .pb__stepper-label { font-weight: 600; font-size: 14px; color: var(--text-primary); }
  .pb__stepper { display: flex; align-items: center; gap: 10px; }
  .pb__step {
    width: 38px; height: 38px;
    border: 1.5px solid var(--border-light); border-radius: var(--radius-md);
    background: var(--white); font-size: 20px; line-height: 1; color: var(--text-primary);
    cursor: pointer; transition: all var(--transition); flex-shrink: 0;
  }
  .pb__step:hover { border-color: var(--teal); color: var(--teal-dark); }
  .pb__num {
    width: 60px; height: 38px; text-align: center;
    border: 1.5px solid var(--border-light); border-radius: var(--radius-md);
    font-size: 15px; font-weight: 600; color: var(--text-primary); -moz-appearance: textfield;
  }
  .pb__num::-webkit-outer-spin-button, .pb__num::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .pb__stepper-note { font-size: 13px; color: var(--text-muted); }
  .pb__note {
    font-size: 12.5px; line-height: 1.5; color: var(--teal-dark);
    background: rgba(40,165,177,0.07); border-radius: var(--radius-sm);
    padding: 8px 10px; margin: 0;
  }

  .pb__toggles { display: flex; flex-direction: column; gap: 10px; }
  .pb__toggle {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px; border: 1.5px solid var(--border-light); border-radius: var(--radius-md);
    cursor: pointer; transition: all var(--transition);
  }
  .pb__toggle:hover { border-color: var(--teal-light); }
  .pb__toggle:has(input:checked) { border-color: var(--teal); background: rgba(40, 165, 177, 0.06); }
  .pb__toggle input { width: 18px; height: 18px; accent-color: var(--teal); flex-shrink: 0; }
  .pb__toggle-name { font-weight: 600; font-size: 14px; color: var(--text-primary); flex-grow: 1; }
  .pb__toggle-price { font-size: 13px; color: var(--text-muted); }

  .pb__range { width: 100%; accent-color: var(--teal); }
  .pb__hint { font-size: 13px; line-height: 1.5; color: var(--text-muted); margin-top: 8px; }

  /* Summary panel */
  .pb__summary { background: var(--dark); color: var(--text-on-dark); padding: 32px; display: flex; flex-direction: column; }
  .pb__summary-title {
    font-family: var(--font-display); font-size: 13px; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-on-dark-muted); margin-bottom: 14px;
  }
  .pb__summary-title--resell { color: var(--teal-light); margin-top: 4px; }
  .pb__line { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 10px; font-size: 14px; color: var(--text-on-dark-muted); }
  .pb__amt { font-family: var(--font-display); font-size: 24px; font-weight: 700; color: var(--text-on-dark); }
  .pb__amt small { font-size: 13px; font-weight: 500; color: var(--text-on-dark-muted); }
  .pb__amt--resell { color: var(--teal-light); }
  .pb__divider { height: 1px; background: rgba(255, 255, 255, 0.12); margin: 18px 0; }
  .pb__profit { margin-top: 18px; padding: 12px 14px; background: rgba(68, 185, 123, 0.14); border-radius: var(--radius-md); font-size: 13px; color: var(--text-on-dark-muted); }
  .pb__profit strong { color: var(--green); font-size: 15px; }
  .pb__cta { width: 100%; justify-content: center; margin-top: 22px; }
  .pb__disclaimer { font-size: 11.5px; line-height: 1.5; color: var(--text-on-dark-muted); opacity: 0.8; margin-top: 14px; }

  @media (max-width: 860px) {
    .pb__grid { grid-template-columns: 1fr; }
    .pb__summary { border-top: 1px solid rgba(255, 255, 255, 0.1); }
  }
</style>
