---
import { getCollection } from "astro:content";

interface Props {
  category: "seo" | "industry" | "agency" | "cities";
  label: string;
  blurb: string;
  accent: "teal" | "purple" | "green" | "neutral";
}

const { category, label, blurb, accent } = Astro.props;

const guides = (await getCollection("guides"))
  .filter((g) => g.data.category === category)
  .filter((g) => !import.meta.env.PROD || !g.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

function fmtDate(d: Date) {
  return d.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}
---

<section class:list={["gl-hero", `gl-hero--${accent}`]}>
  <div class="gl-hero__bg">
    <div class="gl-hero__orb gl-hero__orb--1"></div>
    <div class="gl-hero__orb gl-hero__orb--2"></div>
    <div class="gl-hero__grid"></div>
  </div>

  <div class="container gl-hero__inner">
    <a href="/guides/" class="gl-hero__back">
      <svg
        width="14"
        height="14"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M13 8H3M7 12L3 8l4-4" />
      </svg>
      All guides
    </a>

    <h1 class="gl-hero__title" data-animate>{label}</h1>
    <p class="gl-hero__subtitle" data-animate>{blurb}</p>
  </div>
</section>

<section class="gl-list-section">
  <div class="container">
    {
      guides.length === 0 ? (
        <p class="gl-empty">More guides coming soon.</p>
      ) : (
        <ul class="gl-list" data-stagger>
          {guides.map((guide) => (
            <li>
              <a href={`/guides/${guide.id}/`} class="gl-card" data-animate>
                <div class="gl-card__main">
                  <h2 class="gl-card__title">{guide.data.title}</h2>
                  <p class="gl-card__summary">{guide.data.summary}</p>
                  <div class="gl-card__meta">
                    <span>{guide.data.author}</span>
                    <span class="gl-card__dot">·</span>
                    <span>{fmtDate(guide.data.publishDate)}</span>
                  </div>
                </div>
                <span class="gl-card__arrow" aria-hidden="true">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M3 8h10M9 4l4 4-4 4" />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .gl-hero {
    position: relative;
    background: var(--dark);
    overflow: hidden;
    padding: 160px 0 80px;
  }

  .gl-hero__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .gl-hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.18;
  }

  .gl-hero__orb--1 {
    width: 460px;
    height: 460px;
    top: -10%;
    right: -5%;
  }

  .gl-hero__orb--2 {
    width: 380px;
    height: 380px;
    bottom: -25%;
    left: -8%;
  }

  .gl-hero--teal .gl-hero__orb--1 {
    background: var(--teal);
  }
  .gl-hero--teal .gl-hero__orb--2 {
    background: var(--purple);
  }

  .gl-hero--purple .gl-hero__orb--1 {
    background: var(--purple);
  }
  .gl-hero--purple .gl-hero__orb--2 {
    background: var(--teal);
  }

  .gl-hero--green .gl-hero__orb--1 {
    background: var(--green);
  }
  .gl-hero--green .gl-hero__orb--2 {
    background: var(--teal);
  }

  .gl-hero--neutral .gl-hero__orb--1 {
    background: var(--teal);
  }
  .gl-hero--neutral .gl-hero__orb--2 {
    background: var(--purple);
  }

  .gl-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at 50% 30%, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(
      ellipse at 50% 30%,
      black 30%,
      transparent 75%
    );
  }

  .gl-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 880px;
  }

  .gl-hero__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-on-dark-muted);
    margin-bottom: 32px;
    transition: color var(--transition);
  }

  .gl-hero__back:hover {
    color: var(--teal-light);
  }

  .gl-hero__title {
    font-family: var(--font-display);
    font-size: clamp(36px, 5.5vw, 56px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-on-dark);
    margin-bottom: 20px;
  }

  .gl-hero__subtitle {
    font-size: clamp(16px, 1.8vw, 19px);
    line-height: 1.7;
    color: var(--text-on-dark-muted);
    max-width: 640px;
  }

  /* List */
  .gl-list-section {
    padding: 80px 0 120px;
    background: var(--white);
  }

  .gl-list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .gl-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 32px;
    border-radius: var(--radius-lg);
    background: var(--light);
    border: 1px solid var(--border-light);
    color: inherit;
    transition: all var(--transition);
  }

  .gl-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: rgba(40, 165, 177, 0.3);
    background: var(--white);
  }

  .gl-card__main {
    flex-grow: 1;
    min-width: 0;
  }

  .gl-card__title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin-bottom: 8px;
    transition: color var(--transition);
  }

  .gl-card:hover .gl-card__title {
    color: var(--teal-dark);
  }

  .gl-card__summary {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .gl-card__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .gl-card__dot {
    opacity: 0.5;
  }

  .gl-card__arrow {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--white);
    border: 1px solid var(--border-light);
    color: var(--text-secondary);
    transition: all var(--transition);
  }

  .gl-card:hover .gl-card__arrow {
    background: var(--teal);
    border-color: var(--teal);
    color: var(--white);
  }

  .gl-empty {
    text-align: center;
    padding: 64px 0;
    color: var(--text-muted);
    font-size: 16px;
    font-style: italic;
  }

  @media (max-width: 768px) {
    .gl-hero {
      padding: 120px 0 64px;
    }

    .gl-list-section {
      padding: 56px 0 80px;
    }

    .gl-card {
      padding: 22px 24px;
    }

    .gl-card__arrow {
      display: none;
    }
  }
</style>
