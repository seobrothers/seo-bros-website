---
// Prominent E-E-A-T author block for guides. Renders headshot, name, title,
// bio, and a link to the author's profile page. Driven by src/data/authors.ts.
// Only renders meaningfully for published authors (the caller checks first).
import type { Author } from "../data/authors";

interface Props {
  author: Author;
  /** "full" for the end-of-article block; "byline" for a compact top credit. */
  variant?: "full" | "byline";
  /** Optional label, e.g. "Written by" or "Reviewed by". */
  label?: string;
}

const { author, variant = "full", label = "Written by" } = Astro.props;
const href = `/authors/${author.slug}/`;
const linkedIn = author.sameAs.find((u) => u.includes("linkedin.com"));
---

{variant === "byline" ? (
  <a class="ac-byline" href={href}>
    <img class="ac-byline__photo" src={author.photo} alt={`${author.name}, ${author.role} at SEO Brothers`} width="40" height="40" loading="lazy" />
    <span class="ac-byline__text">
      <span class="ac-byline__name">{author.name}</span>
      <span class="ac-byline__role">{author.role}</span>
    </span>
  </a>
) : (
  <aside class="ac-card">
    <span class="ac-card__label">{label}</span>
    <div class="ac-card__top">
      <img class="ac-card__photo" src={author.photo} alt={`${author.name}, ${author.role} at SEO Brothers`} width="72" height="72" loading="lazy" />
      <div class="ac-card__id">
        <a class="ac-card__name" href={href}>{author.name}</a>
        <span class="ac-card__role">{author.jobTitle}</span>
      </div>
      {linkedIn && (
        <a class="ac-card__social" href={linkedIn} target="_blank" rel="noopener noreferrer" aria-label={`${author.name} on LinkedIn`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      )}
    </div>
    {author.bio.length > 0 && <p class="ac-card__bio">{author.bio[0]}</p>}
    <a class="ac-card__more" href={href}>More from {author.name.split(" ")[0]}
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
    </a>
  </aside>
)}

<style>
  /* Compact byline (top of article, dark hero) */
  .ac-byline { display: inline-flex; align-items: center; gap: 10px; }
  .ac-byline__photo { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 1px solid rgba(255,255,255,0.15); }
  .ac-byline__text { display: flex; flex-direction: column; line-height: 1.25; }
  .ac-byline__name { font-weight: 600; color: var(--teal-light); font-size: 14px; }
  .ac-byline__role { font-size: 12px; color: var(--text-on-dark-muted); }

  /* Full card (end of article, light body) */
  .ac-card {
    margin-top: 56px;
    padding: 32px;
    border-radius: var(--radius-lg);
    background: var(--light);
    border: 1px solid var(--border-light);
  }
  .ac-card__label {
    display: block;
    font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--text-muted); margin-bottom: 18px;
  }
  .ac-card__top { display: flex; align-items: center; gap: 16px; margin-bottom: 18px; }
  .ac-card__photo { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .ac-card__id { display: flex; flex-direction: column; gap: 3px; flex-grow: 1; }
  .ac-card__name { font-family: var(--font-display); font-size: 19px; font-weight: 700; color: var(--text-primary); letter-spacing: -0.01em; }
  .ac-card__name:hover { color: var(--teal-dark); }
  .ac-card__role { font-size: 14px; color: var(--text-secondary); }
  .ac-card__social {
    flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%;
    background: var(--white); border: 1px solid var(--border-light); color: var(--text-muted);
    display: flex; align-items: center; justify-content: center; transition: all var(--transition);
  }
  .ac-card__social:hover { color: var(--teal); border-color: var(--teal); }
  .ac-card__bio { font-size: 15px; line-height: 1.7; color: var(--text-secondary); margin-bottom: 16px; }
  .ac-card__more {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 14px; font-weight: 600; color: var(--teal); transition: gap var(--transition);
  }
  .ac-card__more:hover { gap: 12px; }
</style>
