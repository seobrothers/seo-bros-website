---
// Closing section that EMBEDS the growth-call calendar inline (book right here,
// no navigation) with a soft secondary path to the free account. Used at
// the bottom of the flagship white-label pages. Lighter pages keep the
// dual-button CtaBanner (which links to /book-a-growth-call/) instead.
// ⚙️ CONFIG — Devon: Mike's growth-call Calendly (see /book-a-growth-call/).
const calendlyUrl = "https://calendly.com/mike-2473/mike-s-good-fit-demo";

interface Props {
  heading?: string;
  sub?: string;
}
const {
  heading = "Let's grow your agency's revenue.",
  sub = "Book a growth call and we'll walk through how we'd deliver under your brand. No slide-deck pitch.",
} = Astro.props as Props;
---

<section class="gce" id="book-a-call">
  <div class="gce__bg">
    <div class="gce__orb gce__orb--1"></div>
    <div class="gce__orb gce__orb--2"></div>
  </div>
  <div class="container gce__inner">
    <div class="gce__head">
      <h2 class="gce__heading">{heading}</h2>
      <p class="gce__sub">{sub}</p>
    </div>
    <div class="gce__card">
      <iframe
        class="gce__calendly"
        src={`${calendlyUrl}?hide_gdpr_banner=1`}
        title="Book a growth call with SEO Brothers"
        loading="lazy"></iframe>
    </div>
    <p class="gce__alt">
      Prefer to explore on your own time?
      <a href="/sign-up/">Start a free account</a> and look around the platform yourself. No card required.
    </p>
  </div>
</section>

<style>
  .gce { position: relative; padding: 110px 0; background: var(--dark); overflow: hidden; }
  .gce__bg { position: absolute; inset: 0; }
  .gce__orb { position: absolute; border-radius: 50%; filter: blur(150px); opacity: 0.2; }
  .gce__orb--1 { width: 500px; height: 500px; background: var(--teal); bottom: -30%; left: -10%; }
  .gce__orb--2 { width: 400px; height: 400px; background: var(--purple); top: -30%; right: -10%; }
  .gce__inner { position: relative; z-index: 1; max-width: 820px; margin: 0 auto; }
  .gce__head { text-align: center; margin-bottom: 32px; }
  .gce__heading {
    font-family: var(--font-display); font-size: clamp(30px, 4.6vw, 44px); font-weight: 700;
    line-height: 1.15; letter-spacing: -0.02em; color: var(--text-on-dark); margin-bottom: 16px; text-wrap: balance;
  }
  .gce__sub { font-size: 18px; line-height: 1.7; color: var(--text-on-dark-muted); max-width: 560px; margin: 0 auto; }
  .gce__card { background: var(--white); border-radius: var(--radius-xl); padding: 12px; box-shadow: var(--shadow-lg); }
  .gce__calendly { width: 100%; min-height: 700px; border: 0; border-radius: var(--radius-md); display: block; }
  .gce__alt { text-align: center; margin-top: 22px; font-size: 14px; line-height: 1.6; color: var(--text-on-dark-muted); }
  .gce__alt a { color: var(--teal-light); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 768px) {
    .gce { padding: 72px 0; }
    .gce__calendly { min-height: 980px; }
  }
</style>
